 5309 28C8              ; ---------------------------------------------------------------------------
 5310 28C8              ; HL = HL % DE, unsigned.
 5311 28C8              ; ---------------------------------------------------------------------------
 5312 28C8              __x80_urem16:
 5313 28C8 CD CE 28         CALL __x80_udiv16
 5314 28CB 62               LD   H,D
 5315 28CC 6B               LD   L,E
 5316 28CD C9               RET
 5317 28CE                  ENDIF
