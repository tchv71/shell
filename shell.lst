 3764 2AFB ~                CALL __x80_q_zero
 3765 2AFB ~                LD   A,64
 3766 2AFB ~                LD   (__x80_qn),A
 3767 2AFB ~            .loop:
 3768 2AFB ~                LD   HL,__x80_qa
 3769 2AFB ~                CALL __x80_q_shl        ; the carry is the bit leaving the dividend
 3770 2AFB ~                LD   HL,__x80_qr
 3771 2AFB ~                CALL __x80_q_rl         ; which arrives at the bottom of the remainder
 3772 2AFB ~                LD   HL,__x80_qr
 3773 2AFB ~                LD   DE,__x80_qb
