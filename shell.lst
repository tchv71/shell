 5287 285A ~
 5288 285A ~            ; ---------------------------------------------------------------------------
 5289 285A ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 285A ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 285A ~            ; the sign put back afterwards.
 5292 285A ~            ; ---------------------------------------------------------------------------
 5293 285A ~            __x80_sdiv16:
 5294 285A ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 285A ~                XOR  D
 5296 285A ~                AND  80H
 5297 285A ~                PUSH AF
 5298 285A ~                CALL __x80_abs_hl
 5299 285A ~                CALL __x80_abs_de
 5300 285A ~                CALL __x80_udiv16
