 5910 2896              ; ---------------------------------------------------------------------------
 5911 2896              ; L = L shifted by E, the three shifts of a byte, for a count the compiler knows
 5912 2896              ; is below eight -- `128 >> (x & 7)` made a byte (ivagor, zx-pk.ru), which was
 5913 2896              ; the word shifted by __x80_ashr16. The byte is in L as the word's low byte was,
 5914 2896              ; so that A stays free around the call; A and E are spent, BC, D and H are not.
 5915 2896              ; A count of zero is tested first, `XOR A / OR E / RET Z`, and the loop's test is
 5916 2896              ; at its end: a byte and 17 T-states less than counting down from one more, and 19
 5917 2896              ; T-states for no shift at all (ivagor, zx-pk.ru).
 5918 2896              ; ---------------------------------------------------------------------------
 5919 2896                  IFUSED __x80_shl8
 5920 2896 ~            __x80_shl8:
 5921 2896 ~                XOR  A
 5922 2896 ~                OR   E
 5923 2896 ~                RET  Z
 5924 2896 ~                LD   A,L
 5925 2896 ~            .loop:
 5926 2896 ~                ADD  A,A
 5927 2896 ~                DEC  E
 5928 2896 ~                JP   NZ,.loop
 5929 2896 ~                LD   L,A
 5930 2896 ~                RET
 5931 2896                  ENDIF
 5932 2896
 5933 2896                  IFUSED __x80_lshr8
