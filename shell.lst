 8519 292C                  IFUSED __x80_printf_float
 8520 292C ~            __x80_printf_float:
 8521 292C ~                IFUSED __x80_float_varargs
 8522 292C ~                DEFW __x80_format_double
 8523 292C ~                ELSE
 8524 292C ~                DEFW 0
 8525 292C ~                ENDIF
 8526 292C                  ENDIF
