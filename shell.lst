 4360 282F 22 36 29         LD   (__x80_rt_a+2),HL
 4361 2832 3A 34 29         LD   A,(__x80_rt_a)
 4362 2835 32 35 29         LD   (__x80_rt_a+1),A
 4363 2838 AF               XOR  A
 4364 2839 32 34 29         LD   (__x80_rt_a),A
 4365 283C 78               LD   A,B
 4366 283D D6 08            SUB  8
 4367 283F 47               LD   B,A
 4368 2840 C2 25 28         JP   NZ,.s_skip
 4369 2843              .s_go:
 4370 2843 21 00 00         LD   HL,0
 4371 2846 54               LD   D,H
 4372 2847 5D               LD   E,L
 4373 2848 78               LD   A,B
 4374 2849 B7               OR   A
