 5639 2C2B ~                ADC  A,A
 5640 2C2B ~                ADD  HL,HL
 5641 2C2B ~                ADD  HL,BC
 5642 2C2B ~                JP   C,.s5
 5643 2C2B ~            .a5:
 5644 2C2B ~                ADC  A,A
 5645 2C2B ~                ADD  HL,HL
 5646 2C2B ~                ADD  HL,BC
 5647 2C2B ~                JP   C,.s4
