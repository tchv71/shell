 6389 2896 ~                JP   NZ,.up
 6390 2896 ~                DEC  B
 6391 2896 ~                JP   NZ,.up
 6392 2896 ~                EX   DE,HL              ; DE the destination, at d + n - g
 6393 2896 ~                LD   HL,(__x80_sp_save)
