 4267 2B04              ; rt_a = DE:HL, rt_b = [SP+4]:BC -- the stack argument is two return addresses up.
 4268 2B04              __x80_div_args:
 4269 2B04 22 8D 2C         LD   (__x80_rt_a),HL
 4270 2B07 EB               EX   DE,HL
 4271 2B08 22 8F 2C         LD   (__x80_rt_a+2),HL
 4272 2B0B 60               LD   H,B
 4273 2B0C 69               LD   L,C
 4274 2B0D 22 89 2C         LD   (__x80_rt_b),HL
 4275 2B10 21 04 00         LD   HL,4
 4276 2B13 39               ADD  HL,SP
 4277 2B14 7E               LD   A,(HL)
 4278 2B15 23               INC  HL
 4279 2B16 66               LD   H,(HL)
 4280 2B17 6F               LD   L,A
 4281 2B18 22 8B 2C         LD   (__x80_rt_b+2),HL
 4282 2B1B C9               RET
 4283 2B1C                  ENDIF
