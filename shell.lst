 8510 292C              ; printf's floating-point conversions (lib/libc/stdio.c) are reached through this
 8511 292C              ; word: the address of __x80_format_double when the program passes a floating
 8512 292C              ; value to a function with `...` -- the compiler then names __x80_float_varargs
 8513 292C              ; in an EQU, which is what IFUSED counts -- and zero otherwise, so that a program
 8514 292C              ; printing only integers does not carry them.
 8515 292C              ;@shared
 8516 292C              __x80_float_varargs EQU 0
 8517 292C              ;@end
