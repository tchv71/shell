 3972 2AFB                  IFUSED __x80_lmul
 3973 2AFB ~
 3974 2AFB ~            ; ---------------------------------------------------------------------------
 3975 2AFB ~            ; DE:HL = DE:HL * [SP+2]:BC, the low thirty-two bits.
 3976 2AFB ~            ;
 3977 2AFB ~            ; By halves, since only the low thirty-two bits of the product are wanted:
 3978 2AFB ~            ;
 3979 2AFB ~            ;     a * b = aL*bL + ((aH*bL + aL*bH) << 16)      modulo 2^32
 3980 2AFB ~            ;
 3981 2AFB ~            ; which is one sixteen-by-sixteen multiplication with a thirty-two-bit result, the smaller low
 3982 2AFB ~            ; half the multiplier, and two with a sixteen-bit one -- a high half that is zero, as it is
 3983 2AFB ~            ; whenever a `long` holds an unsigned int's worth, dropping its term altogether, and one that is
 3984 2AFB ~            ; FFFFh, a negative int's, making it a subtraction. z88dk's runtime does the same (l_long_mult).
 3985 2AFB ~            ; The halves wait in rt_a and rt_b, as division's do.
 3986 2AFB ~            ; ---------------------------------------------------------------------------
 3987 2AFB ~            __x80_lmul:
 3988 2AFB ~                LD   (__x80_rt_a),HL    ; aL
 3989 2AFB ~                EX   DE,HL
 3990 2AFB ~                LD   (__x80_rt_a+2),HL  ; aH
 3991 2AFB ~                LD   H,B
 3992 2AFB ~                LD   L,C
 3993 2AFB ~                LD   (__x80_rt_b),HL    ; bL
 3994 2AFB ~                LD   HL,2
 3995 2AFB ~                ADD  HL,SP
 3996 2AFB ~                LD   A,(HL)
 3997 2AFB ~                INC  HL
 3998 2AFB ~                LD   H,(HL)
 3999 2AFB ~                LD   L,A
 4000 2AFB ~                LD   (__x80_rt_b+2),HL  ; bH
 4001 2AFB ~                LD   HL,(__x80_rt_a)
 4002 2AFB ~                EX   DE,HL              ; DE = aL, BC = bL
 4003 2AFB ~                LD   A,E                ; the smaller the multiplier: its leading zeros are the cheap steps
 4004 2AFB ~                SUB  C
 4005 2AFB ~                LD   A,D
 4006 2AFB ~                SBC  A,B
 4007 2AFB ~                JP   C,.low
 4008 2AFB ~                LD   H,B
 4009 2AFB ~                LD   L,C
 4010 2AFB ~                LD   B,D
 4011 2AFB ~                LD   C,E
 4012 2AFB ~                EX   DE,HL
 4013 2AFB ~            .low:
 4014 2AFB ~                CALL __x80_mulw         ; DE:HL = aL * bL
 4015 2AFB ~                LD   (__x80_rt_lo),HL
 4016 2AFB ~                LD   HL,(__x80_rt_b)
 4017 2AFB ~                LD   B,H
 4018 2AFB ~                LD   C,L
 4019 2AFB ~                LD   HL,(__x80_rt_a+2)
 4020 2AFB ~                CALL .cross             ; + aH * bL
 4021 2AFB ~                LD   HL,(__x80_rt_a)
 4022 2AFB ~                LD   B,H
 4023 2AFB ~                LD   C,L
 4024 2AFB ~                LD   HL,(__x80_rt_b+2)
 4025 2AFB ~                CALL .cross             ; + aL * bH
 4026 2AFB ~                LD   HL,(__x80_rt_lo)
 4027 2AFB ~                RET
 4028 2AFB ~            ; DE += HL * BC, the low sixteen bits: nothing for a zero HL, the high half of a long that holds
 4029 2AFB ~            ; an unsigned int's worth; a subtraction for FFFFh, one that holds a negative int's.
 4030 2AFB ~            .cross:
 4031 2AFB ~                LD   A,H
 4032 2AFB ~                OR   L
 4033 2AFB ~                RET  Z
 4034 2AFB ~                LD   A,H
 4035 2AFB ~                AND  L
 4036 2AFB ~                INC  A
 4037 2AFB ~                JP   Z,.minus
 4038 2AFB ~                PUSH DE
 4039 2AFB ~                LD   D,B
 4040 2AFB ~                LD   E,C
 4041 2AFB ~                CALL __x80_mul16
 4042 2AFB ~                POP  DE
 4043 2AFB ~                ADD  HL,DE
 4044 2AFB ~                EX   DE,HL
 4045 2AFB ~                RET
 4046 2AFB ~            .minus:
 4047 2AFB ~                LD   A,E
 4048 2AFB ~                SUB  C
 4049 2AFB ~                LD   E,A
 4050 2AFB ~                LD   A,D
 4051 2AFB ~                SBC  A,B
 4052 2AFB ~                LD   D,A
 4053 2AFB ~                RET
