 8239 28BE
 8240 28BE                  IFUSED __x80_call_hl
 8241 28BE ~            ; ---------------------------------------------------------------------------
 8242 28BE ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 28BE ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 28BE ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 28BE ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 28BE ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 28BE ~            ; whose copy of this turns the address into the function's copy first
 8248 28BE ~            ; (marinovsoft, zx-pk.ru).
 8249 28BE ~            ; ---------------------------------------------------------------------------
 8250 28BE ~            __x80_call_hl:
 8251 28BE ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 28BE ~                JP   (HL)
 8253 28BE                  ENDIF
 8254 28BE
 8255 28BE                  IFUSED __x80_call_bc
 8256 28BE ~
 8257 28BE ~            ; ---------------------------------------------------------------------------
 8258 28BE ~            ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 28BE ~            ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 28BE ~            ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 28BE ~            ; callee's own RET then finds the caller's address underneath and comes back.
 8262 28BE ~            ;
 8263 28BE ~            ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 28BE ~            ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 28BE ~            ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 28BE ~            ; argument gets.
 8267 28BE ~            ; ---------------------------------------------------------------------------
 8268 28BE ~            __x80_call_bc:
 8269 28BE ~            ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 28BE ~            ;@irq    LD   H,B
 8271 28BE ~            ;@irq    LD   L,C
 8272 28BE ~            ;@irq    CALL __x80_xlat
 8273 28BE ~            ;@irq    LD   B,H
 8274 28BE ~            ;@irq    LD   C,L
 8275 28BE ~            ;@irq    POP  HL
 8276 28BE ~                PUSH BC
 8277 28BE ~                RET
 8278 28BE                  ENDIF
 8279 28BE
 8280 28BE                  IFUSED __x80_call_mem
 8281 28BE ~            ; ---------------------------------------------------------------------------
 8282 28BE ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 28BE ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 28BE ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 28BE ~            ; return address underneath. Forty-three T-states.
 8286 28BE ~            ; ---------------------------------------------------------------------------
 8287 28BE ~            __x80_call_mem:
 8288 28BE ~                PUSH HL
 8289 28BE ~                LD   HL,(__x80_call_target)
 8290 28BE ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 28BE ~                EX   (SP),HL
 8292 28BE ~                RET
 8293 28BE                  ENDIF
 8294 28BE
 8295 28BE                  IFUSED _setjmp
 8296 28BE ~            ; ---------------------------------------------------------------------------
 8297 28BE ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 28BE ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 28BE ~            ; to save, so those two words are all there is.
 8300 28BE ~            ; ---------------------------------------------------------------------------
 8301 28BE ~            _setjmp:
 8302 28BE ~                POP  DE             ; the return address
 8303 28BE ~                PUSH DE
 8304 28BE ~                LD   (HL),E
 8305 28BE ~                INC  HL
 8306 28BE ~                LD   (HL),D
 8307 28BE ~                INC  HL
 8308 28BE ~                EX   DE,HL          ; DE -> the second word
 8309 28BE ~                LD   HL,2
 8310 28BE ~                ADD  HL,SP          ; the caller's SP after the return
 8311 28BE ~                EX   DE,HL
 8312 28BE ~                LD   (HL),E
 8313 28BE ~                INC  HL
 8314 28BE ~                LD   (HL),D
 8315 28BE ~                LD   HL,0
 8316 28BE ~                RET
 8317 28BE                  ENDIF
 8318 28BE
 8319 28BE                  IFUSED _longjmp
 8320 28BE ~            ; ---------------------------------------------------------------------------
 8321 28BE ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 28BE ~            ; returning val there -- or 1, if val is 0.
 8323 28BE ~            ; ---------------------------------------------------------------------------
 8324 28BE ~            _longjmp:
 8325 28BE ~                LD   A,D
 8326 28BE ~                OR   E
 8327 28BE ~                JP   NZ,.value
 8328 28BE ~                INC  DE
 8329 28BE ~            .value:
 8330 28BE ~                LD   C,(HL)
 8331 28BE ~                INC  HL
 8332 28BE ~                LD   B,(HL)         ; BC = where to go
 8333 28BE ~                INC  HL
 8334 28BE ~                LD   A,(HL)
 8335 28BE ~                INC  HL
 8336 28BE ~                LD   H,(HL)
 8337 28BE ~                LD   L,A
 8338 28BE ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 28BE ~                EX   DE,HL          ; the value, in HL
 8340 28BE ~                PUSH BC
 8341 28BE ~                RET
 8342 28BE                  ENDIF
 8343 28BE
 8344 28BE                  IFUSED __x80_sp
 8345 28BE ~            ; ---------------------------------------------------------------------------
 8346 28BE ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 28BE ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 28BE ~            ; ---------------------------------------------------------------------------
 8349 28BE ~            __x80_sp:
 8350 28BE ~                LD   HL,0
 8351 28BE ~                ADD  HL,SP
 8352 28BE ~                RET
 8353 28BE                  ENDIF
 8354 28BE
 8355 28BE              ;@shared
 8356 28BE                  IFNDEF X80_EXIT_DEFINED
 8357 28BE                  IFUSED __x80_exit
 8358 28BE ~            ; ---------------------------------------------------------------------------
 8359 28BE ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 28BE ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 28BE ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 28BE ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 28BE ~            ; (lib/crt/test_start.asm).
 8364 28BE ~            ; ---------------------------------------------------------------------------
 8365 28BE ~            __x80_exit:
 8366 28BE ~                JP   __x80_halt
 8367 28BE                  ENDIF
 8368 28BE                  ENDIF
 8369 28BE
 8370 28BE                  IFUSED __x80_halt
 8371 28BE ~            ; ---------------------------------------------------------------------------
 8372 28BE ~            ; The end of a program that stops itself: exit, abort. HALT, and HALT again if
 8373 28BE ~            ; an interrupt wakes it -- there is nothing to return to.
 8374 28BE ~            ; ---------------------------------------------------------------------------
 8375 28BE ~            __x80_halt:
 8376 28BE ~                HALT
 8377 28BE ~                JP   __x80_halt
 8378 28BE                  ENDIF
 8379 28BE              ;@end
 8380 28BE
 8381 28BE                  IFUSED __x80_rt_a
 8382 28BE              ; ---------------------------------------------------------------------------
 8383 28BE              ; Working space, for division. Like every object that starts as zeros, not in the image: an
 8384 28BE              ; address below __x80_bss_top that the startup code clears.
 8385 28BE              ; ---------------------------------------------------------------------------
 8386 28BE              __x80_bss_off = __x80_bss_off + 4
 8387 28BE              __x80_rt_a EQU __x80_bss_top - __x80_bss_off      ; the dividend, then the quotient
 8388 28BE                  ENDIF
 8389 28BE
 8390 28BE                  IFUSED __x80_rt_b
 8391 28BE              __x80_bss_off = __x80_bss_off + 4
 8392 28BE              __x80_rt_b EQU __x80_bss_top - __x80_bss_off      ; the divisor
 8393 28BE                  ENDIF
 8394 28BE
 8395 28BE                  IFUSED __x80_rt_r
 8396 28BE              __x80_bss_off = __x80_bss_off + 4
 8397 28BE              __x80_rt_r EQU __x80_bss_top - __x80_bss_off      ; the remainder
 8398 28BE                  ENDIF
 8399 28BE
 8400 28BE                  IFUSED __x80_rt_sign
 8401 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8402 28BE ~            __x80_rt_sign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
 8403 28BE                  ENDIF
 8404 28BE
 8405 28BE                  IFUSED __x80_rt_lo
 8406 28BE ~            __x80_bss_off = __x80_bss_off + 2
 8407 28BE ~            __x80_rt_lo EQU __x80_bss_top - __x80_bss_off      ; the low word of a product, while the high one is summed
 8408 28BE                  ENDIF
 8409 28BE
 8410 28BE                  IFUSED __x80_call_target
 8411 28BE ~            __x80_bss_off = __x80_bss_off + 2
 8412 28BE ~            __x80_call_target EQU __x80_bss_top - __x80_bss_off  ; the address __x80_call_mem calls
 8413 28BE                  ENDIF
 8414 28BE
 8415 28BE                  IFUSED __x80_sp_save
 8416 28BE ~            __x80_bss_off = __x80_bss_off + 2
 8417 28BE ~            __x80_sp_save EQU __x80_bss_top - __x80_bss_off  ; -mstack-copy: SP, while it is the pointer
 8418 28BE                  ENDIF
 8419 28BE
 8420 28BE              ; Working space, for double.
 8421 28BE                  IFUSED __x80_dsg
 8422 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8423 28BE ~            __x80_dsg EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8424 28BE                  ENDIF
 8425 28BE
 8426 28BE                  IFUSED __x80_dx
 8427 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8428 28BE ~            __x80_dx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, then a subtraction
 8429 28BE                  ENDIF
 8430 28BE
 8431 28BE                  IFUSED __x80_dexp
 8432 28BE ~            __x80_bss_off = __x80_bss_off + 2
 8433 28BE ~            __x80_dexp EQU __x80_bss_top - __x80_bss_off      ; an exponent
 8434 28BE                  ENDIF
 8435 28BE
 8436 28BE              ; Working space, for float.
 8437 28BE                  IFUSED __x80_fpa
 8438 28BE ~            __x80_bss_off = __x80_bss_off + 4
 8439 28BE ~            __x80_fpa EQU __x80_bss_top - __x80_bss_off      ; the first operand, then its significand
 8440 28BE                  ENDIF
 8441 28BE
 8442 28BE                  IFUSED __x80_fpb
 8443 28BE ~            __x80_bss_off = __x80_bss_off + 4
 8444 28BE ~            __x80_fpb EQU __x80_bss_top - __x80_bss_off      ; the second operand, then its significand
 8445 28BE                  ENDIF
 8446 28BE
 8447 28BE                  IFUSED __x80_fpp
 8448 28BE ~            __x80_bss_off = __x80_bss_off + 6
 8449 28BE ~            __x80_fpp EQU __x80_bss_top - __x80_bss_off      ; a product of significands, forty-eight bits
 8450 28BE                  ENDIF
 8451 28BE
 8452 28BE                  IFUSED __x80_fps
 8453 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8454 28BE ~            __x80_fps EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8455 28BE                  ENDIF
 8456 28BE
 8457 28BE                  IFUSED __x80_fpx
 8458 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8459 28BE ~            __x80_fpx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, a subtraction, a quotient byte
 8460 28BE                  ENDIF
 8461 28BE
 8462 28BE                  IFUSED __x80_fpe
 8463 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8464 28BE ~            __x80_fpe EQU __x80_bss_top - __x80_bss_off      ; an exponent, a count
 8465 28BE                  ENDIF
 8466 28BE
 8467 28BE              ; Working space, for sixty-four bits.
 8468 28BE                  IFUSED __x80_qa
 8469 28BE ~            __x80_bss_off = __x80_bss_off + 8
 8470 28BE ~            __x80_qa EQU __x80_bss_top - __x80_bss_off      ; the first operand, the product's multiplicand, the quotient
 8471 28BE                  ENDIF
 8472 28BE
 8473 28BE                  IFUSED __x80_qb
 8474 28BE ~            __x80_bss_off = __x80_bss_off + 8
 8475 28BE ~            __x80_qb EQU __x80_bss_top - __x80_bss_off      ; the second operand
 8476 28BE                  ENDIF
 8477 28BE
 8478 28BE                  IFUSED __x80_qr
 8479 28BE ~            __x80_bss_off = __x80_bss_off + 8
 8480 28BE ~            __x80_qr EQU __x80_bss_top - __x80_bss_off      ; the product, the remainder
 8481 28BE                  ENDIF
 8482 28BE
 8483 28BE                  IFUSED __x80_qn
 8484 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8485 28BE ~            __x80_qn EQU __x80_bss_top - __x80_bss_off      ; the loop counter
 8486 28BE                  ENDIF
 8487 28BE
 8488 28BE                  IFUSED __x80_qst
 8489 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8490 28BE ~            __x80_qst EQU __x80_bss_top - __x80_bss_off      ; a product's sticky bit
 8491 28BE                  ENDIF
 8492 28BE
 8493 28BE                  IFUSED __x80_qsign
 8494 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8495 28BE ~            __x80_qsign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
 8496 28BE                  ENDIF
