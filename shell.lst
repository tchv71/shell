 4162 2AFB ~                LD   A,E
 4163 2AFB ~                RLA
 4164 2AFB ~                LD   E,A
 4165 2AFB ~                LD   A,D
 4166 2AFB ~                RLA
 4167 2AFB ~                LD   D,A
 4168 2AFB ~                LD   A,B
 4169 2AFB ~                RLA
 4170 2AFB ~                LD   B,A
 4171 2AFB ~                DEC  C
 4172 2AFB ~                JP   NZ,.left_loop
 4173 2AFB ~                JP   .move              ; Z: the bytes down by one, and back
