 4246 276F ~                LD   C,A
 4247 276F ~                LD   A,(__x80_rt_b+3)
 4248 276F ~                XOR  C
 4249 276F ~                CALL __x80_signed_divide
 4250 276F ~                CALL Z,__x80_negate_a
 4251 276F ~                JP   __x80_quotient
 4252 276F                  ENDIF
