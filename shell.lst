 5622 2C2B ~                ADD  HL,DE
 5623 2C2B ~                JP   NC,.a1
 5624 2C2B ~            .s1:
 5625 2C2B ~                ADC  A,A
 5626 2C2B ~                ADD  HL,HL
 5627 2C2B ~                ADD  HL,DE
 5628 2C2B ~                JP   NC,.a0
 5629 2C2B ~            .s0:
 5630 2C2B ~                ADC  A,A
