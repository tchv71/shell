 4351 281E 13               INC  DE
 4352 281F 05               DEC  B
 4353 2820 C2 1A 28         JP   NZ,.s_not
 4354 2823 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2825              .s_skip:                    ; remainder zero still and the quotient's bits 0
