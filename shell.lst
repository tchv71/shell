 6078 2C5B                  IFUSED __x80_ashr16
 6079 2C5B ~
 6080 2C5B ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2C5B ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2C5B ~            __x80_ashr16:
 6083 2C5B ~                XOR  A
 6084 2C5B ~                OR   E
 6085 2C5B ~                RET  Z
 6086 2C5B ~                LD   B,A
 6087 2C5B ~                CP   8
 6088 2C5B ~                JP   NC,.bytes
 6089 2C5B ~                CP   4
 6090 2C5B ~                JP   NC,.left
 6091 2C5B ~            .loop:
 6092 2C5B ~                LD   A,H
 6093 2C5B ~                RLCA                    ; the sign into the carry
 6094 2C5B ~                RRCA                    ; H as it was, a T-state less than LD A,H again
 6095 2C5B ~                RRA                     ; and the sign back into the top bit, so it replaces itself
 6096 2C5B ~                LD   H,A
 6097 2C5B ~                LD   A,L
 6098 2C5B ~                RRA
 6099 2C5B ~                LD   L,A
 6100 2C5B ~                DEC  B
 6101 2C5B ~                JP   NZ,.loop
 6102 2C5B ~                RET
 6103 2C5B ~            .left:
 6104 2C5B ~                LD   A,8
 6105 2C5B ~                SUB  B
 6106 2C5B ~                LD   B,A
 6107 2C5B ~                LD   A,H
 6108 2C5B ~                RLA
 6109 2C5B ~                SBC  A,A                ; the sign's byte, 00h or FFh
 6110 2C5B ~            .left_loop:
 6111 2C5B ~                ADD  HL,HL
 6112 2C5B ~                RLA
 6113 2C5B ~                DEC  B
 6114 2C5B ~                JP   NZ,.left_loop
 6115 2C5B ~                LD   L,H
 6116 2C5B ~                LD   H,A
 6117 2C5B ~                RET
 6118 2C5B ~            .bytes:
 6119 2C5B ~                LD   L,H
 6120 2C5B ~                LD   A,H
 6121 2C5B ~                RLA
 6122 2C5B ~                SBC  A,A
 6123 2C5B ~                LD   H,A                ; the sign's byte above
 6124 2C5B ~                LD   A,B
 6125 2C5B ~                SUB  8
 6126 2C5B ~                RET  Z
 6127 2C5B ~                CP   8
 6128 2C5B ~                JP   NC,.all
 6129 2C5B ~                LD   B,A
 6130 2C5B ~                LD   A,L
 6131 2C5B ~            .byte:
 6132 2C5B ~                RLCA                    ; the byte's sign into the carry,
 6133 2C5B ~                RRCA                    ; the byte as it was,
 6134 2C5B ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2C5B ~                DEC  B
 6136 2C5B ~                JP   NZ,.byte
 6137 2C5B ~                LD   L,A
 6138 2C5B ~                RET
 6139 2C5B ~            .all:
 6140 2C5B ~                LD   L,H
 6141 2C5B ~                RET
 6142 2C5B                  ENDIF
