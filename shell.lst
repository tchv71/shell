 5319 28CE                  IFUSED __x80_udiv16
 5320 28CE
 5321 28CE              ; ---------------------------------------------------------------------------
 5322 28CE              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 28CE              ;
 5324 28CE              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 28CE              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 28CE              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 28CE              ; one of 32768 or more, a quotient of 0 or 1.
 5328 28CE              ;
 5329 28CE              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 28CE              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 28CE              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 28CE              ; ---------------------------------------------------------------------------
 5333 28CE              __x80_udiv16:
 5334 28CE                  IFDEF X80_OPT_SIZE
 5335 28CE                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 28CE                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 28CE                  ; bits go in, the divisor in BC, the count on the stack.
 5338 28CE 7A               LD   A,D
 5339 28CF B3               OR   E
 5340 28D0 CA FD 28         JP   Z,.s_zero
 5341 28D3 42               LD   B,D
 5342 28D4 4B               LD   C,E
 5343 28D5 EB               EX   DE,HL
 5344 28D6 21 00 00         LD   HL,0
 5345 28D9 3E 10            LD   A,16
 5346 28DB              .s_loop:
 5347 28DB F5               PUSH AF
 5348 28DC EB               EX   DE,HL
 5349 28DD 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 28DE EB               EX   DE,HL
 5351 28DF 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 28E0 17               RLA
 5353 28E1 6F               LD   L,A
 5354 28E2 7C               LD   A,H
 5355 28E3 17               RLA
 5356 28E4 67               LD   H,A
 5357 28E5 DA EF 28         JP   C,.s_take
 5358 28E8 7D               LD   A,L
 5359 28E9 91               SUB  C
 5360 28EA 7C               LD   A,H
 5361 28EB 98               SBC  A,B
 5362 28EC DA F6 28         JP   C,.s_next          ; below the divisor: a 0
 5363 28EF              .s_take:
 5364 28EF 7D               LD   A,L
 5365 28F0 91               SUB  C
 5366 28F1 6F               LD   L,A
 5367 28F2 7C               LD   A,H
 5368 28F3 98               SBC  A,B
 5369 28F4 67               LD   H,A
 5370 28F5 1C               INC  E
 5371 28F6              .s_next:
 5372 28F6 F1               POP  AF
 5373 28F7 3D               DEC  A
 5374 28F8 C2 DB 28         JP   NZ,.s_loop
 5375 28FB EB               EX   DE,HL
 5376 28FC C9               RET
 5377 28FD              .s_zero:
 5378 28FD 21 FF FF         LD   HL,0FFFFH
 5379 2900 11 00 00         LD   DE,0
 5380 2903 C9               RET
 5381 2904                  ELSE
 5382 2904 ~                LD   A,D
 5383 2904 ~                OR   A
 5384 2904 ~                JP   NZ,.wide
 5385 2904 ~                OR   E
 5386 2904 ~                JP   Z,.by_zero
 5387 2904 ~                LD   A,H
 5388 2904 ~                CP   E
 5389 2904 ~                JP   NC,.two
 5390 2904 ~                OR   A
 5391 2904 ~                JP   NZ,.one
 5392 2904 ~                LD   A,L            ; below the divisor: the dividend is the remainder
 5393 2904 ~                CP   E
 5394 2904 ~                JP   C,.below
 5395 2904 ~            .one:
 5396 2904 ~                CALL __x80_dsetup8  ; the high byte below the divisor: one pass
 5397 2904 ~                CALL __x80_dpass8
 5398 2904 ~                LD   E,H            ; the remainder
 5399 2904 ~                LD   D,0
 5400 2904 ~                LD   L,A
 5401 2904 ~                LD   H,D
 5402 2904 ~                RET
 5403 2904 ~            .two:
 5404 2904 ~                PUSH HL             ; the low byte, for the second pass
 5405 2904 ~                CALL __x80_dsetup8
 5406 2904 ~                LD   L,H            ; the high byte alone first
 5407 2904 ~                LD   H,0
 5408 2904 ~                CALL __x80_dpass8   ; its quotient in A, the remainder in H
 5409 2904 ~                LD   L,A
 5410 2904 ~                EX   (SP),HL        ; that kept; the dividend back
 5411 2904 ~                LD   A,L
 5412 2904 ~                POP  HL
 5413 2904 ~                PUSH HL
 5414 2904 ~                LD   L,A            ; the remainder and the low byte
 5415 2904 ~                CALL __x80_dpass8
 5416 2904 ~                LD   E,H
 5417 2904 ~                LD   D,0
 5418 2904 ~                POP  HL
 5419 2904 ~                LD   H,L            ; the high byte of the quotient
 5420 2904 ~                LD   L,A
 5421 2904 ~                RET
 5422 2904 ~            .below:
 5423 2904 ~                LD   E,L
 5424 2904 ~                LD   HL,0
 5425 2904 ~                RET
 5426 2904 ~            .wide:
 5427 2904 ~                JP   M,.big
 5428 2904 ~                LD   B,D            ; 256..32767: a quotient below 256
 5429 2904 ~                LD   C,E
 5430 2904 ~                XOR  A
 5431 2904 ~                SUB  E
 5432 2904 ~                LD   E,A
 5433 2904 ~                LD   A,0
 5434 2904 ~                SBC  A,D
 5435 2904 ~                LD   D,A
 5436 2904 ~                PUSH HL             ; the low byte, for after the pass
 5437 2904 ~                LD   L,H            ; the high byte, below the divisor
 5438 2904 ~                LD   H,0
 5439 2904 ~                ADD  HL,DE          ; as __x80_dpass16 takes a remainder
 5440 2904 ~                CALL __x80_dpass16
 5441 2904 ~                POP  DE
 5442 2904 ~                LD   D,A            ; the quotient
 5443 2904 ~                LD   A,E            ; the low byte added to the remainder
 5444 2904 ~                ADD  A,L
 5445 2904 ~                LD   L,A
 5446 2904 ~                LD   A,H
 5447 2904 ~                ADC  A,0
