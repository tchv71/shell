 4449 28B5 22 2C 29         LD   (__x80_rt_r),HL
 4450 28B8 2A 36 29         LD   HL,(__x80_rt_a+2)
 4451 28BB 22 2E 29         LD   (__x80_rt_r+2),HL
 4452 28BE 21 FF FF         LD   HL,0FFFFH
 4453 28C1 22 34 29         LD   (__x80_rt_a),HL
 4454 28C4 22 36 29         LD   (__x80_rt_a+2),HL
 4455 28C7 C9               RET
