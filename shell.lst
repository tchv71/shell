 3972 2766                  IFUSED __x80_lmul
 3973 2766 ~
 3974 2766 ~            ; ---------------------------------------------------------------------------
 3975 2766 ~            ; DE:HL = DE:HL * [SP+2]:BC, the low thirty-two bits.
 3976 2766 ~            ;
 3977 2766 ~            ; By halves, since only the low thirty-two bits of the product are wanted:
 3978 2766 ~            ;
 3979 2766 ~            ;     a * b = aL*bL + ((aH*bL + aL*bH) << 16)      modulo 2^32
 3980 2766 ~            ;
 3981 2766 ~            ; which is one sixteen-by-sixteen multiplication with a thirty-two-bit result, the smaller low
 3982 2766 ~            ; half the multiplier, and two with a sixteen-bit one -- a high half that is zero, as it is
 3983 2766 ~            ; whenever a `long` holds an unsigned int's worth, dropping its term altogether, and one that is
 3984 2766 ~            ; FFFFh, a negative int's, making it a subtraction. z88dk's runtime does the same (l_long_mult).
 3985 2766 ~            ; The halves wait in rt_a and rt_b, as division's do.
 3986 2766 ~            ; ---------------------------------------------------------------------------
 3987 2766 ~            __x80_lmul:
 3988 2766 ~                LD   (__x80_rt_a),HL    ; aL
 3989 2766 ~                EX   DE,HL
 3990 2766 ~                LD   (__x80_rt_a+2),HL  ; aH
 3991 2766 ~                LD   H,B
 3992 2766 ~                LD   L,C
 3993 2766 ~                LD   (__x80_rt_b),HL    ; bL
 3994 2766 ~                LD   HL,2
 3995 2766 ~                ADD  HL,SP
 3996 2766 ~                LD   A,(HL)
 3997 2766 ~                INC  HL
 3998 2766 ~                LD   H,(HL)
 3999 2766 ~                LD   L,A
 4000 2766 ~                LD   (__x80_rt_b+2),HL  ; bH
 4001 2766 ~                LD   HL,(__x80_rt_a)
 4002 2766 ~                EX   DE,HL              ; DE = aL, BC = bL
 4003 2766 ~                LD   A,E                ; the smaller the multiplier: its leading zeros are the cheap steps
 4004 2766 ~                SUB  C
 4005 2766 ~                LD   A,D
 4006 2766 ~                SBC  A,B
 4007 2766 ~                JP   C,.low
 4008 2766 ~                LD   H,B
 4009 2766 ~                LD   L,C
 4010 2766 ~                LD   B,D
 4011 2766 ~                LD   C,E
 4012 2766 ~                EX   DE,HL
 4013 2766 ~            .low:
 4014 2766 ~                CALL __x80_mulw         ; DE:HL = aL * bL
 4015 2766 ~                LD   (__x80_rt_lo),HL
 4016 2766 ~                LD   HL,(__x80_rt_b)
 4017 2766 ~                LD   B,H
 4018 2766 ~                LD   C,L
 4019 2766 ~                LD   HL,(__x80_rt_a+2)
 4020 2766 ~                CALL .cross             ; + aH * bL
 4021 2766 ~                LD   HL,(__x80_rt_a)
 4022 2766 ~                LD   B,H
 4023 2766 ~                LD   C,L
 4024 2766 ~                LD   HL,(__x80_rt_b+2)
 4025 2766 ~                CALL .cross             ; + aL * bH
 4026 2766 ~                LD   HL,(__x80_rt_lo)
 4027 2766 ~                RET
 4028 2766 ~            ; DE += HL * BC, the low sixteen bits: nothing for a zero HL, the high half of a long that holds
 4029 2766 ~            ; an unsigned int's worth; a subtraction for FFFFh, one that holds a negative int's.
 4030 2766 ~            .cross:
 4031 2766 ~                LD   A,H
 4032 2766 ~                OR   L
 4033 2766 ~                RET  Z
 4034 2766 ~                LD   A,H
 4035 2766 ~                AND  L
 4036 2766 ~                INC  A
 4037 2766 ~                JP   Z,.minus
 4038 2766 ~                PUSH DE
 4039 2766 ~                LD   D,B
 4040 2766 ~                LD   E,C
 4041 2766 ~                CALL __x80_mul16
 4042 2766 ~                POP  DE
 4043 2766 ~                ADD  HL,DE
 4044 2766 ~                EX   DE,HL
 4045 2766 ~                RET
 4046 2766 ~            .minus:
 4047 2766 ~                LD   A,E
 4048 2766 ~                SUB  C
 4049 2766 ~                LD   E,A
 4050 2766 ~                LD   A,D
 4051 2766 ~                SBC  A,B
 4052 2766 ~                LD   D,A
 4053 2766 ~                RET
 4054 2766                  ENDIF
