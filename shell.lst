 6146 2904 ~            ; ---------------------------------------------------------------------------
 6147 2904 ~            ; HL = destination, DE = source, BC = count. The same direction and the same
 6148 2904 ~            ; register convention as the reference generator's inline expansion, so that the
 6149 2904 ~            ; two back ends agree about what a struct assignment does.
 6150 2904 ~            ;
 6151 2904 ~            ; A count of zero copies nothing: the test is at the top, unlike the inline
 6152 2904 ~            ; version, because here the count can come from anywhere.
 6153 2904 ~            ; ---------------------------------------------------------------------------
 6154 2904 ~            __x80_memcpy:
 6155 2904 ~                LD   A,B
 6156 2904 ~                OR   C
 6157 2904 ~                RET  Z
 6158 2904 ~            __x80_memcpy_loop:
 6159 2904 ~                LD   A,(DE)
 6160 2904 ~                LD   (HL),A
 6161 2904 ~                INC  DE
 6162 2904 ~                INC  HL
 6163 2904 ~                DEC  BC
 6164 2904 ~                LD   A,B
 6165 2904 ~                OR   C
 6166 2904 ~                JP   NZ,__x80_memcpy_loop
 6167 2904 ~                RET
 6168 2904                  ENDIF
 6169 2904
 6170 2904              ; ---------------------------------------------------------------------------
 6171 2904              ; memcpy, memset and memmove of a length the program has only when it runs
 6172 2904              ; (lib/libc/string.c): HL = destination, DE = source (E the byte for memset),
 6173 2904              ; BC = the length; HL comes back as it went in, and A, BC, DE and the flags are
 6174 2904              ; written. Two bytes a trip, as __x80_mcpyp_even below (SIA, zx-pk.ru), the
 6175 2904              ; trips worked out here: one less than them is (n - 1) / 2 for an odd n and an
 6176 2904              ; even one alike, and the bit shifted out says which -- an odd n goes in at the
 6177 2904              ; second byte of the first pair. That halved, C its low byte and B its high one
 6178 2904              ; and each one more is what DEC C / JP NZ inside DEC B / JP NZ counts down. 0 is
 6179 2904              ; nothing at all, 65535 32768 trips. 31.5 T-states a byte for a copy and 19.5
 6180 2904              ; for a fill, against 39 and 27 for the loops in C they replace. -Os: a byte a
 6181 2904              ; trip, the length as the two counters straight away -- as fast as those loops
 6182 2904              ; were, and some ten bytes shorter each.
 6183 2904              ; ---------------------------------------------------------------------------
 6184 2904              ; memmove: forwards by __x80_mcpyn when the destination is below the source,
 6185 2904              ; else from the last byte down. Ahead of __x80_mcpyn, so that its IFUSED has seen
 6186 2904              ; the jump to it.
 6187 2904              ;
 6188 2904              ; -mstack-copy: a long one through SP too, when the two are far enough apart that
 6189 2904              ; what an interrupt pushes cannot reach a byte still wanted (SIA, zx-pk.ru). Above
 6190 2904              ; the source by X80_SP_RESERVE + 16 or more, from the end down as memcpy goes,
 6191 2904              ; __x80_mcpys: an interrupt writes into the destination below SP, not yet written
 6192 2904              ; and above every byte of the source still to be read; and the first bytes, which
 6193 2904              ; it copies upwards at the end, are below what the source gave for the rest. Below
 6194 2904              ; it by X80_SP_RESERVE or more, upwards by __x80_mmoves, below.
 6195 2904                  IFUSED __x80_mmoven
 6196 2904 ~            __x80_mmoven:
 6197 2904 ~                LD   A,L
 6198 2904 ~                SUB  E
 6199 2904 ~                LD   A,H
 6200 2904 ~                SBC  A,D
 6201 2904 ~                IFDEF X80_STACK_COPY
 6202 2904 ~                JP   C,.up
 6203 2904 ~                JP   NZ,.far            ; the high byte of d - s
 6204 2904 ~                LD   A,L
 6205 2904 ~                SUB  E
 6206 2904 ~                CP   X80_SP_RESERVE + 16
 6207 2904 ~                JP   C,.near
 6208 2904 ~            .far:
 6209 2904 ~                LD   A,B
 6210 2904 ~                OR   A
 6211 2904 ~                JP   NZ,__x80_mcpys
 6212 2904 ~                LD   A,C
 6213 2904 ~                CP   X80_SP_RESERVE + 32
 6214 2904 ~                JP   NC,__x80_mcpys
 6215 2904 ~                JP   .near
 6216 2904 ~            .up:
 6217 2904 ~                LD   A,E                ; s - d
 6218 2904 ~                SUB  L
 6219 2904 ~                LD   A,D
 6220 2904 ~                SBC  A,H
 6221 2904 ~                JP   NZ,.up_far
 6222 2904 ~                LD   A,E
 6223 2904 ~                SUB  L
 6224 2904 ~                CP   X80_SP_RESERVE
 6225 2904 ~                JP   C,__x80_mcpyn_pairs
 6226 2904 ~            .up_far:
 6227 2904 ~                LD   A,B
 6228 2904 ~                OR   A
 6229 2904 ~                JP   NZ,__x80_mmoves
 6230 2904 ~                LD   A,C
 6231 2904 ~                CP   X80_SP_RESERVE + 32
 6232 2904 ~                JP   NC,__x80_mmoves
 6233 2904 ~                JP   __x80_mcpyn_pairs
 6234 2904 ~            .near:
 6235 2904 ~                ELSE
 6236 2904 ~                JP   C,__x80_mcpyn_pairs ; below: forwards; the same place, down as well as any
 6237 2904 ~                ENDIF
 6238 2904 ~                LD   A,B
 6239 2904 ~                OR   C
 6240 2904 ~                RET  Z
 6241 2904 ~                PUSH HL
 6242 2904 ~                ADD  HL,BC
