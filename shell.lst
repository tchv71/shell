 2691 2AFB                  IFUSED __x80_fp_expn
 2692 2AFB ~            ; A = the exponent of the float whose top byte is at HL; carry set if it is 0 or 255 -- a zero or a
 2693 2AFB ~            ; subnormal, an infinity or a NaN -- and clear for a normal number. HL is left as it was.
 2694 2AFB ~            __x80_fp_expn:
 2695 2AFB ~                DEC  HL
 2696 2AFB ~                LD   A,(HL)
 2697 2AFB ~                RLA                     ; the exponent's last bit
 2698 2AFB ~                INC  HL
 2699 2AFB ~                LD   A,(HL)
 2700 2AFB ~                RLA
 2701 2AFB ~                INC  A
 2702 2AFB ~                CP   2
 2703 2AFB ~                DEC  A                  ; DEC leaves the carry
 2704 2AFB ~                RET
 2705 2AFB                  ENDIF
 2706 2AFB
 2707 2AFB                  IFUSED __x80_fp_fast2
 2708 2AFB ~            ; ---------------------------------------------------------------------------
 2709 2AFB ~            ; A product's or a quotient's operands, when both are normal numbers -- the common case, for
 2710 2AFB ~            ; which the general path's tests for NaNs, infinities, zeros and subnormals and its normalisation
 2711 2AFB ~            ; are all for nothing. Carry set if fpa or fpb is not one (an exponent field of 0 or 255), and
 2712 2AFB ~            ; then nothing is changed but fps, which the general path sets again. Otherwise, as that path
 2713 2AFB ~            ; would leave them: fps = the result's sign; the leading ones put into the significands, the low
 2714 2AFB ~            ; three bytes of fpa and fpb (__x80_fp_unpack); HL = a's exponent, BC = b's; D = b's top byte.
 2715 2AFB ~            ; ---------------------------------------------------------------------------
 2716 2AFB ~            __x80_fp_fast2:
 2717 2AFB ~                LD   HL,__x80_fpb+3
 2718 2AFB ~                LD   E,(HL)             ; b's sign and exponent but its last bit
 2719 2AFB ~                DEC  HL
 2720 2AFB ~                LD   D,(HL)             ; that bit and the significand's top seven
 2721 2AFB ~                LD   A,D
 2722 2AFB ~                RLA
 2723 2AFB ~                LD   A,E
 2724 2AFB ~                RLA                     ; b's exponent
 2725 2AFB ~                INC  A
 2726 2AFB ~                CP   2                  ; 0 or 255: the carry
 2727 2AFB ~                RET  C
 2728 2AFB ~                DEC  A
 2729 2AFB ~                LD   C,A
 2730 2AFB ~                LD   HL,__x80_fpa+3
 2731 2AFB ~                LD   A,(HL)
 2732 2AFB ~                XOR  E
 2733 2AFB ~                AND  80H
 2734 2AFB ~                LD   (__x80_fps),A      ; the signs'
 2735 2AFB ~                LD   E,(HL)
 2736 2AFB ~                DEC  HL
 2737 2AFB ~                LD   A,(HL)
 2738 2AFB ~                RLA
 2739 2AFB ~                LD   A,E
 2740 2AFB ~                RLA                     ; a's exponent
 2741 2AFB ~                INC  A
 2742 2AFB ~                CP   2
 2743 2AFB ~                RET  C
 2744 2AFB ~                DEC  A
 2745 2AFB ~                LD   E,A
 2746 2AFB ~                LD   A,(HL)
 2747 2AFB ~                OR   80H
 2748 2AFB ~                LD   (HL),A             ; a's leading one
 2749 2AFB ~                LD   A,D
 2750 2AFB ~                OR   80H
 2751 2AFB ~                LD   D,A
 2752 2AFB ~                LD   (__x80_fpb+2),A    ; b's
 2753 2AFB ~                LD   L,E
 2754 2AFB ~                XOR  A                  ; and the carry clear
 2755 2AFB ~                LD   H,A
 2756 2AFB ~                LD   B,A
 2757 2AFB ~                RET
 2758 2AFB                  ENDIF
 2759 2AFB
 2760 2AFB                  IFUSED __x80_fp_load2
 2761 2AFB ~            ; ---------------------------------------------------------------------------
 2762 2AFB ~            ; fpa = DE:HL, fpb = BC and the word above the operation's return address: for an operation
 2763 2AFB ~            ; that has called this first.
 2764 2AFB ~            ; ---------------------------------------------------------------------------
 2765 2AFB ~            __x80_fp_load2:
 2766 2AFB ~                LD   (__x80_fpa),HL
 2767 2AFB ~                EX   DE,HL
 2768 2AFB ~                LD   (__x80_fpa+2),HL
 2769 2AFB ~                LD   H,B
 2770 2AFB ~                LD   L,C
 2771 2AFB ~                LD   (__x80_fpb),HL
 2772 2AFB ~                LD   HL,4
 2773 2AFB ~                ADD  HL,SP
 2774 2AFB ~                LD   A,(HL)
 2775 2AFB ~                INC  HL
 2776 2AFB ~                LD   H,(HL)
 2777 2AFB ~                LD   L,A
 2778 2AFB ~                LD   (__x80_fpb+2),HL
 2779 2AFB ~                RET
 2780 2AFB                  ENDIF
 2781 2AFB
 2782 2AFB                  IFUSED __x80_fp_nan2
 2783 2AFB ~            ; ---------------------------------------------------------------------------
 2784 2AFB ~            ; Returns if neither fpa nor fpb is a NaN. If either is, the operation's result is the first NaN
 2785 2AFB ~            ; of the two, quieted: this returns it from the operation itself, dropping the return into it.
 2786 2AFB ~            ; ---------------------------------------------------------------------------
 2787 2AFB ~            __x80_fp_nan2:
