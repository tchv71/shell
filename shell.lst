 4219 27D4              ; ---------------------------------------------------------------------------
 4220 27D4              ; Division and remainder, unsigned and signed.
 4221 27D4              ;
 4222 27D4              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 27D4              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 27D4              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 27D4              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 27D4              ; ---------------------------------------------------------------------------
 4227 27D4              __x80_ludiv:
 4228 27D4 CD DD 27         CALL __x80_div_args
 4229 27D7 CD 05 28         CALL __x80_divide
 4230 27DA C3 F5 27         JP   __x80_quotient
 4231 27DD                  ENDIF
