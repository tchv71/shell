 8240 292C                  IFUSED __x80_call_hl
 8241 292C ~            ; ---------------------------------------------------------------------------
 8242 292C ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 292C ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 292C ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 292C ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 292C ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 292C ~            ; whose copy of this turns the address into the function's copy first
 8248 292C ~            ; (marinovsoft, zx-pk.ru).
 8249 292C ~            ; ---------------------------------------------------------------------------
 8250 292C ~            __x80_call_hl:
 8251 292C ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 292C ~                JP   (HL)
 8253 292C                  ENDIF
 8254 292C
 8255 292C                  IFUSED __x80_call_bc
 8256 292C ~
 8257 292C ~            ; ---------------------------------------------------------------------------
 8258 292C ~            ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 292C ~            ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 292C ~            ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 292C ~            ; callee's own RET then finds the caller's address underneath and comes back.
 8262 292C ~            ;
 8263 292C ~            ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 292C ~            ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 292C ~            ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 292C ~            ; argument gets.
 8267 292C ~            ; ---------------------------------------------------------------------------
 8268 292C ~            __x80_call_bc:
 8269 292C ~            ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 292C ~            ;@irq    LD   H,B
 8271 292C ~            ;@irq    LD   L,C
 8272 292C ~            ;@irq    CALL __x80_xlat
 8273 292C ~            ;@irq    LD   B,H
 8274 292C ~            ;@irq    LD   C,L
 8275 292C ~            ;@irq    POP  HL
 8276 292C ~                PUSH BC
 8277 292C ~                RET
 8278 292C                  ENDIF
 8279 292C
 8280 292C                  IFUSED __x80_call_mem
 8281 292C ~            ; ---------------------------------------------------------------------------
 8282 292C ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 292C ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 292C ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 292C ~            ; return address underneath. Forty-three T-states.
 8286 292C ~            ; ---------------------------------------------------------------------------
 8287 292C ~            __x80_call_mem:
 8288 292C ~                PUSH HL
 8289 292C ~                LD   HL,(__x80_call_target)
 8290 292C ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 292C ~                EX   (SP),HL
 8292 292C ~                RET
 8293 292C                  ENDIF
 8294 292C
 8295 292C                  IFUSED _setjmp
 8296 292C ~            ; ---------------------------------------------------------------------------
 8297 292C ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 292C ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 292C ~            ; to save, so those two words are all there is.
 8300 292C ~            ; ---------------------------------------------------------------------------
 8301 292C ~            _setjmp:
 8302 292C ~                POP  DE             ; the return address
 8303 292C ~                PUSH DE
 8304 292C ~                LD   (HL),E
 8305 292C ~                INC  HL
 8306 292C ~                LD   (HL),D
 8307 292C ~                INC  HL
 8308 292C ~                EX   DE,HL          ; DE -> the second word
 8309 292C ~                LD   HL,2
 8310 292C ~                ADD  HL,SP          ; the caller's SP after the return
 8311 292C ~                EX   DE,HL
 8312 292C ~                LD   (HL),E
 8313 292C ~                INC  HL
 8314 292C ~                LD   (HL),D
 8315 292C ~                LD   HL,0
 8316 292C ~                RET
 8317 292C                  ENDIF
 8318 292C
 8319 292C                  IFUSED _longjmp
 8320 292C ~            ; ---------------------------------------------------------------------------
 8321 292C ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 292C ~            ; returning val there -- or 1, if val is 0.
 8323 292C ~            ; ---------------------------------------------------------------------------
 8324 292C ~            _longjmp:
 8325 292C ~                LD   A,D
 8326 292C ~                OR   E
 8327 292C ~                JP   NZ,.value
 8328 292C ~                INC  DE
 8329 292C ~            .value:
 8330 292C ~                LD   C,(HL)
 8331 292C ~                INC  HL
 8332 292C ~                LD   B,(HL)         ; BC = where to go
 8333 292C ~                INC  HL
 8334 292C ~                LD   A,(HL)
 8335 292C ~                INC  HL
 8336 292C ~                LD   H,(HL)
 8337 292C ~                LD   L,A
 8338 292C ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 292C ~                EX   DE,HL          ; the value, in HL
 8340 292C ~                PUSH BC
 8341 292C ~                RET
 8342 292C                  ENDIF
 8343 292C
 8344 292C                  IFUSED __x80_sp
 8345 292C ~            ; ---------------------------------------------------------------------------
 8346 292C ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 292C ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 292C ~            ; ---------------------------------------------------------------------------
 8349 292C ~            __x80_sp:
 8350 292C ~                LD   HL,0
 8351 292C ~                ADD  HL,SP
 8352 292C ~                RET
 8353 292C                  ENDIF
