 1169 2766 ~                PUSH HL
 1170 2766 ~                CALL __x80_q_shl
 1171 2766 ~                DEC  C
 1172 2766 ~                JP   NZ,.shl
 1173 2766 ~                POP  HL
 1174 2766 ~                RET
