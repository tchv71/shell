 4329 2797              __x80_divide:
 4330 2797                  IFDEF X80_OPT_SIZE
 4331 2797                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2797                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2797                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2797                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2797                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2797 2A C2 28         LD   HL,(__x80_rt_b)
 4337 279A 7C               LD   A,H
 4338 279B B5               OR   L
 4339 279C 2A C4 28         LD   HL,(__x80_rt_b+2)
 4340 279F B4               OR   H
 4341 27A0 B5               OR   L
 4342 27A1 CA 44 28         JP   Z,.s_zero
 4343 27A4 21 C2 28         LD   HL,__x80_rt_b
 4344 27A7 11 BE 28         LD   DE,__x80_rt_r
 4345 27AA 06 04            LD   B,4
 4346 27AC              .s_not:
 4347 27AC 7E               LD   A,(HL)
 4348 27AD 2F               CPL
 4349 27AE 12               LD   (DE),A
 4350 27AF 23               INC  HL
 4351 27B0 13               INC  DE
 4352 27B1 05               DEC  B
 4353 27B2 C2 AC 27         JP   NZ,.s_not
 4354 27B5 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 27B7              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 27B7 3A C9 28         LD   A,(__x80_rt_a+3)
 4357 27BA B7               OR   A
 4358 27BB C2 D5 27         JP   NZ,.s_go
 4359 27BE 2A C7 28         LD   HL,(__x80_rt_a+1)
 4360 27C1 22 C8 28         LD   (__x80_rt_a+2),HL
 4361 27C4 3A C6 28         LD   A,(__x80_rt_a)
 4362 27C7 32 C7 28         LD   (__x80_rt_a+1),A
 4363 27CA AF               XOR  A
 4364 27CB 32 C6 28         LD   (__x80_rt_a),A
 4365 27CE 78               LD   A,B
 4366 27CF D6 08            SUB  8
 4367 27D1 47               LD   B,A
 4368 27D2 C2 B7 27         JP   NZ,.s_skip
 4369 27D5              .s_go:
 4370 27D5 21 00 00         LD   HL,0
 4371 27D8 54               LD   D,H
 4372 27D9 5D               LD   E,L
 4373 27DA 78               LD   A,B
 4374 27DB B7               OR   A
 4375 27DC CA 3C 28         JP   Z,.s_done          ; a dividend of zero
 4376 27DF              .s_loop:
 4377 27DF F5               PUSH AF
 4378 27E0 3A C6 28         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 27E3 87               ADD  A,A
 4380 27E4 32 C6 28         LD   (__x80_rt_a),A
 4381 27E7 3A C7 28         LD   A,(__x80_rt_a+1)
 4382 27EA 17               RLA
 4383 27EB 32 C7 28         LD   (__x80_rt_a+1),A
 4384 27EE 3A C8 28         LD   A,(__x80_rt_a+2)
 4385 27F1 17               RLA
 4386 27F2 32 C8 28         LD   (__x80_rt_a+2),A
 4387 27F5 3A C9 28         LD   A,(__x80_rt_a+3)
 4388 27F8 17               RLA
 4389 27F9 32 C9 28         LD   (__x80_rt_a+3),A
 4390 27FC 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 27FD 17               RLA
 4392 27FE 6F               LD   L,A
 4393 27FF 7C               LD   A,H
 4394 2800 17               RLA
 4395 2801 67               LD   H,A
 4396 2802 7B               LD   A,E
 4397 2803 17               RLA
 4398 2804 5F               LD   E,A
 4399 2805 7A               LD   A,D
 4400 2806 17               RLA
 4401 2807 57               LD   D,A
 4402 2808 01 BE 28         LD   BC,__x80_rt_r
 4403 280B DA 20 28         JP   C,.s_take          ; above the divisor whatever the rest
 4404 280E 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 280F 0A               LD   A,(BC)
 4406 2810 8D               ADC  A,L
 4407 2811 03               INC  BC
 4408 2812 0A               LD   A,(BC)
 4409 2813 8C               ADC  A,H
 4410 2814 03               INC  BC
 4411 2815 0A               LD   A,(BC)
 4412 2816 8B               ADC  A,E
 4413 2817 03               INC  BC
 4414 2818 0A               LD   A,(BC)
 4415 2819 8A               ADC  A,D
 4416 281A D2 37 28         JP   NC,.s_next
 4417 281D 01 BE 28         LD   BC,__x80_rt_r
 4418 2820              .s_take:
 4419 2820 37               SCF                     ; d taken off, and a 1
 4420 2821 0A               LD   A,(BC)
 4421 2822 8D               ADC  A,L
 4422 2823 6F               LD   L,A
 4423 2824 03               INC  BC
 4424 2825 0A               LD   A,(BC)
 4425 2826 8C               ADC  A,H
 4426 2827 67               LD   H,A
 4427 2828 03               INC  BC
 4428 2829 0A               LD   A,(BC)
 4429 282A 8B               ADC  A,E
 4430 282B 5F               LD   E,A
 4431 282C 03               INC  BC
 4432 282D 0A               LD   A,(BC)
 4433 282E 8A               ADC  A,D
 4434 282F 57               LD   D,A
 4435 2830 3A C6 28         LD   A,(__x80_rt_a)
 4436 2833 3C               INC  A
 4437 2834 32 C6 28         LD   (__x80_rt_a),A
 4438 2837              .s_next:
 4439 2837 F1               POP  AF
 4440 2838 3D               DEC  A
 4441 2839 C2 DF 27         JP   NZ,.s_loop
 4442 283C              .s_done:
 4443 283C 22 BE 28         LD   (__x80_rt_r),HL
 4444 283F EB               EX   DE,HL
 4445 2840 22 C0 28         LD   (__x80_rt_r+2),HL
 4446 2843 C9               RET
 4447 2844              .s_zero:
 4448 2844 2A C6 28         LD   HL,(__x80_rt_a)    ; as below: all ones, and the dividend left over
 4449 2847 22 BE 28         LD   (__x80_rt_r),HL
 4450 284A 2A C8 28         LD   HL,(__x80_rt_a+2)
 4451 284D 22 C0 28         LD   (__x80_rt_r+2),HL
 4452 2850 21 FF FF         LD   HL,0FFFFH
 4453 2853 22 C6 28         LD   (__x80_rt_a),HL
 4454 2856 22 C8 28         LD   (__x80_rt_a+2),HL
 4455 2859 C9               RET
 4456 285A                  ELSE
 4457 285A ~                ; A divisor below 32768 -- ten for a number being printed, a modulus, a count -- is a byte of
 4458 285A ~                ; the quotient at a time (__x80_dpass8, __x80_dpass16), the dividend's bytes from the top: some
 4459 285A ~                ; 1 300 T-states for a byte divisor, 1 100 for a word, where shifting the four bytes through
 4460 285A ~                ; memory a bit at a time was several thousand.
 4461 285A ~                LD   HL,(__x80_rt_b+2)
