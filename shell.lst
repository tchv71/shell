 4219 2766              ; ---------------------------------------------------------------------------
 4220 2766              ; Division and remainder, unsigned and signed.
 4221 2766              ;
 4222 2766              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 2766              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 2766              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 2766              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 2766              ; ---------------------------------------------------------------------------
 4227 2766              __x80_ludiv:
 4228 2766 CD 6F 27         CALL __x80_div_args
 4229 2769 CD 97 27         CALL __x80_divide
 4230 276C C3 87 27         JP   __x80_quotient
 4231 276F                  ENDIF
