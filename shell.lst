 5753 2C2B                  IFUSED __x80_mul16
 5754 2C2B              ; ---------------------------------------------------------------------------
 5755 2C2B              ; HL = HL * DE, sixteen bits, wrapping.
 5756 2C2B              ;
 5757 2C2B              ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2C2B              ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2C2B              ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2C2B              ; and ten more for a set one.
 5761 2C2B              ;
 5762 2C2B              ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2C2B              ; an index times the size of an element, a value times a small factor. When it is the
 5764 2C2B              ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2C2B              ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2C2B              ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2C2B              ;
 5768 2C2B              ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2C2B              ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2C2B              ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2C2B              ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2C2B              ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2C2B              ; keep the eight steps from zero.
 5774 2C2B              ;
 5775 2C2B              ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2C2B              ; additions.
 5777 2C2B              ; ---------------------------------------------------------------------------
 5778 2C2B              __x80_mul16:
 5779 2C2B AF               XOR  A
 5780 2C2C B2               OR   D
 5781 2C2D CA 36 2C         JP   Z,.small       ; the multiplier fits in a byte
 5782 2C30 AF               XOR  A
 5783 2C31 B4               OR   H
 5784 2C32 C2 3F 2C         JP   NZ,.full
 5785 2C35 EB               EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2C36              .small:
 5787 2C36 44               LD   B,H
 5788 2C37 4D               LD   C,L            ; BC = multiplicand
 5789 2C38                  IFNDEF X80_OPT_SPEED
 5790 2C38 21 00 00         LD   HL,0
 5791 2C3B 7B               LD   A,E
 5792 2C3C C3 49 2C         JP   __x80_mul16_byte
 5793 2C3F              .full:
 5794 2C3F 44               LD   B,H
 5795 2C40 4D               LD   C,L
 5796 2C41 21 00 00         LD   HL,0
 5797 2C44 7A               LD   A,D
 5798 2C45 CD 49 2C         CALL __x80_mul16_byte
 5799 2C48 7B               LD   A,E
 5800 2C49                  ELSE
 5801 2C49 ~                LD   A,E
 5802 2C49 ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2C49 ~            .full:
 5804 2C49 ~                LD   B,H
 5805 2C49 ~                LD   C,L
 5806 2C49 ~                LD   A,D
 5807 2C49 ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2C49 ~                LD   A,E
 5809 2C49 ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2C49                  ENDIF
 5811 2C49                  ENDIF
 5812 2C49
 5813 2C49                  IFUSED __x80_mul16_byte
 5814 2C49              ; HL = HL * 256 + BC * A: eight steps of the above, for the byte in A. What __x80_mul16 falls into,
 5815 2C49              ; and what the compiler calls itself for a word by a byte widened (isel.c, select_muldiv).
 5816 2C49              __x80_mul16_byte:
 5817 2C49                  IFDEF X80_OPT_SIZE
