 1428 2AFB              ; ---------------------------------------------------------------------------
 1429 2AFB              ; binary32: float arithmetic, comparison and conversions to and from long.
 1430 2AFB              ;
 1431 2AFB              ; The compiler calls these for every float operation: a float is its bits, an operand like a
 1432 2AFB              ; long -- a in HL (low word) and DE (high word), b in BC (low) and on the stack above the return
 1433 2AFB              ; address (high), left there for the caller to take off -- and the result in HL:DE, a comparison's
 1434 2AFB              ; in A. The algorithms are those of the compiler's C reference implementation of IEEE 754, and the
 1435 2AFB              ; results agree with it bit for bit: one rounding, to the nearest with ties to even; subnormals;
 1436 2AFB              ; infinities; and NaNs that come back quieted, the first operand's when both are, as on the
 1437 2AFB              ; x86.
 1438 2AFB              ;
 1439 2AFB              ; A finite number in the middle of an operation is a sign (in fps), an exponent in BC and a
 1440 2AFB              ; significand of thirty-two bits in DEHL, D the top byte, its leading one at bit 31: twenty-four
 1441 2AFB              ; bits of the result and eight below them, which decide the rounding -- the round bit is bit 7,
 1442 2AFB              ; and whatever was shifted out below bit 0 is kept as a one in bit 0, the sticky bit. Its value is
 1443 2AFB              ; DEHL / 2^31 * 2^(BC - 127), so BC is the biased exponent the result has before rounding.
 1444 2AFB              ; __x80_fp_rpack makes the float of that. The operands wait in fpa and fpb, the bytes as in
 1445 2AFB              ; memory, low first.
 1446 2AFB              ;
 1447 2AFB              ; Not reentrant: an interrupt handler doing float arithmetic while the main program is inside one
 1448 2AFB              ; of these would corrupt it, as with the division of longs.
 1449 2AFB              ; ---------------------------------------------------------------------------
 1450 2AFB
 1451 2AFB                  IFUSED __x80_fsub
 1452 2AFB ~            __x80_fsub:
 1453 2AFB ~                LD   A,80H              ; b's sign flipped: the addition, which follows its first byte
 1454 2AFB ~                JP   __x80_fadd+1
 1455 2AFB                  ENDIF
 1456 2AFB
 1457 2AFB                  IFUSED __x80_fadd
 1458 2AFB ~            ; ---------------------------------------------------------------------------
 1459 2AFB ~            ; DE:HL = a + b. With |a| >= |b| -- swapped if not -- the result has a's sign, and b's
 1460 2AFB ~            ; significand, shifted down to a's exponent, is added to a's or taken from it. A subnormal is
 1461 2AFB ~            ; taken as exponent 1 without the leading one, and comes the same way; a NaN, an infinity and a
 1462 2AFB ~            ; zero b are dealt with before.
 1463 2AFB ~            ; ---------------------------------------------------------------------------
 1464 2AFB ~            __x80_fadd:
 1465 2AFB ~                XOR  A                  ; one byte: __x80_fsub comes in after it
