 4327 2B2C                  IFUSED __x80_divide
 4328 2B2C
 4329 2B2C              __x80_divide:
 4330 2B2C                  IFDEF X80_OPT_SIZE
 4331 2B2C                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2B2C                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2B2C                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2B2C                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2B2C                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2B2C 2A 89 2C         LD   HL,(__x80_rt_b)
 4337 2B2F 7C               LD   A,H
 4338 2B30 B5               OR   L
 4339 2B31 2A 8B 2C         LD   HL,(__x80_rt_b+2)
 4340 2B34 B4               OR   H
 4341 2B35 B5               OR   L
 4342 2B36 CA D9 2B         JP   Z,.s_zero
 4343 2B39 21 89 2C         LD   HL,__x80_rt_b
 4344 2B3C 11 85 2C         LD   DE,__x80_rt_r
 4345 2B3F 06 04            LD   B,4
 4346 2B41              .s_not:
 4347 2B41 7E               LD   A,(HL)
 4348 2B42 2F               CPL
 4349 2B43 12               LD   (DE),A
 4350 2B44 23               INC  HL
 4351 2B45 13               INC  DE
 4352 2B46 05               DEC  B
 4353 2B47 C2 41 2B         JP   NZ,.s_not
 4354 2B4A 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2B4C              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 2B4C 3A 90 2C         LD   A,(__x80_rt_a+3)
 4357 2B4F B7               OR   A
 4358 2B50 C2 6A 2B         JP   NZ,.s_go
 4359 2B53 2A 8E 2C         LD   HL,(__x80_rt_a+1)
 4360 2B56 22 8F 2C         LD   (__x80_rt_a+2),HL
 4361 2B59 3A 8D 2C         LD   A,(__x80_rt_a)
 4362 2B5C 32 8E 2C         LD   (__x80_rt_a+1),A
 4363 2B5F AF               XOR  A
