 3666 2AFB ~                RLA
 3667 2AFB ~                SBC  A,A
 3668 2AFB ~                LD   B,A                ; the sign's byte, what comes in at the top
 3669 2AFB ~                LD   A,C
 3670 2AFB ~                LD   C,B
 3671 2AFB ~            .bytes:
 3672 2AFB ~                CP   8
 3673 2AFB ~                JP   C,.bits
 3674 2AFB ~                CALL __x80_q_down
