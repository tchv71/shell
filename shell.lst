 6263 2904 ~                ELSE
 6264 2904 ~                LD   A,B
 6265 2904 ~                OR   A                  ; the carry clear: ADD HL,BC may have set it
 6266 2904 ~                RRA
 6267 2904 ~                LD   B,A
 6268 2904 ~                LD   A,C
 6269 2904 ~                RRA
