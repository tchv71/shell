 5964 2C5B                  IFUSED __x80_shl16
 5965 2C5B ~
 5966 2C5B ~            ; ---------------------------------------------------------------------------
 5967 2C5B ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2C5B ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2C5B ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2C5B ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2C5B ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2C5B ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2C5B ~            ; Vector, which rounds every instruction up to four.
 5974 2C5B ~            ;
 5975 2C5B ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2C5B ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2C5B ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2C5B ~            ; here is the per-bit cost, not the call overhead.
 5979 2C5B ~            ; ---------------------------------------------------------------------------
 5980 2C5B ~            __x80_shl16:
 5981 2C5B ~                XOR  A
 5982 2C5B ~                OR   E
 5983 2C5B ~                RET  Z
 5984 2C5B ~                CP   8
 5985 2C5B ~                JP   NC,.bytes
 5986 2C5B ~            .loop:
 5987 2C5B ~                ADD  HL,HL
 5988 2C5B ~                DEC  A
 5989 2C5B ~                JP   NZ,.loop
 5990 2C5B ~                RET
 5991 2C5B ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2C5B ~            .bytes:
 5993 2C5B ~                LD   H,L
 5994 2C5B ~                LD   L,0
 5995 2C5B ~                SUB  8
 5996 2C5B ~                RET  Z
 5997 2C5B ~                CP   8
 5998 2C5B ~                JP   NC,.zero
 5999 2C5B ~                LD   B,A
 6000 2C5B ~                LD   A,H
 6001 2C5B ~            .byte:
 6002 2C5B ~                ADD  A,A
 6003 2C5B ~                DEC  B
 6004 2C5B ~                JP   NZ,.byte
 6005 2C5B ~                LD   H,A
 6006 2C5B ~                RET
 6007 2C5B ~            .zero:
 6008 2C5B ~                LD   H,L
 6009 2C5B ~                RET
 6010 2C5B                  ENDIF
