 8355 292C              ;@shared
 8356 292C                  IFNDEF X80_EXIT_DEFINED
 8357 292C                  IFUSED __x80_exit
 8358 292C ~            ; ---------------------------------------------------------------------------
 8359 292C ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 292C ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 292C ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 292C ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 292C ~            ; (lib/crt/test_start.asm).
 8364 292C ~            ; ---------------------------------------------------------------------------
