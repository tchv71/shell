 5590 2C2B ~            ; __x80_dpass8: the same for a divisor d of 1..255, held as B = d * 128 in BC, -B in DE
 5591 2C2B ~            ; (__x80_dsetup8). HL is a remainder below d times 256 plus the next byte of the dividend; returns
