 3759 2AFB              ; qa = qa / qb, qr = qa % qb, unsigned: restoring division, sixty-four times. The dividend shifts
 3760 2AFB              ; out of qa into the remainder and the quotient shifts in behind it.
 3761 2AFB                  IFUSED __x80_q_divide
 3762 2AFB ~            __x80_q_divide:
