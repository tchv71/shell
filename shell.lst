 2721 27D4 ~                LD   A,D
 2722 27D4 ~                RLA
 2723 27D4 ~                LD   A,E
 2724 27D4 ~                RLA                     ; b's exponent
 2725 27D4 ~                INC  A
 2726 27D4 ~                CP   2                  ; 0 or 255: the carry
