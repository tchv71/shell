 2535 2766 ~                OR   (HL)
 2536 2766 ~                OR   B
 2537 2766 ~                OR   C
 2538 2766 ~                LD   B,A
 2539 2766 ~                LD   A,D
 2540 2766 ~                ADD  A,A
 2541 2766 ~                OR   B
