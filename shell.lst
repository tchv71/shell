 2455 2AFB ~                OR   A
 2456 2AFB ~                JP   NZ,__x80_fp_rpack
 2457 2AFB ~                LD   A,C
 2458 2AFB ~                DEC  A
 2459 2AFB ~                CP   0FEH
 2460 2AFB ~                JP   NC,__x80_fp_rpack
 2461 2AFB ~                LD   C,A
 2462 2AFB ~                JP   __x80_fp_rpack.round
 2463 2AFB ~                ELSE
 2464 2AFB ~                JP   __x80_fp_rpack
 2465 2AFB ~                ENDIF
