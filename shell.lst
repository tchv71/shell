 8503 28BE              ;@shared
 8504 28BE              ; main's argv: no arguments, so argv[0], which is argv[argc], is the null pointer.
 8505 28BE                  IFUSED __x80_argv
 8506 28BE ~            __x80_argv: DEFW 0
 8507 28BE                  ENDIF
 8508 28BE              ;@end
 8509 28BE
 8510 28BE              ; printf's floating-point conversions (lib/libc/stdio.c) are reached through this
 8511 28BE              ; word: the address of __x80_format_double when the program passes a floating
 8512 28BE              ; value to a function with `...` -- the compiler then names __x80_float_varargs
 8513 28BE              ; in an EQU, which is what IFUSED counts -- and zero otherwise, so that a program
 8514 28BE              ; printing only integers does not carry them.
 8515 28BE              ;@shared
 8516 28BE              __x80_float_varargs EQU 0
 8517 28BE              ;@end
 8518 28BE
 8519 28BE                  IFUSED __x80_printf_float
 8520 28BE ~            __x80_printf_float:
 8521 28BE ~                IFUSED __x80_float_varargs
 8522 28BE ~                DEFW __x80_format_double
 8523 28BE ~                ELSE
 8524 28BE ~                DEFW 0
 8525 28BE ~                ENDIF
 8526 28BE                  ENDIF
 8527 28BE
 8528 28BE              ; And the same for printf's 64-bit integers, %lld and its kind: __x80_format_ll when the program
 8529 28BE              ; passes a 64-bit integer to a function with `...` (__x80_ll_varargs), zero otherwise.
 8530 28BE              ;@shared
 8531 28BE              __x80_ll_varargs EQU 0
 8532 28BE              ;@end
 8533 28BE
 8534 28BE                  IFUSED __x80_printf_ll
 8535 28BE ~            __x80_printf_ll:
 8536 28BE ~                IFUSED __x80_ll_varargs
 8537 28BE ~                DEFW __x80_format_ll
 8538 28BE ~                ELSE
 8539 28BE ~                DEFW 0
 8540 28BE ~                ENDIF
 8541 28BE                  ENDIF
 8542 28BE
 8543 28BE              ; Where the characters of a written-out printf go (lib/libc/stdio.c, pw_out): to putchar, the
 8544 28BE              ; character in L -- or, in a program that has sprintf or snprintf written out, which is what uses
 8545 28BE              ; __x80_put_to, into the buffer while __x80_pw_mode is set. A program that only prints carries the
 8546 28BE              ; JP alone.
 8547 28BE                  IFUSED __x80_pw_out
 8548 28BE ~            __x80_pw_out:
 8549 28BE ~                IFUSED __x80_put_to
 8550 28BE ~                LD   A,(__x80_pw_mode)
 8551 28BE ~                OR   A
 8552 28BE ~                JP   NZ,__x80_pw_buffer
 8553 28BE ~                ENDIF
 8554 28BE ~                JP   _putchar
 8555 28BE                  ENDIF
 8556 28BE                  IFUSED __x80_pw_mode
 8557 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8558 28BE ~            __x80_pw_mode EQU __x80_bss_top - __x80_bss_off   ; sprintf's buffer is where the characters go
 8559 28BE                  ENDIF
 8560 28BE
 8561 28BE              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 28BE              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 28BE              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 28BE              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 28BE              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 28BE              ;@shared
 8567 28BE                  IFUSED _vc_on_frame
 8568 28BE ~                IFNDEF __X80_DEF_vc_on_frame
 8569 28BE ~            _vc_on_frame:
 8570 28BE ~                RET
 8571 28BE ~                ENDIF
 8572 28BE                  ENDIF
 8573 28BE              ;@end
 8574 28BE
 8575 28BE              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 28BE              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 28BE              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 28BE              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 28BE              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 28BE              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 28BE              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 28BE              ; function written in assembly, which has none; every other register kept.
 8583 28BE              ;@shared
 8584 28BE                  IFUSED __x80_xlat
 8585 28BE ~            __x80_xlat:
 8586 28BE ~                PUSH AF
 8587 28BE ~                PUSH BC
 8588 28BE ~                PUSH DE
 8589 28BE ~                EX   DE,HL              ; DE the address
 8590 28BE ~                LD   HL,__x80_xlat_last
 8591 28BE ~            .segment:
 8592 28BE ~                LD   A,H
 8593 28BE ~                OR   L
 8594 28BE ~                JP   Z,.done
 8595 28BE ~                LD   C,(HL)
 8596 28BE ~                INC  HL
 8597 28BE ~                LD   B,(HL)             ; BC the segment before
 8598 28BE ~                INC  HL
 8599 28BE ~            .entry:
 8600 28BE ~                LD   A,(HL)
 8601 28BE ~                INC  HL
 8602 28BE ~                OR   (HL)
 8603 28BE ~                JP   Z,.end             ; the zero word
 8604 28BE ~                DEC  HL
 8605 28BE ~                LD   A,(HL)
 8606 28BE ~                CP   E
 8607 28BE ~                INC  HL
 8608 28BE ~                JP   NZ,.skip
 8609 28BE ~                LD   A,(HL)
 8610 28BE ~                CP   D
 8611 28BE ~                JP   Z,.found
 8612 28BE ~            .skip:
 8613 28BE ~                INC  HL
 8614 28BE ~                INC  HL
 8615 28BE ~                INC  HL
 8616 28BE ~                JP   .entry
 8617 28BE ~            .found:
 8618 28BE ~                INC  HL
 8619 28BE ~                LD   E,(HL)
 8620 28BE ~                INC  HL
 8621 28BE ~                LD   D,(HL)             ; DE the copy
 8622 28BE ~                JP   .done
 8623 28BE ~            .end:
 8624 28BE ~                LD   H,B
 8625 28BE ~                LD   L,C
 8626 28BE ~                JP   .segment
 8627 28BE ~            .done:
 8628 28BE ~                EX   DE,HL
 8629 28BE ~                POP  DE
 8630 28BE ~                POP  BC
 8631 28BE ~                POP  AF
 8632 28BE ~                RET
 8633 28BE                  ENDIF
 8634 28BE              ;@end
 8635 28BE
 8636 28BE              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 28BE              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 28BE              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 28BE              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 28BE              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 28BE              ; the library since. Every register kept.
 8642 28BE              ;@shared
 8643 28BE                  IFUSED __x80_busy
 8644 28BE ~            __x80_bss_off = __x80_bss_off + 1
 8645 28BE ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 28BE                  ENDIF
 8647 28BE                  IFUSED __x80_pending
 8648 28BE ~            __x80_bss_off = __x80_bss_off + 2
 8649 28BE ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 28BE                  ENDIF
 8651 28BE                  IFUSED __x80_run_deferred
 8652 28BE ~            __x80_run_deferred:
 8653 28BE ~                PUSH AF
 8654 28BE ~                PUSH HL
 8655 28BE ~                LD   HL,(__x80_pending)
 8656 28BE ~                LD   A,H
 8657 28BE ~                OR   L
 8658 28BE ~                JP   Z,.done
 8659 28BE ~                PUSH BC
 8660 28BE ~                PUSH DE
 8661 28BE ~                PUSH HL
 8662 28BE ~                LD   HL,0
 8663 28BE ~                LD   (__x80_pending),HL
 8664 28BE ~                POP  HL
 8665 28BE ~                DI
 8666 28BE ~                CALL .go
 8667 28BE ~                EI
 8668 28BE ~                POP  DE
 8669 28BE ~                POP  BC
 8670 28BE ~            .done:
 8671 28BE ~                POP  HL
 8672 28BE ~                POP  AF
 8673 28BE ~                RET
 8674 28BE ~            .go:
 8675 28BE ~                JP   (HL)
 8676 28BE                  ENDIF
 8677 28BE              ;@end
 8678 28BE
 8679 28BE              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 28BE              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 28BE              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 28BE              ; and the startup code clears them and puts the stack below them. Last in the
 8683 28BE              ; file, and this file last on the assembler's command line.
 8684 28BE              ;@shared
 8685 28BE                  IFUSED __x80_xlat
 8686 28BE ~            __x80_xlat_last EQU __x80_xlat_head
 8687 28BE                  ENDIF
 8688 28BE              __x80_bss_size EQU __x80_bss_off
 8689 28BE                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 28BE                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 28BE                  IFDEF X80_BSS_IN_IMAGE
 8692 28BE              __x80_bss_image:
 8693 28BE                  IF __x80_bss_size
 8694 28BE 00 00 00...      DEFS __x80_bss_size
 8695 2C67                  ENDIF
 8696 2C67                  ENDIF
 8697 2C67                  IFUSED __x80_heap
 8698 2C67 ~            __x80_heap:
 8699 2C67                  ENDIF
 8700 2C67              ;@end
 8701 2C67
