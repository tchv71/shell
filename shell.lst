 6244 2C5B ~                EX   DE,HL
 6245 2C5B ~                ADD  HL,BC
 6246 2C5B ~                DEC  HL
 6247 2C5B ~                EX   DE,HL              ; HL and DE at the last bytes
 6248 2C5B ~                DEC  BC
 6249 2C5B ~                IFDEF X80_OPT_SIZE
 6250 2C5B ~                INC  B
 6251 2C5B ~                INC  C
 6252 2C5B ~            .byte:
 6253 2C5B ~                LD   A,(DE)
 6254 2C5B ~                LD   (HL),A
 6255 2C5B ~                DEC  DE
 6256 2C5B ~                DEC  HL
 6257 2C5B ~                DEC  C
 6258 2C5B ~                JP   NZ,.byte
 6259 2C5B ~                DEC  B
