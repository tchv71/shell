 1428 2766              ; ---------------------------------------------------------------------------
 1429 2766              ; binary32: float arithmetic, comparison and conversions to and from long.
 1430 2766              ;
 1431 2766              ; The compiler calls these for every float operation: a float is its bits, an operand like a
 1432 2766              ; long -- a in HL (low word) and DE (high word), b in BC (low) and on the stack above the return
 1433 2766              ; address (high), left there for the caller to take off -- and the result in HL:DE, a comparison's
 1434 2766              ; in A. The algorithms are those of the compiler's C reference implementation of IEEE 754, and the
 1435 2766              ; results agree with it bit for bit: one rounding, to the nearest with ties to even; subnormals;
 1436 2766              ; infinities; and NaNs that come back quieted, the first operand's when both are, as on the
 1437 2766              ; x86.
 1438 2766              ;
 1439 2766              ; A finite number in the middle of an operation is a sign (in fps), an exponent in BC and a
 1440 2766              ; significand of thirty-two bits in DEHL, D the top byte, its leading one at bit 31: twenty-four
 1441 2766              ; bits of the result and eight below them, which decide the rounding -- the round bit is bit 7,
 1442 2766              ; and whatever was shifted out below bit 0 is kept as a one in bit 0, the sticky bit. Its value is
 1443 2766              ; DEHL / 2^31 * 2^(BC - 127), so BC is the biased exponent the result has before rounding.
 1444 2766              ; __x80_fp_rpack makes the float of that. The operands wait in fpa and fpb, the bytes as in
 1445 2766              ; memory, low first.
 1446 2766              ;
 1447 2766              ; Not reentrant: an interrupt handler doing float arithmetic while the main program is inside one
 1448 2766              ; of these would corrupt it, as with the division of longs.
 1449 2766              ; ---------------------------------------------------------------------------
 1450 2766
 1451 2766                  IFUSED __x80_fsub
 1452 2766 ~            __x80_fsub:
 1453 2766 ~                LD   A,80H              ; b's sign flipped: the addition, which follows its first byte
 1454 2766 ~                JP   __x80_fadd+1
 1455 2766                  ENDIF
 1456 2766
 1457 2766                  IFUSED __x80_fadd
 1458 2766 ~            ; ---------------------------------------------------------------------------
 1459 2766 ~            ; DE:HL = a + b. With |a| >= |b| -- swapped if not -- the result has a's sign, and b's
 1460 2766 ~            ; significand, shifted down to a's exponent, is added to a's or taken from it. A subnormal is
 1461 2766 ~            ; taken as exponent 1 without the leading one, and comes the same way; a NaN, an infinity and a
 1462 2766 ~            ; zero b are dealt with before.
 1463 2766 ~            ; ---------------------------------------------------------------------------
 1464 2766 ~            __x80_fadd:
 1465 2766 ~                XOR  A                  ; one byte: __x80_fsub comes in after it
 1466 2766 ~                LD   (__x80_fpx),A      ; what b's sign is flipped by
