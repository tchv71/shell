 5966 2904 ~            ; ---------------------------------------------------------------------------
 5967 2904 ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2904 ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2904 ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2904 ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2904 ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2904 ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2904 ~            ; Vector, which rounds every instruction up to four.
 5974 2904 ~            ;
 5975 2904 ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2904 ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2904 ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2904 ~            ; here is the per-bit cost, not the call overhead.
 5979 2904 ~            ; ---------------------------------------------------------------------------
 5980 2904 ~            __x80_shl16:
 5981 2904 ~                XOR  A
 5982 2904 ~                OR   E
 5983 2904 ~                RET  Z
 5984 2904 ~                CP   8
 5985 2904 ~                JP   NC,.bytes
 5986 2904 ~            .loop:
 5987 2904 ~                ADD  HL,HL
 5988 2904 ~                DEC  A
 5989 2904 ~                JP   NZ,.loop
 5990 2904 ~                RET
 5991 2904 ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2904 ~            .bytes:
 5993 2904 ~                LD   H,L
 5994 2904 ~                LD   L,0
 5995 2904 ~                SUB  8
 5996 2904 ~                RET  Z
 5997 2904 ~                CP   8
 5998 2904 ~                JP   NC,.zero
 5999 2904 ~                LD   B,A
 6000 2904 ~                LD   A,H
 6001 2904 ~            .byte:
 6002 2904 ~                ADD  A,A
 6003 2904 ~                DEC  B
 6004 2904 ~                JP   NZ,.byte
 6005 2904 ~                LD   H,A
 6006 2904 ~                RET
 6007 2904 ~            .zero:
 6008 2904 ~                LD   H,L
 6009 2904 ~                RET
 6010 2904                  ENDIF
