 2508 2766 ~                DEC  HL
 2509 2766 ~                LD   A,E
 2510 2766 ~                CP   (HL)
 2511 2766 ~                JP   NZ,.fast_high
 2512 2766 ~                POP  HL
 2513 2766 ~                LD   A,H
 2514 2766 ~                CP   B
 2515 2766 ~                JP   NZ,.fast_differ
 2516 2766 ~                LD   A,L
 2517 2766 ~                CP   C
 2518 2766 ~                JP   NZ,.fast_differ
 2519 2766 ~                XOR  A
 2520 2766 ~                RET
 2521 2766 ~            .fast_high:
 2522 2766 ~                POP  HL
 2523 2766 ~            .fast_differ:               ; the carry: a's bits below b's, so a < b if they are positive
 2524 2766 ~                SBC  A,A
 2525 2766 ~                XOR  D
 2526 2766 ~                ADD  A,A
 2527 2766 ~                LD   A,1
 2528 2766 ~                RET  C
 2529 2766 ~                INC  A
 2530 2766 ~                RET
