 6214 2896 ~                JP   NC,__x80_mcpys
 6215 2896 ~                JP   .near
 6216 2896 ~            .up:
 6217 2896 ~                LD   A,E                ; s - d
 6218 2896 ~                SUB  L
 6219 2896 ~                LD   A,D
 6220 2896 ~                SBC  A,H
 6221 2896 ~                JP   NZ,.up_far
 6222 2896 ~                LD   A,E
 6223 2896 ~                SUB  L
 6224 2896 ~                CP   X80_SP_RESERVE
 6225 2896 ~                JP   C,__x80_mcpyn_pairs
