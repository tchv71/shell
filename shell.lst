 5651 2C2B ~                ADD  HL,BC
 5652 2C2B ~                JP   C,.s3
 5653 2C2B ~            .a3:
 5654 2C2B ~                ADC  A,A
 5655 2C2B ~                ADD  HL,HL
 5656 2C2B ~                ADD  HL,BC
 5657 2C2B ~                JP   C,.s2
 5658 2C2B ~            .a2:
