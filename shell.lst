 4980 285A                  IFUSED __x80_mulw
 4981 285A ~
 4982 285A ~            ; ---------------------------------------------------------------------------
 4983 285A ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 285A ~            ;
 4985 285A ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 285A ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 285A ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 285A ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 285A ~            ; product, some 300 T-states.
 4990 285A ~            ; ---------------------------------------------------------------------------
 4991 285A ~            __x80_mulw:
 4992 285A ~                XOR  A
 4993 285A ~                OR   D
 4994 285A ~                JP   NZ,.full
 4995 285A ~                LD   A,E
 4996 285A ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 285A ~                LD   E,A                ; D is zero still
 4998 285A ~                RET
 4999 285A ~            .full:
 5000 285A ~                LD   A,E
 5001 285A ~                LD   E,D                ; the high byte waits in E,
 5002 285A ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 285A ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 285A ~                PUSH HL                 ; the low product's low word
 5005 285A ~                LD   L,A
 5006 285A ~                LD   A,E
 5007 285A ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 285A ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 285A ~                LD   D,A
 5010 285A ~                LD   A,L
 5011 285A ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 285A ~                ADD  A,H
 5013 285A ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 285A ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 285A ~                LD   A,E
 5016 285A ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 285A ~                LD   E,A
 5018 285A ~                LD   A,D
 5019 285A ~                ADC  A,0                ; the fourth
 5020 285A ~                LD   D,A
 5021 285A ~                POP  HL
 5022 285A ~                RET
 5023 285A                  ENDIF
