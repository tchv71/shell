 1928 2AFB ~                LD   C,A                ; a's exponent field
 1929 2AFB ~                INC  A
 1930 2AFB ~                CP   2
 1931 2AFB ~                JP   C,.slow            ; 0 or 255
 1932 2AFB ~                LD   A,L
 1933 2AFB ~                ADD  A,A
 1934 2AFB ~                LD   A,H
 1935 2AFB ~                ADC  A,A
