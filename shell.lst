  969 2AFB ~                OR   A
  970 2AFB ~                RET  NZ
  971 2AFB ~                INC  L
  972 2AFB ~                LD   A,C
  973 2AFB ~                AND  7FH
  974 2AFB ~                LD   (__x80_qa+7),A
  975 2AFB ~                RET
  976 2AFB                  ENDIF
