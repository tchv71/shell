 3519 2AFB              ; ---------------------------------------------------------------------------
 3520 2AFB              ; Sixty-four bits: [HL] = [HL] op [DE], or [HL] shifted by the count in DE.
 3521 2AFB              ;
 3522 2AFB              ; The operands are eight bytes each, which no set of registers on this machine can hold, so these
 3523 2AFB              ; take them by address -- the legaliser writes them into the caller's frame -- and work on copies
 3524 2AFB              ; in static memory, a byte at a time. Simple and slow: the point for now is that long long works.
 3525 2AFB              ; Multiplication is shift-and-add over sixty-four bits, division a restoring loop, sixty-four
 3526 2AFB              ; times.
 3527 2AFB              ; ---------------------------------------------------------------------------
 3528 2AFB                  IFUSED __x80_qmul
 3529 2AFB ~            __x80_qmul:
 3530 2AFB ~                CALL __x80_q_take2
 3531 2AFB ~                LD   HL,__x80_qr
 3532 2AFB ~                CALL __x80_q_zero
 3533 2AFB ~                LD   A,64
 3534 2AFB ~                LD   (__x80_qn),A
 3535 2AFB ~            .loop:
 3536 2AFB ~                LD   HL,__x80_qb+7      ; the multiplier's low bit out
 3537 2AFB ~                CALL __x80_q_shr
 3538 2AFB ~                JP   NC,.skip
 3539 2AFB ~                LD   HL,__x80_qr        ; and the multiplicand added where it was set
 3540 2AFB ~                LD   DE,__x80_qa
 3541 2AFB ~                CALL __x80_q_add
 3542 2AFB ~            .skip:
 3543 2AFB ~                LD   HL,__x80_qa
 3544 2AFB ~                CALL __x80_q_shl
 3545 2AFB ~                LD   A,(__x80_qn)
 3546 2AFB ~                DEC  A
 3547 2AFB ~                LD   (__x80_qn),A
 3548 2AFB ~                JP   NZ,.loop
 3549 2AFB ~                LD   HL,__x80_qr
 3550 2AFB ~                JP   __x80_q_give
 3551 2AFB                  ENDIF
 3552 2AFB
 3553 2AFB                  IFUSED __x80_qudiv
 3554 2AFB ~            __x80_qudiv:
 3555 2AFB ~                CALL __x80_q_take2
 3556 2AFB ~                CALL __x80_q_divide
 3557 2AFB ~                LD   HL,__x80_qa
 3558 2AFB ~                JP   __x80_q_give
 3559 2AFB                  ENDIF
 3560 2AFB
 3561 2AFB                  IFUSED __x80_qurem
 3562 2AFB ~            __x80_qurem:
 3563 2AFB ~                CALL __x80_q_take2
 3564 2AFB ~                CALL __x80_q_divide
 3565 2AFB ~                LD   HL,__x80_qr
