 4122 2766 ~            ; ---------------------------------------------------------------------------
 4123 2766 ~            ; DE:HL shifted right by C, 1 to 31, with B -- 00h or the sign's FFh -- coming in at the top: both
 4124 2766 ~            ; right shifts of a long. Eight places at a time by moving the bytes, B the new top one, worked out
 4125 2766 ~            ; once rather than at each byte. What is left, 1 to 7 places: 1 to 3 a bit a step, the top bit
 4126 2766 ~            ; from B's; 4 to 7 as 8 - n steps to the left with B as a fifth byte above D, and the bytes moved
 4127 2766 ~            ; down by one -- 67 T-states a step against 107 to the right (ivagor's way for a word,
 4128 2766 ~            ; zx-pk.ru #77, and his two ways in for the sign, #92: here one way in, the sign held in B).
 4129 2766 ~            ; ---------------------------------------------------------------------------
 4130 2766 ~            __x80_shr32:
 4131 2766 ~            .bytes:
 4132 2766 ~                LD   A,C
 4133 2766 ~                SUB  8
 4134 2766 ~                JP   C,.bits
 4135 2766 ~                LD   C,A
 4136 2766 ~            .move:
 4137 2766 ~                LD   L,H
 4138 2766 ~                LD   H,E
 4139 2766 ~                LD   E,D
 4140 2766 ~                LD   D,B
 4141 2766 ~                JP   NZ,.bytes          ; the flags of the SUB, or of .left's last DEC C
 4142 2766 ~                RET
 4143 2766 ~            .bits:
 4144 2766 ~                CP   0FCh               ; A is the count less 8: 4 to 7 places are FCh to FFh
 4145 2766 ~                JP   NC,.left
 4146 2766 ~            .right:
 4147 2766 ~                LD   A,B
 4148 2766 ~                RLA                     ; B's bit into the carry, to come in at the top
 4149 2766 ~                LD   A,D
 4150 2766 ~                RRA
 4151 2766 ~                LD   D,A
 4152 2766 ~                CALL __x80_rr3
 4153 2766 ~                DEC  C
 4154 2766 ~                JP   NZ,.right
 4155 2766 ~                RET
 4156 2766 ~            .left:
 4157 2766 ~                LD   A,8
 4158 2766 ~                SUB  C
 4159 2766 ~                LD   C,A                ; 1 to 4 steps
 4160 2766 ~            .left_loop:
 4161 2766 ~                ADD  HL,HL
 4162 2766 ~                LD   A,E
 4163 2766 ~                RLA
 4164 2766 ~                LD   E,A
 4165 2766 ~                LD   A,D
 4166 2766 ~                RLA
 4167 2766 ~                LD   D,A
 4168 2766 ~                LD   A,B
 4169 2766 ~                RLA
 4170 2766 ~                LD   B,A
 4171 2766 ~                DEC  C
 4172 2766 ~                JP   NZ,.left_loop
 4173 2766 ~                JP   .move              ; Z: the bytes down by one, and back
 4174 2766                  ENDIF
