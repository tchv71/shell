 4005 27D4 ~                LD   A,D
 4006 27D4 ~                SBC  A,B
 4007 27D4 ~                JP   C,.low
 4008 27D4 ~                LD   H,B
 4009 27D4 ~                LD   L,C
 4010 27D4 ~                LD   B,D
 4011 27D4 ~                LD   C,E
 4012 27D4 ~                EX   DE,HL
