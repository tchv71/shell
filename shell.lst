 5926 2C5B ~                ADD  A,A
 5927 2C5B ~                DEC  E
 5928 2C5B ~                JP   NZ,.loop
 5929 2C5B ~                LD   L,A
 5930 2C5B ~                RET
 5931 2C5B                  ENDIF
