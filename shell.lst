 1954 2AFB ~                LD   B,A
 1955 2AFB ~                JP   .normal
 1956 2AFB ~            .slow:
 1957 2AFB ~                LD   (__x80_fpb+2),HL   ; as __x80_fp_load2 leaves them
 1958 2AFB ~                EX   DE,HL
 1959 2AFB ~                LD   (__x80_fpa+2),HL
