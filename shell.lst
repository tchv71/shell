 6163 2896 ~                DEC  BC
 6164 2896 ~                LD   A,B
 6165 2896 ~                OR   C
 6166 2896 ~                JP   NZ,__x80_memcpy_loop
 6167 2896 ~                RET
 6168 2896                  ENDIF
 6169 2896
 6170 2896              ; ---------------------------------------------------------------------------
 6171 2896              ; memcpy, memset and memmove of a length the program has only when it runs
 6172 2896              ; (lib/libc/string.c): HL = destination, DE = source (E the byte for memset),
 6173 2896              ; BC = the length; HL comes back as it went in, and A, BC, DE and the flags are
 6174 2896              ; written. Two bytes a trip, as __x80_mcpyp_even below (SIA, zx-pk.ru), the
 6175 2896              ; trips worked out here: one less than them is (n - 1) / 2 for an odd n and an
 6176 2896              ; even one alike, and the bit shifted out says which -- an odd n goes in at the
 6177 2896              ; second byte of the first pair. That halved, C its low byte and B its high one
 6178 2896              ; and each one more is what DEC C / JP NZ inside DEC B / JP NZ counts down. 0 is
 6179 2896              ; nothing at all, 65535 32768 trips. 31.5 T-states a byte for a copy and 19.5
 6180 2896              ; for a fill, against 39 and 27 for the loops in C they replace. -Os: a byte a
 6181 2896              ; trip, the length as the two counters straight away -- as fast as those loops
 6182 2896              ; were, and some ten bytes shorter each.
 6183 2896              ; ---------------------------------------------------------------------------
 6184 2896              ; memmove: forwards by __x80_mcpyn when the destination is below the source,
 6185 2896              ; else from the last byte down. Ahead of __x80_mcpyn, so that its IFUSED has seen
 6186 2896              ; the jump to it.
 6187 2896              ;
 6188 2896              ; -mstack-copy: a long one through SP too, when the two are far enough apart that
 6189 2896              ; what an interrupt pushes cannot reach a byte still wanted (SIA, zx-pk.ru). Above
 6190 2896              ; the source by X80_SP_RESERVE + 16 or more, from the end down as memcpy goes,
 6191 2896              ; __x80_mcpys: an interrupt writes into the destination below SP, not yet written
 6192 2896              ; and above every byte of the source still to be read; and the first bytes, which
 6193 2896              ; it copies upwards at the end, are below what the source gave for the rest. Below
 6194 2896              ; it by X80_SP_RESERVE or more, upwards by __x80_mmoves, below.
 6195 2896                  IFUSED __x80_mmoven
 6196 2896 ~            __x80_mmoven:
 6197 2896 ~                LD   A,L
 6198 2896 ~                SUB  E
 6199 2896 ~                LD   A,H
 6200 2896 ~                SBC  A,D
 6201 2896 ~                IFDEF X80_STACK_COPY
 6202 2896 ~                JP   C,.up
 6203 2896 ~                JP   NZ,.far            ; the high byte of d - s
 6204 2896 ~                LD   A,L
 6205 2896 ~                SUB  E
 6206 2896 ~                CP   X80_SP_RESERVE + 16
 6207 2896 ~                JP   C,.near
 6208 2896 ~            .far:
