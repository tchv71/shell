 4981 2BEF ~
 4982 2BEF ~            ; ---------------------------------------------------------------------------
 4983 2BEF ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 2BEF ~            ;
 4985 2BEF ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 2BEF ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 2BEF ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 2BEF ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 2BEF ~            ; product, some 300 T-states.
 4990 2BEF ~            ; ---------------------------------------------------------------------------
 4991 2BEF ~            __x80_mulw:
 4992 2BEF ~                XOR  A
 4993 2BEF ~                OR   D
 4994 2BEF ~                JP   NZ,.full
 4995 2BEF ~                LD   A,E
 4996 2BEF ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 2BEF ~                LD   E,A                ; D is zero still
 4998 2BEF ~                RET
 4999 2BEF ~            .full:
 5000 2BEF ~                LD   A,E
 5001 2BEF ~                LD   E,D                ; the high byte waits in E,
 5002 2BEF ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 2BEF ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 2BEF ~                PUSH HL                 ; the low product's low word
 5005 2BEF ~                LD   L,A
 5006 2BEF ~                LD   A,E
 5007 2BEF ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 2BEF ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 2BEF ~                LD   D,A
 5010 2BEF ~                LD   A,L
 5011 2BEF ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 2BEF ~                ADD  A,H
 5013 2BEF ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 2BEF ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 2BEF ~                LD   A,E
 5016 2BEF ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 2BEF ~                LD   E,A
 5018 2BEF ~                LD   A,D
 5019 2BEF ~                ADC  A,0                ; the fourth
 5020 2BEF ~                LD   D,A
 5021 2BEF ~                POP  HL
 5022 2BEF ~                RET
 5023 2BEF                  ENDIF
