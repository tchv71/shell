 2707 2766                  IFUSED __x80_fp_fast2
 2708 2766 ~            ; ---------------------------------------------------------------------------
 2709 2766 ~            ; A product's or a quotient's operands, when both are normal numbers -- the common case, for
 2710 2766 ~            ; which the general path's tests for NaNs, infinities, zeros and subnormals and its normalisation
 2711 2766 ~            ; are all for nothing. Carry set if fpa or fpb is not one (an exponent field of 0 or 255), and
 2712 2766 ~            ; then nothing is changed but fps, which the general path sets again. Otherwise, as that path
 2713 2766 ~            ; would leave them: fps = the result's sign; the leading ones put into the significands, the low
 2714 2766 ~            ; three bytes of fpa and fpb (__x80_fp_unpack); HL = a's exponent, BC = b's; D = b's top byte.
 2715 2766 ~            ; ---------------------------------------------------------------------------
 2716 2766 ~            __x80_fp_fast2:
 2717 2766 ~                LD   HL,__x80_fpb+3
 2718 2766 ~                LD   E,(HL)             ; b's sign and exponent but its last bit
 2719 2766 ~                DEC  HL
 2720 2766 ~                LD   D,(HL)             ; that bit and the significand's top seven
 2721 2766 ~                LD   A,D
 2722 2766 ~                RLA
 2723 2766 ~                LD   A,E
 2724 2766 ~                RLA                     ; b's exponent
 2725 2766 ~                INC  A
 2726 2766 ~                CP   2                  ; 0 or 255: the carry
 2727 2766 ~                RET  C
 2728 2766 ~                DEC  A
 2729 2766 ~                LD   C,A
 2730 2766 ~                LD   HL,__x80_fpa+3
 2731 2766 ~                LD   A,(HL)
 2732 2766 ~                XOR  E
 2733 2766 ~                AND  80H
 2734 2766 ~                LD   (__x80_fps),A      ; the signs'
 2735 2766 ~                LD   E,(HL)
 2736 2766 ~                DEC  HL
 2737 2766 ~                LD   A,(HL)
 2738 2766 ~                RLA
 2739 2766 ~                LD   A,E
 2740 2766 ~                RLA                     ; a's exponent
 2741 2766 ~                INC  A
 2742 2766 ~                CP   2
 2743 2766 ~                RET  C
 2744 2766 ~                DEC  A
 2745 2766 ~                LD   E,A
 2746 2766 ~                LD   A,(HL)
 2747 2766 ~                OR   80H
 2748 2766 ~                LD   (HL),A             ; a's leading one
 2749 2766 ~                LD   A,D
 2750 2766 ~                OR   80H
 2751 2766 ~                LD   D,A
 2752 2766 ~                LD   (__x80_fpb+2),A    ; b's
 2753 2766 ~                LD   L,E
 2754 2766 ~                XOR  A                  ; and the carry clear
 2755 2766 ~                LD   H,A
 2756 2766 ~                LD   B,A
 2757 2766 ~                RET
 2758 2766                  ENDIF
