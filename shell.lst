 4376 284D              .s_loop:
 4377 284D F5               PUSH AF
 4378 284E 3A 34 29         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 2851 87               ADD  A,A
 4380 2852 32 34 29         LD   (__x80_rt_a),A
 4381 2855 3A 35 29         LD   A,(__x80_rt_a+1)
 4382 2858 17               RLA
 4383 2859 32 35 29         LD   (__x80_rt_a+1),A
 4384 285C 3A 36 29         LD   A,(__x80_rt_a+2)
 4385 285F 17               RLA
 4386 2860 32 36 29         LD   (__x80_rt_a+2),A
 4387 2863 3A 37 29         LD   A,(__x80_rt_a+3)
 4388 2866 17               RLA
 4389 2867 32 37 29         LD   (__x80_rt_a+3),A
 4390 286A 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 286B 17               RLA
 4392 286C 6F               LD   L,A
 4393 286D 7C               LD   A,H
 4394 286E 17               RLA
 4395 286F 67               LD   H,A
 4396 2870 7B               LD   A,E
 4397 2871 17               RLA
 4398 2872 5F               LD   E,A
 4399 2873 7A               LD   A,D
 4400 2874 17               RLA
 4401 2875 57               LD   D,A
 4402 2876 01 2C 29         LD   BC,__x80_rt_r
 4403 2879 DA 8E 28         JP   C,.s_take          ; above the divisor whatever the rest
 4404 287C 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 287D 0A               LD   A,(BC)
 4406 287E 8D               ADC  A,L
 4407 287F 03               INC  BC
 4408 2880 0A               LD   A,(BC)
 4409 2881 8C               ADC  A,H
 4410 2882 03               INC  BC
 4411 2883 0A               LD   A,(BC)
 4412 2884 8B               ADC  A,E
 4413 2885 03               INC  BC
 4414 2886 0A               LD   A,(BC)
 4415 2887 8A               ADC  A,D
 4416 2888 D2 A5 28         JP   NC,.s_next
 4417 288B 01 2C 29         LD   BC,__x80_rt_r
 4418 288E              .s_take:
 4419 288E 37               SCF                     ; d taken off, and a 1
 4420 288F 0A               LD   A,(BC)
 4421 2890 8D               ADC  A,L
 4422 2891 6F               LD   L,A
 4423 2892 03               INC  BC
 4424 2893 0A               LD   A,(BC)
 4425 2894 8C               ADC  A,H
 4426 2895 67               LD   H,A
 4427 2896 03               INC  BC
 4428 2897 0A               LD   A,(BC)
 4429 2898 8B               ADC  A,E
 4430 2899 5F               LD   E,A
 4431 289A 03               INC  BC
 4432 289B 0A               LD   A,(BC)
 4433 289C 8A               ADC  A,D
 4434 289D 57               LD   D,A
 4435 289E 3A 34 29         LD   A,(__x80_rt_a)
 4436 28A1 3C               INC  A
 4437 28A2 32 34 29         LD   (__x80_rt_a),A
 4438 28A5              .s_next:
 4439 28A5 F1               POP  AF
 4440 28A6 3D               DEC  A
 4441 28A7 C2 4D 28         JP   NZ,.s_loop
 4442 28AA              .s_done:
 4443 28AA 22 2C 29         LD   (__x80_rt_r),HL
 4444 28AD EB               EX   DE,HL
 4445 28AE 22 2E 29         LD   (__x80_rt_r+2),HL
