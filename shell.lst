 1108 2AFB                  IFUSED __x80_d_split
 1109 2AFB ~            ; ---------------------------------------------------------------------------
 1110 2AFB ~            ; The double at HL, finite: its significand in its place, the leading one at bit 63 (none for a
 1111 2AFB ~            ; subnormal); its exponent in DE, 1 for a subnormal. HL is kept.
 1112 2AFB ~            ; ---------------------------------------------------------------------------
 1113 2AFB ~            __x80_d_split:
 1114 2AFB ~                PUSH HL
 1115 2AFB ~                LD   DE,6
 1116 2AFB ~                ADD  HL,DE
 1117 2AFB ~                LD   C,(HL)             ; x6
 1118 2AFB ~                INC  HL
 1119 2AFB ~                LD   A,(HL)             ; x7
 1120 2AFB ~                AND  7FH
 1121 2AFB ~                LD   B,A
 1122 2AFB ~                RRCA
 1123 2AFB ~                RRCA
 1124 2AFB ~                RRCA
 1125 2AFB ~                RRCA
 1126 2AFB ~                AND  07H
 1127 2AFB ~                LD   D,A                ; the exponent's top three bits
 1128 2AFB ~                LD   A,B
 1129 2AFB ~                RLCA
 1130 2AFB ~                RLCA
 1131 2AFB ~                RLCA
 1132 2AFB ~                RLCA
 1133 2AFB ~                AND  0F0H
 1134 2AFB ~                LD   E,A
 1135 2AFB ~                LD   A,C
 1136 2AFB ~                RRCA
 1137 2AFB ~                RRCA
 1138 2AFB ~                RRCA
 1139 2AFB ~                RRCA
 1140 2AFB ~                AND  0FH
 1141 2AFB ~                OR   E
 1142 2AFB ~                LD   E,A                ; and the other eight
 1143 2AFB ~                OR   D
 1144 2AFB ~                JP   Z,.sub
 1145 2AFB ~                LD   A,C
 1146 2AFB ~                AND  0FH
 1147 2AFB ~                OR   10H                ; the leading one
 1148 2AFB ~                JP   .top
 1149 2AFB ~            .sub:
 1150 2AFB ~                INC  E                  ; a subnormal: exponent 1, no leading one
 1151 2AFB ~                LD   A,C
 1152 2AFB ~                AND  0FH
 1153 2AFB ~            .top:
 1154 2AFB ~                LD   (HL),A             ; the fraction's top four bits, a byte up
 1155 2AFB ~                LD   B,6
 1156 2AFB ~            .up:
 1157 2AFB ~                DEC  HL
 1158 2AFB ~                DEC  HL
 1159 2AFB ~                LD   A,(HL)
 1160 2AFB ~                INC  HL
 1161 2AFB ~                LD   (HL),A
 1162 2AFB ~                DEC  B
 1163 2AFB ~                JP   NZ,.up
 1164 2AFB ~                DEC  HL
 1165 2AFB ~                LD   (HL),0
 1166 2AFB ~                LD   C,3                ; and three places further
 1167 2AFB ~            .shl:
 1168 2AFB ~                POP  HL
 1169 2AFB ~                PUSH HL
 1170 2AFB ~                CALL __x80_q_shl
 1171 2AFB ~                DEC  C
 1172 2AFB ~                JP   NZ,.shl
 1173 2AFB ~                POP  HL
 1174 2AFB ~                RET
 1175 2AFB                  ENDIF
 1176 2AFB
 1177 2AFB                  IFUSED __x80_d_rpack
 1178 2AFB ~            ; ---------------------------------------------------------------------------
 1179 2AFB ~            ; [qpa] = the double of dsg, DE and qa (not zero): normalised, rounded to nearest, ties to even,
 1180 2AFB ~            ; packed -- infinite if too large, subnormal or zero if too small. As __x80_fp_rpack, the packing
 1181 2AFB ~            ; adds the significand, its leading one included, to the exponent less one shifted into place.
 1182 2AFB ~            ; ---------------------------------------------------------------------------
 1183 2AFB ~            __x80_d_rpack:
 1184 2AFB ~                LD   HL,__x80_qa
 1185 2AFB ~                CALL __x80_d_norm
 1186 2AFB ~                XOR  A
 1187 2AFB ~                OR   D
 1188 2AFB ~                JP   M,.tiny
 1189 2AFB ~                LD   A,E
 1190 2AFB ~                SUB  0FFH
 1191 2AFB ~                LD   A,D
 1192 2AFB ~                SBC  A,07H
 1193 2AFB ~                JP   NC,__x80_d_inf     ; 7FFh or more
 1194 2AFB ~                LD   A,D
 1195 2AFB ~                OR   E
 1196 2AFB ~                JP   Z,.tiny
 1197 2AFB ~                DEC  DE
 1198 2AFB ~                JP   .round
 1199 2AFB ~            .tiny:
 1200 2AFB ~                ; below the normal range: 1 - DE places down, the exponent field 0
 1201 2AFB ~                LD   A,1
 1202 2AFB ~                SUB  E
 1203 2AFB ~                LD   C,A
 1204 2AFB ~                LD   A,0
 1205 2AFB ~                SBC  A,D
 1206 2AFB ~                JP   NZ,__x80_d_zero
 1207 2AFB ~                LD   A,C
 1208 2AFB ~                CP   64
 1209 2AFB ~                JP   NC,__x80_d_zero
 1210 2AFB ~                LD   HL,__x80_qa
 1211 2AFB ~                CALL __x80_d_shrj
 1212 2AFB ~                LD   DE,0
 1213 2AFB ~            .round:
 1214 2AFB ~                PUSH DE
 1215 2AFB ~                LD   HL,__x80_qa        ; the round bit down to bit 7
 1216 2AFB ~                LD   A,3
 1217 2AFB ~                CALL __x80_d_shrj
 1218 2AFB ~                LD   A,(__x80_qa)
 1219 2AFB ~                CP   80H
 1220 2AFB ~                JP   C,.pack            ; below half way
 1221 2AFB ~                JP   NZ,.up             ; above
 1222 2AFB ~                LD   A,(__x80_qa+1)     ; half way: to even
 1223 2AFB ~                RRA
 1224 2AFB ~                JP   NC,.pack
 1225 2AFB ~            .up:
 1226 2AFB ~                LD   HL,__x80_qa+1
 1227 2AFB ~                LD   B,7
 1228 2AFB ~            .inc:
 1229 2AFB ~                INC  (HL)
 1230 2AFB ~                JP   NZ,.pack
 1231 2AFB ~                INC  HL
 1232 2AFB ~                DEC  B
 1233 2AFB ~                JP   NZ,.inc
 1234 2AFB ~            .pack:
 1235 2AFB ~                LD   HL,__x80_qa        ; the round byte out
 1236 2AFB ~                LD   A,8
 1237 2AFB ~                CALL __x80_d_shr
 1238 2AFB ~                POP  DE                 ; the exponent less one, at most 7FEh
 1239 2AFB ~                LD   A,E
 1240 2AFB ~                RRCA
 1241 2AFB ~                RRCA
 1242 2AFB ~                RRCA
 1243 2AFB ~                RRCA
 1244 2AFB ~                AND  0FH
 1245 2AFB ~                LD   C,A
 1246 2AFB ~                LD   A,D
 1247 2AFB ~                RLCA
 1248 2AFB ~                RLCA
 1249 2AFB ~                RLCA
 1250 2AFB ~                RLCA
 1251 2AFB ~                OR   C
 1252 2AFB ~                LD   C,A                ; its top seven bits
 1253 2AFB ~                LD   A,E
 1254 2AFB ~                ADD  A,A
 1255 2AFB ~                ADD  A,A
 1256 2AFB ~                ADD  A,A
 1257 2AFB ~                ADD  A,A                ; its low four, at the top of the byte
 1258 2AFB ~                LD   HL,__x80_qa+6
 1259 2AFB ~                ADD  A,(HL)
 1260 2AFB ~                LD   (HL),A
 1261 2AFB ~                INC  HL
 1262 2AFB ~                LD   A,C
 1263 2AFB ~                ADC  A,0
 1264 2AFB ~                LD   C,A
 1265 2AFB ~                LD   A,(__x80_dsg)
 1266 2AFB ~                OR   C
 1267 2AFB ~                LD   (HL),A
 1268 2AFB ~                LD   HL,__x80_qa
 1269 2AFB ~                JP   __x80_q_give
 1270 2AFB ~            __x80_d_zero:
 1271 2AFB ~                LD   HL,__x80_qa
 1272 2AFB ~                CALL __x80_q_zero
 1273 2AFB ~                LD   A,(__x80_dsg)
 1274 2AFB ~                LD   (__x80_qa+7),A
 1275 2AFB ~                JP   __x80_d_dnan.give
 1276 2AFB ~            __x80_d_inf:
 1277 2AFB ~                LD   HL,__x80_qa
 1278 2AFB ~                CALL __x80_q_zero
 1279 2AFB ~                LD   A,0F0H
