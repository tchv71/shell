 4082 2766 ~                LD   A,E
 4083 2766 ~                RLA
 4084 2766 ~                LD   E,A
 4085 2766 ~                LD   A,D
 4086 2766 ~                RLA
 4087 2766 ~                LD   D,A
 4088 2766 ~                DEC  C
 4089 2766 ~                JP   NZ,.loop
 4090 2766 ~                RET
