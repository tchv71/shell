 2479 2766                  IFUSED __x80_fcmp
 2480 2766 ~            ; ---------------------------------------------------------------------------
 2481 2766 ~            ; A = 0 if a = b, 1 if a < b, 2 if a > b, 3 if either is a NaN. Two zeros are equal whatever
 2482 2766 ~            ; their signs; otherwise floats of one sign are ordered as their bits are, upside down for
 2483 2766 ~            ; negative ones.
 2484 2766 ~            ;
 2485 2766 ~            ; Straight from the registers and the stack while neither exponent's top seven bits are all
 2486 2766 ~            ; ones, so neither can be a NaN; else the full path through fpa and fpb. -Os has the full path
 2487 2766 ~            ; alone, some 70 bytes less.
 2488 2766 ~            ; ---------------------------------------------------------------------------
 2489 2766 ~            __x80_fcmp:
 2490 2766 ~                IFNDEF X80_OPT_SIZE
 2491 2766 ~                PUSH HL                 ; a's low word
 2492 2766 ~                LD   HL,5
 2493 2766 ~                ADD  HL,SP              ; b's top byte
 2494 2766 ~                LD   A,(HL)
 2495 2766 ~                ADD  A,A
 2496 2766 ~                CP   0FEH
 2497 2766 ~                JP   NC,.full_pop
 2498 2766 ~                LD   A,D
 2499 2766 ~                ADD  A,A
 2500 2766 ~                CP   0FEH
 2501 2766 ~                JP   NC,.full_pop
 2502 2766 ~                LD   A,D
 2503 2766 ~                XOR  (HL)
