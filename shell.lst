 1122 2766 ~                RRCA
 1123 2766 ~                RRCA
 1124 2766 ~                RRCA
 1125 2766 ~                RRCA
 1126 2766 ~                AND  07H
 1127 2766 ~                LD   D,A                ; the exponent's top three bits
 1128 2766 ~                LD   A,B
 1129 2766 ~                RLCA
 1130 2766 ~                RLCA
 1131 2766 ~                RLCA
 1132 2766 ~                RLCA
 1133 2766 ~                AND  0F0H
 1134 2766 ~                LD   E,A
 1135 2766 ~                LD   A,C
 1136 2766 ~                RRCA
 1137 2766 ~                RRCA
 1138 2766 ~                RRCA
 1139 2766 ~                RRCA
 1140 2766 ~                AND  0FH
