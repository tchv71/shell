 7527 292C
 7528 292C              ; ---------------------------------------------------------------------------
 7529 292C              ; HL = destination: __x80_mzero_N fills N bytes with zero, N from 1 to 32, for
 7530 292C              ; the part of an initialiser that is not written out -- the same as
 7531 292C              ; __x80_mcpy_N above, in a CALL of three bytes where LD BC,N and a CALL of
 7532 292C              ; __x80_memzero were six. Writes A, C and HL; leaves B and DE alone.
 7533 292C              ;
 7534 292C              ; (a) The tail: `LD (HL),0 / INC HL` a step, 15 T-states a byte, 3 * M bytes
 7535 292C              ;     for the largest size M up to 16; the sizes above that by (b).
 7536 292C              ; (b) The loop counting in C, 27 T-states a byte against 39 in __x80_memzero's,
 7537 292C              ;     its entries passing over each other by a byte 3AH as above -- A is made
 7538 292C              ;     zero only after them. 7 + 3 * sizes bytes.
 7539 292C              ; ---------------------------------------------------------------------------
 7540 292C              __x80_mzero_d = 0                   ; the sizes used
 7541 292C              __x80_mzero_db = 0                  ; of them above 16
 7542 292C              __x80_mzero_m = 0                   ; the largest up to 16
 7543 292C              __x80_mzero_lo = 0                  ; the smallest
 7544 292C              __x80_mzero_lb = 0                  ; the smallest above 16
 7545 292C                  IFUSED __x80_mzero_32
 7546 292C ~            __x80_mzero_d = __x80_mzero_d + 1
 7547 292C ~            __x80_mzero_lo = 32
 7548 292C ~            __x80_mzero_db = __x80_mzero_db + 1
 7549 292C ~            __x80_mzero_lb = 32
 7550 292C                  ENDIF
 7551 292C                  IFUSED __x80_mzero_31
 7552 292C ~            __x80_mzero_d = __x80_mzero_d + 1
 7553 292C ~            __x80_mzero_lo = 31
 7554 292C ~            __x80_mzero_db = __x80_mzero_db + 1
 7555 292C ~            __x80_mzero_lb = 31
 7556 292C                  ENDIF
 7557 292C                  IFUSED __x80_mzero_30
 7558 292C ~            __x80_mzero_d = __x80_mzero_d + 1
 7559 292C ~            __x80_mzero_lo = 30
 7560 292C ~            __x80_mzero_db = __x80_mzero_db + 1
 7561 292C ~            __x80_mzero_lb = 30
 7562 292C                  ENDIF
