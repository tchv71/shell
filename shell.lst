 2613 2AFB                  IFUSED __x80_ftoul
 2614 2AFB ~            ; ---------------------------------------------------------------------------
 2615 2AFB ~            ; DE:HL = a converted to unsigned long, truncating. A negative one as to long, as the C
 2616 2AFB ~            ; reference implementation does, and one out of range 0.
 2617 2AFB ~            ; ---------------------------------------------------------------------------
 2618 2AFB ~            __x80_ftoul:
 2619 2AFB ~                XOR  A
 2620 2AFB ~                OR   D
 2621 2AFB ~                JP   M,__x80_ftol
 2622 2AFB ~                LD   A,E
 2623 2AFB ~                RLA
 2624 2AFB ~                LD   A,D
 2625 2AFB ~                RLA
 2626 2AFB ~                SUB  7FH                ; the exponent: below 1, zero
 2627 2AFB ~                JP   C,__x80_zero32
 2628 2AFB ~                CP   32
 2629 2AFB ~                JP   NC,__x80_zero32
 2630 2AFB ~                JP   __x80_fp_trunc
 2631 2AFB                  ENDIF
 2632 2AFB
 2633 2AFB                  IFUSED __x80_ftol
 2634 2AFB ~            ; ---------------------------------------------------------------------------
 2635 2AFB ~            ; DE:HL = a converted to long, truncating; one out of range, infinite or a NaN 80000000H, the
 2636 2AFB ~            ; x86's answer.
 2637 2AFB ~            ; ---------------------------------------------------------------------------
 2638 2AFB ~            __x80_ftol:
 2639 2AFB ~                LD   A,E
 2640 2AFB ~                RLA
 2641 2AFB ~                LD   A,D
 2642 2AFB ~                RLA
 2643 2AFB ~                SUB  7FH
 2644 2AFB ~                JP   C,__x80_zero32
 2645 2AFB ~                CP   31
 2646 2AFB ~                JP   NC,.min
 2647 2AFB ~                LD   B,D                ; the sign
 2648 2AFB ~                PUSH BC
 2649 2AFB ~                CALL __x80_fp_trunc
 2650 2AFB ~                POP  BC
 2651 2AFB ~                XOR  A
 2652 2AFB ~                OR   B
 2653 2AFB ~                RET  P
 2654 2AFB ~                JP   __x80_fp_neg
 2655 2AFB ~            .min:
 2656 2AFB ~                LD   HL,0
 2657 2AFB ~                LD   DE,8000H
 2658 2AFB ~                RET
 2659 2AFB                  ENDIF
