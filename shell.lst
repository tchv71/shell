  939 2AFB ~                LD   A,80H
  940 2AFB ~                LD   (__x80_qa+7),A
  941 2AFB ~                RET
  942 2AFB                  ENDIF
  943 2AFB
  944 2AFB                  IFUSED __x80_d_fl
  945 2AFB ~            ; ---------------------------------------------------------------------------
  946 2AFB ~            ; The float in BC:DE: its sign in dsg, its significand at the top of qa -- the leading one at bit
  947 2AFB ~            ; 63 unless it is a subnormal -- and its exponent in HL, 1 for a subnormal.
  948 2AFB ~            ; ---------------------------------------------------------------------------
