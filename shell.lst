 4258 276F ~                LD   A,(__x80_rt_a+3)   ; the remainder takes the sign of the dividend
 4259 276F ~                CALL __x80_signed_divide
 4260 276F ~                LD   HL,__x80_rt_r
 4261 276F ~                CALL Z,__x80_negate32
 4262 276F ~                JP   __x80_remainder
 4263 276F                  ENDIF
