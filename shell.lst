 6294 2896 ~                IFUSED __x80_mmoves
 6295 2896 ~            ; -mstack-copy, memmove upwards: the destination d below the source s by g = s - d, X80_SP_RESERVE
 6296 2896 ~            ; or more, n at least X80_SP_RESERVE + 32. The first X80_SP_RESERVE to + 15 bytes the ordinary way;
 6297 2896 ~            ; then SP the source's pointer, up from where they ended, HL the destination's, two bytes a POP --
 6298 2896 ~            ; 34 T-states a pair, sixteen bytes a trip -- as far as the destination's end, d + n; then the last
 6299 2896 ~            ; g bytes the ordinary way. Below SP is then always source already read that is destination not
 6300 2896 ~            ; yet written: what an interrupt pushes lands there and is written over. Past d + n the source is
 6301 2896 ~            ; the caller's still, and no interrupt may write it (ivagor, zx-pk.ru): there SP does not go. With
 6302 2896 ~            ; fewer than X80_SP_RESERVE + 32 bytes up to there, all of it the ordinary way; apart, as memcpy.
 6303 2896 ~            __x80_mmoves:
 6304 2896 ~                PUSH HL                 ; d, given back
 6305 2896 ~                ADD  HL,BC
 6306 2896 ~                LD   A,L
 6307 2896 ~                SUB  E
 6308 2896 ~                LD   L,A
 6309 2896 ~                LD   A,H
 6310 2896 ~                SBC  A,D
 6311 2896 ~                LD   H,A                ; d + n - s = n - g, the bytes up to the destination's end
 6312 2896 ~                JP   C,.apart           ; apart: memcpy's way
 6313 2896 ~                JP   NZ,.long
 6314 2896 ~                LD   A,L
 6315 2896 ~                CP   X80_SP_RESERVE + 32
 6316 2896 ~                JP   C,.plain
 6317 2896 ~            .long:
 6318 2896 ~                LD   B,H
 6319 2896 ~                LD   C,L                ; n - g
 6320 2896 ~                POP  HL
 6321 2896 ~                PUSH HL                 ; d
 6322 2896 ~                LD   A,E
 6323 2896 ~                SUB  L
 6324 2896 ~                LD   L,A
 6325 2896 ~                LD   A,D
 6326 2896 ~                SBC  A,H
 6327 2896 ~                LD   H,A                ; g
 6328 2896 ~                EX   (SP),HL            ; g kept, HL = d
 6329 2896 ~                PUSH HL                 ; d on it
 6330 2896 ~                CALL __x80_sp_trips     ; BC the trips, A the first bytes
 6331 2896 ~                PUSH BC
 6332 2896 ~                LD   C,A
 6333 2896 ~                LD   B,0
 6334 2896 ~                PUSH BC
 6335 2896 ~                CALL __x80_mcpyn_pairs  ; the first bytes: HL = d again, DE = s past them
 6336 2896 ~                POP  BC
 6337 2896 ~                ADD  HL,BC              ; the destination past them
 6338 2896 ~                POP  BC
 6339 2896 ~                EX   DE,HL              ; HL the source, DE the destination
 6340 2896 ~                PUSH HL
 6341 2896 ~                LD   HL,2
 6342 2896 ~                ADD  HL,SP
 6343 2896 ~                LD   (__x80_sp_save),HL ; SP with d and g on it
 6344 2896 ~                POP  HL
 6345 2896 ~                LD   SP,HL
 6346 2896 ~                EX   DE,HL
 6347 2896 ~            .up:
 6348 2896 ~                POP  DE
 6349 2896 ~                LD   (HL),E
 6350 2896 ~                INC  HL
 6351 2896 ~                LD   (HL),D
 6352 2896 ~                INC  HL
 6353 2896 ~                POP  DE
 6354 2896 ~                LD   (HL),E
 6355 2896 ~                INC  HL
 6356 2896 ~                LD   (HL),D
 6357 2896 ~                INC  HL
 6358 2896 ~                POP  DE
 6359 2896 ~                LD   (HL),E
 6360 2896 ~                INC  HL
 6361 2896 ~                LD   (HL),D
 6362 2896 ~                INC  HL
 6363 2896 ~                POP  DE
 6364 2896 ~                LD   (HL),E
 6365 2896 ~                INC  HL
 6366 2896 ~                LD   (HL),D
 6367 2896 ~                INC  HL
