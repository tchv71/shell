 4068 2AFB ~                RET  Z
 4069 2AFB ~            .bytes:
 4070 2AFB ~                LD   A,C
 4071 2AFB ~                SUB  8
 4072 2AFB ~                JP   C,.loop
 4073 2AFB ~                LD   C,A
 4074 2AFB ~                LD   D,E
 4075 2AFB ~                LD   E,H
 4076 2AFB ~                LD   H,L
 4077 2AFB ~                LD   L,0
 4078 2AFB ~                JP   NZ,.bytes          ; the flags of the SUB
 4079 2AFB ~                RET
 4080 2AFB ~            .loop:
 4081 2AFB ~                ADD  HL,HL
 4082 2AFB ~                LD   A,E
 4083 2AFB ~                RLA
 4084 2AFB ~                LD   E,A
 4085 2AFB ~                LD   A,D
 4086 2AFB ~                RLA
 4087 2AFB ~                LD   D,A
 4088 2AFB ~                DEC  C
 4089 2AFB ~                JP   NZ,.loop
 4090 2AFB ~                RET
