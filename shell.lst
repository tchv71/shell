 6170 2C5B              ; ---------------------------------------------------------------------------
 6171 2C5B              ; memcpy, memset and memmove of a length the program has only when it runs
 6172 2C5B              ; (lib/libc/string.c): HL = destination, DE = source (E the byte for memset),
 6173 2C5B              ; BC = the length; HL comes back as it went in, and A, BC, DE and the flags are
 6174 2C5B              ; written. Two bytes a trip, as __x80_mcpyp_even below (SIA, zx-pk.ru), the
 6175 2C5B              ; trips worked out here: one less than them is (n - 1) / 2 for an odd n and an
 6176 2C5B              ; even one alike, and the bit shifted out says which -- an odd n goes in at the
 6177 2C5B              ; second byte of the first pair. That halved, C its low byte and B its high one
 6178 2C5B              ; and each one more is what DEC C / JP NZ inside DEC B / JP NZ counts down. 0 is
 6179 2C5B              ; nothing at all, 65535 32768 trips. 31.5 T-states a byte for a copy and 19.5
 6180 2C5B              ; for a fill, against 39 and 27 for the loops in C they replace. -Os: a byte a
 6181 2C5B              ; trip, the length as the two counters straight away -- as fast as those loops
 6182 2C5B              ; were, and some ten bytes shorter each.
 6183 2C5B              ; ---------------------------------------------------------------------------
 6184 2C5B              ; memmove: forwards by __x80_mcpyn when the destination is below the source,
 6185 2C5B              ; else from the last byte down. Ahead of __x80_mcpyn, so that its IFUSED has seen
 6186 2C5B              ; the jump to it.
 6187 2C5B              ;
 6188 2C5B              ; -mstack-copy: a long one through SP too, when the two are far enough apart that
 6189 2C5B              ; what an interrupt pushes cannot reach a byte still wanted (SIA, zx-pk.ru). Above
 6190 2C5B              ; the source by X80_SP_RESERVE + 16 or more, from the end down as memcpy goes,
 6191 2C5B              ; __x80_mcpys: an interrupt writes into the destination below SP, not yet written
 6192 2C5B              ; and above every byte of the source still to be read; and the first bytes, which
 6193 2C5B              ; it copies upwards at the end, are below what the source gave for the rest. Below
 6194 2C5B              ; it by X80_SP_RESERVE or more, upwards by __x80_mmoves, below.
 6195 2C5B                  IFUSED __x80_mmoven
 6196 2C5B ~            __x80_mmoven:
 6197 2C5B ~                LD   A,L
 6198 2C5B ~                SUB  E
 6199 2C5B ~                LD   A,H
 6200 2C5B ~                SBC  A,D
 6201 2C5B ~                IFDEF X80_STACK_COPY
 6202 2C5B ~                JP   C,.up
 6203 2C5B ~                JP   NZ,.far            ; the high byte of d - s
 6204 2C5B ~                LD   A,L
 6205 2C5B ~                SUB  E
 6206 2C5B ~                CP   X80_SP_RESERVE + 16
 6207 2C5B ~                JP   C,.near
 6208 2C5B ~            .far:
 6209 2C5B ~                LD   A,B
 6210 2C5B ~                OR   A
 6211 2C5B ~                JP   NZ,__x80_mcpys
 6212 2C5B ~                LD   A,C
 6213 2C5B ~                CP   X80_SP_RESERVE + 32
 6214 2C5B ~                JP   NC,__x80_mcpys
 6215 2C5B ~                JP   .near
 6216 2C5B ~            .up:
 6217 2C5B ~                LD   A,E                ; s - d
 6218 2C5B ~                SUB  L
 6219 2C5B ~                LD   A,D
 6220 2C5B ~                SBC  A,H
 6221 2C5B ~                JP   NZ,.up_far
 6222 2C5B ~                LD   A,E
 6223 2C5B ~                SUB  L
 6224 2C5B ~                CP   X80_SP_RESERVE
 6225 2C5B ~                JP   C,__x80_mcpyn_pairs
 6226 2C5B ~            .up_far:
 6227 2C5B ~                LD   A,B
 6228 2C5B ~                OR   A
 6229 2C5B ~                JP   NZ,__x80_mmoves
 6230 2C5B ~                LD   A,C
 6231 2C5B ~                CP   X80_SP_RESERVE + 32
 6232 2C5B ~                JP   NC,__x80_mmoves
 6233 2C5B ~                JP   __x80_mcpyn_pairs
 6234 2C5B ~            .near:
 6235 2C5B ~                ELSE
 6236 2C5B ~                JP   C,__x80_mcpyn_pairs ; below: forwards; the same place, down as well as any
 6237 2C5B ~                ENDIF
 6238 2C5B ~                LD   A,B
 6239 2C5B ~                OR   C
 6240 2C5B ~                RET  Z
