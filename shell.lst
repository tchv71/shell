 4074 2766 ~                LD   D,E
 4075 2766 ~                LD   E,H
 4076 2766 ~                LD   H,L
 4077 2766 ~                LD   L,0
 4078 2766 ~                JP   NZ,.bytes          ; the flags of the SUB
