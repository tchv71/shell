 5753 2896                  IFUSED __x80_mul16
 5754 2896 ~            ; ---------------------------------------------------------------------------
 5755 2896 ~            ; HL = HL * DE, sixteen bits, wrapping.
 5756 2896 ~            ;
 5757 2896 ~            ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2896 ~            ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2896 ~            ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2896 ~            ; and ten more for a set one.
 5761 2896 ~            ;
 5762 2896 ~            ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2896 ~            ; an index times the size of an element, a value times a small factor. When it is the
 5764 2896 ~            ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2896 ~            ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2896 ~            ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2896 ~            ;
 5768 2896 ~            ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2896 ~            ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2896 ~            ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2896 ~            ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2896 ~            ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2896 ~            ; keep the eight steps from zero.
 5774 2896 ~            ;
 5775 2896 ~            ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2896 ~            ; additions.
 5777 2896 ~            ; ---------------------------------------------------------------------------
 5778 2896 ~            __x80_mul16:
 5779 2896 ~                XOR  A
 5780 2896 ~                OR   D
 5781 2896 ~                JP   Z,.small       ; the multiplier fits in a byte
 5782 2896 ~                XOR  A
 5783 2896 ~                OR   H
 5784 2896 ~                JP   NZ,.full
 5785 2896 ~                EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2896 ~            .small:
 5787 2896 ~                LD   B,H
 5788 2896 ~                LD   C,L            ; BC = multiplicand
 5789 2896 ~                IFNDEF X80_OPT_SPEED
 5790 2896 ~                LD   HL,0
 5791 2896 ~                LD   A,E
 5792 2896 ~                JP   __x80_mul16_byte
 5793 2896 ~            .full:
 5794 2896 ~                LD   B,H
 5795 2896 ~                LD   C,L
 5796 2896 ~                LD   HL,0
 5797 2896 ~                LD   A,D
 5798 2896 ~                CALL __x80_mul16_byte
 5799 2896 ~                LD   A,E
 5800 2896 ~                ELSE
 5801 2896 ~                LD   A,E
 5802 2896 ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2896 ~            .full:
 5804 2896 ~                LD   B,H
 5805 2896 ~                LD   C,L
 5806 2896 ~                LD   A,D
 5807 2896 ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2896 ~                LD   A,E
 5809 2896 ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2896 ~                ENDIF
 5811 2896                  ENDIF
