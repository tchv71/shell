 6695 28BE              ; ---------------------------------------------------------------------------
 6696 28BE              ; A copy or a zeroing of a known size above __x80_mcpy_N's 32, two bytes a trip (SIA, zx-pk.ru):
 6697 28BE              ; HL = destination, DE = source; BC the trips, the pairs of bytes, as two counters one inside
 6698 28BE              ; the other -- C the low byte (0 for 256), B the high one and one more where C is not 0 -- which
 6699 28BE              ; the compiler works out (isel.c, select_block_move), and an odd count entered at the second
 6700 28BE              ; byte of the first pair. 31.5 T-states a byte for a copy, against 47 a byte for __x80_memcpy's
 6701 28BE              ; word counted down; 19.5 for a zeroing, against 38. __x80_mcpyp_* write A, BC, DE and HL;
 6702 28BE              ; __x80_mzerop_* A, BC and HL.
 6703 28BE              ; ---------------------------------------------------------------------------
 6704 28BE              __x80_mcpyp_any = 0
 6705 28BE                  IFUSED __x80_mcpyp_even
 6706 28BE ~            __x80_mcpyp_any = 1
 6707 28BE                  ENDIF
 6708 28BE                  IFUSED __x80_mcpyp_odd
 6709 28BE ~            __x80_mcpyp_any = 1
 6710 28BE                  ENDIF
