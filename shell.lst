 5964 2896                  IFUSED __x80_shl16
 5965 2896 ~
 5966 2896 ~            ; ---------------------------------------------------------------------------
 5967 2896 ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2896 ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2896 ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2896 ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2896 ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2896 ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2896 ~            ; Vector, which rounds every instruction up to four.
 5974 2896 ~            ;
 5975 2896 ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2896 ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2896 ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2896 ~            ; here is the per-bit cost, not the call overhead.
 5979 2896 ~            ; ---------------------------------------------------------------------------
 5980 2896 ~            __x80_shl16:
 5981 2896 ~                XOR  A
 5982 2896 ~                OR   E
 5983 2896 ~                RET  Z
 5984 2896 ~                CP   8
 5985 2896 ~                JP   NC,.bytes
 5986 2896 ~            .loop:
 5987 2896 ~                ADD  HL,HL
 5988 2896 ~                DEC  A
 5989 2896 ~                JP   NZ,.loop
 5990 2896 ~                RET
 5991 2896 ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2896 ~            .bytes:
 5993 2896 ~                LD   H,L
 5994 2896 ~                LD   L,0
 5995 2896 ~                SUB  8
 5996 2896 ~                RET  Z
 5997 2896 ~                CP   8
 5998 2896 ~                JP   NC,.zero
 5999 2896 ~                LD   B,A
 6000 2896 ~                LD   A,H
 6001 2896 ~            .byte:
 6002 2896 ~                ADD  A,A
 6003 2896 ~                DEC  B
 6004 2896 ~                JP   NZ,.byte
 6005 2896 ~                LD   H,A
 6006 2896 ~                RET
 6007 2896 ~            .zero:
 6008 2896 ~                LD   H,L
 6009 2896 ~                RET
 6010 2896                  ENDIF
 6011 2896
 6012 2896                  IFUSED __x80_lshr16
 6013 2896 ~
 6014 2896 ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2896 ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2896 ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2896 ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2896 ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2896 ~            ; the time goes.
 6020 2896 ~            __x80_lshr16:
 6021 2896 ~                XOR  A
 6022 2896 ~                OR   E
 6023 2896 ~                RET  Z
 6024 2896 ~                CP   8
 6025 2896 ~                JP   NC,.bytes
 6026 2896 ~                LD   B,A
 6027 2896 ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2896 ~                DEC  H
 6029 2896 ~                JP   Z,.low
 6030 2896 ~                CP   4
 6031 2896 ~                JP   NC,.left
 6032 2896 ~            .loop:
 6033 2896 ~                XOR  A
 6034 2896 ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2896 ~                RRA
 6036 2896 ~                LD   H,A
 6037 2896 ~                LD   A,L
 6038 2896 ~                RRA
 6039 2896 ~                LD   L,A
 6040 2896 ~                DEC  B
 6041 2896 ~                JP   NZ,.loop
 6042 2896 ~                RET
 6043 2896 ~            .left:
 6044 2896 ~                LD   A,8
 6045 2896 ~                SUB  B
 6046 2896 ~                LD   B,A
 6047 2896 ~                XOR  A
 6048 2896 ~            .left_loop:
 6049 2896 ~                ADD  HL,HL
