 6013 2C5B ~
 6014 2C5B ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2C5B ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2C5B ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2C5B ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2C5B ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2C5B ~            ; the time goes.
 6020 2C5B ~            __x80_lshr16:
 6021 2C5B ~                XOR  A
 6022 2C5B ~                OR   E
 6023 2C5B ~                RET  Z
 6024 2C5B ~                CP   8
 6025 2C5B ~                JP   NC,.bytes
 6026 2C5B ~                LD   B,A
 6027 2C5B ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2C5B ~                DEC  H
 6029 2C5B ~                JP   Z,.low
 6030 2C5B ~                CP   4
 6031 2C5B ~                JP   NC,.left
 6032 2C5B ~            .loop:
 6033 2C5B ~                XOR  A
 6034 2C5B ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2C5B ~                RRA
 6036 2C5B ~                LD   H,A
 6037 2C5B ~                LD   A,L
 6038 2C5B ~                RRA
 6039 2C5B ~                LD   L,A
 6040 2C5B ~                DEC  B
 6041 2C5B ~                JP   NZ,.loop
 6042 2C5B ~                RET
 6043 2C5B ~            .left:
 6044 2C5B ~                LD   A,8
 6045 2C5B ~                SUB  B
 6046 2C5B ~                LD   B,A
 6047 2C5B ~                XOR  A
 6048 2C5B ~            .left_loop:
 6049 2C5B ~                ADD  HL,HL
 6050 2C5B ~                RLA
 6051 2C5B ~                DEC  B
 6052 2C5B ~                JP   NZ,.left_loop
 6053 2C5B ~                LD   L,H
 6054 2C5B ~                LD   H,A
 6055 2C5B ~                RET
 6056 2C5B ~            .bytes:
 6057 2C5B ~                LD   L,H
 6058 2C5B ~                LD   H,0
 6059 2C5B ~                SUB  8
 6060 2C5B ~                RET  Z
 6061 2C5B ~                CP   8
 6062 2C5B ~                JP   NC,.zero
 6063 2C5B ~                LD   B,A
 6064 2C5B ~            .low:
 6065 2C5B ~                LD   A,L
 6066 2C5B ~            .byte:
 6067 2C5B ~                OR   A
 6068 2C5B ~                RRA
 6069 2C5B ~                DEC  B
 6070 2C5B ~                JP   NZ,.byte
 6071 2C5B ~                LD   L,A
 6072 2C5B ~                RET
 6073 2C5B ~            .zero:
 6074 2C5B ~                LD   L,H
 6075 2C5B ~                RET
 6076 2C5B                  ENDIF
