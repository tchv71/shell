 6384 2904 ~                LD   (HL),E
 6385 2904 ~                INC  HL
 6386 2904 ~                LD   (HL),D
 6387 2904 ~                INC  HL
 6388 2904 ~                DEC  C
 6389 2904 ~                JP   NZ,.up
 6390 2904 ~                DEC  B
 6391 2904 ~                JP   NZ,.up
 6392 2904 ~                EX   DE,HL              ; DE the destination, at d + n - g
 6393 2904 ~                LD   HL,(__x80_sp_save)
 6394 2904 ~                LD   SP,HL
 6395 2904 ~                POP  HL                 ; d
 6396 2904 ~                POP  BC                 ; g
 6397 2904 ~                PUSH HL
