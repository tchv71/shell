    1 0000              ;; bin_start.asm -- what runs before main in a bare binary (--target=bin): no machine, no ROM, nothing
    2 0000              ;; but the 8080.
    3 0000              ;
    4 0000              ; The image goes where --org says (X80_ORG, 0 by default) and starts there. The objects that start
    5 0000              ; as zeros go just below --stack-top (X80_BSS_TOP, which the driver insists on: there is no machine
    6 0000              ; to take it from), the stack below them. main is called as a subroutine: the stack pointer it was
    7 0000              ; started with is kept, and main's return, exit, _Exit and abort go back to whoever started the
    8 0000              ; image -- with a CALL, a monitor's G directive -- on its own stack, the status in HL. There is no
    9 0000              ; putchar: a program that prints defines its own, and printf and puts use it.
   10 0000              ;
   11 0000              ; With --no-startup (X80_NO_STARTUP) none of that runs: the image starts with a jump to main, which
   12 0000              ; runs on the stack it was started with and returns to its caller; the objects that start as zeros
   13 0000              ; are zeros in the image, at its end (X80_BSS_IN_IMAGE, lib/crt/runtime.asm), so that nothing has
   14 0000              ; to clear them -- or, with --stack-top as well, below that, where the caller clears them: code in
   15 0000              ; ROM, its variables in RAM. exit, _Exit and abort halt; main's return does not run what atexit
   16 0000              ; registered.
   17 0000              ;
   18 0000              ;   x80cc --target=bin --org=0x4000 --stack-top=0x7600 -o prog.bin prog.c
   19 0000
   20 0000                  device NOSLOT64K
   21 0000                  IFDEF X80_ORG
   22 0000                  org 0x0100
   23 0100                  ELSE
   24 0100 ~                org 0x0000
   25 0100                  ENDIF
   26 0100
   27 0100              __x80_bss_off = 0
   28 0100              __x80_xlat_head = 0         ; the chain of the program's function -> interrupt copy tables
   29 0100
   30 0100                  IFDEF X80_NO_STARTUP
   31 0100
   32 0100                  IFDEF X80_BSS_TOP
   33 0100 ~            __x80_bss_top EQU X80_BSS_TOP
   34 0100                  ELSE
   35 0100              __x80_bss_top EQU __x80_bss_image + __x80_bss_size
   36 0100                  ENDIF
   37 0100
   38 0100              __x80_bin_start:
   39 0100 C3 9A 26         JP   _main
   40 0103
   41 0103                  ELSE
   42 0103 ~
   43 0103 ~                DEFINE X80_EXIT_DEFINED     ; so that the runtime leaves __x80_exit to this file
   44 0103 ~
   45 0103 ~            __x80_bss_top EQU X80_BSS_TOP
   46 0103 ~            __x80_bss_off = __x80_bss_off + 2
   47 0103 ~            __x80_bin_sp EQU __x80_bss_top - __x80_bss_off  ; the stack pointer the image was started with
   48 0103 ~
   49 0103 ~            __x80_bin_start:
   50 0103 ~                LD   HL,0
   51 0103 ~                ADD  HL,SP
   52 0103 ~                EX   DE,HL              ; the caller's stack pointer, kept in DE while the zeros are cleared
   53 0103 ~                LD   HL,(__x80_bss_top-__x80_bss_size) & 0FFFFH
   54 0103 ~                LD   SP,HL              ; the stack below them
   55 0103 ~                LD   BC,__x80_bss_size
   56 0103 ~            __x80_clear:
   57 0103 ~                LD   A,B
   58 0103 ~                OR   C
   59 0103 ~                JP   Z,__x80_cleared
   60 0103 ~                LD   (HL),0
   61 0103 ~                INC  HL
   62 0103 ~                DEC  BC
   63 0103 ~                JP   __x80_clear
   64 0103 ~            __x80_cleared:
   65 0103 ~                EX   DE,HL
   66 0103 ~                LD   (__x80_bin_sp),HL
   67 0103 ~                LD   HL,0               ; argc: no arguments
   68 0103 ~                LD   DE,__x80_argv      ; argv: argv[argc], argv[0] here, is the null pointer C requires
   69 0103 ~                CALL _main
   70 0103 ~                IFUSED _atexit
   71 0103 ~                JP   _exit              ; returning from main is exit(its value): what atexit registered runs
   72 0103 ~                ENDIF
   73 0103 ~            __x80_exit:
   74 0103 ~                EX   DE,HL              ; the status
   75 0103 ~                LD   HL,(__x80_bin_sp)
   76 0103 ~                LD   SP,HL              ; the caller's stack, its return address on top
   77 0103 ~                EX   DE,HL
   78 0103 ~                RET
   79 0103 ~
   80 0103                  ENDIF
