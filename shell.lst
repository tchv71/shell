 8543 292C              ; Where the characters of a written-out printf go (lib/libc/stdio.c, pw_out): to putchar, the
 8544 292C              ; character in L -- or, in a program that has sprintf or snprintf written out, which is what uses
 8545 292C              ; __x80_put_to, into the buffer while __x80_pw_mode is set. A program that only prints carries the
 8546 292C              ; JP alone.
 8547 292C                  IFUSED __x80_pw_out
 8548 292C ~            __x80_pw_out:
 8549 292C ~                IFUSED __x80_put_to
