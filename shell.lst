 1428 27D4              ; ---------------------------------------------------------------------------
 1429 27D4              ; binary32: float arithmetic, comparison and conversions to and from long.
 1430 27D4              ;
 1431 27D4              ; The compiler calls these for every float operation: a float is its bits, an operand like a
 1432 27D4              ; long -- a in HL (low word) and DE (high word), b in BC (low) and on the stack above the return
 1433 27D4              ; address (high), left there for the caller to take off -- and the result in HL:DE, a comparison's
 1434 27D4              ; in A. The algorithms are those of the compiler's C reference implementation of IEEE 754, and the
 1435 27D4              ; results agree with it bit for bit: one rounding, to the nearest with ties to even; subnormals;
 1436 27D4              ; infinities; and NaNs that come back quieted, the first operand's when both are, as on the
 1437 27D4              ; x86.
 1438 27D4              ;
 1439 27D4              ; A finite number in the middle of an operation is a sign (in fps), an exponent in BC and a
 1440 27D4              ; significand of thirty-two bits in DEHL, D the top byte, its leading one at bit 31: twenty-four
 1441 27D4              ; bits of the result and eight below them, which decide the rounding -- the round bit is bit 7,
 1442 27D4              ; and whatever was shifted out below bit 0 is kept as a one in bit 0, the sticky bit. Its value is
 1443 27D4              ; DEHL / 2^31 * 2^(BC - 127), so BC is the biased exponent the result has before rounding.
 1444 27D4              ; __x80_fp_rpack makes the float of that. The operands wait in fpa and fpb, the bytes as in
 1445 27D4              ; memory, low first.
 1446 27D4              ;
 1447 27D4              ; Not reentrant: an interrupt handler doing float arithmetic while the main program is inside one
 1448 27D4              ; of these would corrupt it, as with the division of longs.
 1449 27D4              ; ---------------------------------------------------------------------------
 1450 27D4
 1451 27D4                  IFUSED __x80_fsub
 1452 27D4 ~            __x80_fsub:
 1453 27D4 ~                LD   A,80H              ; b's sign flipped: the addition, which follows its first byte
 1454 27D4 ~                JP   __x80_fadd+1
 1455 27D4                  ENDIF
 1456 27D4
 1457 27D4                  IFUSED __x80_fadd
 1458 27D4 ~            ; ---------------------------------------------------------------------------
 1459 27D4 ~            ; DE:HL = a + b. With |a| >= |b| -- swapped if not -- the result has a's sign, and b's
 1460 27D4 ~            ; significand, shifted down to a's exponent, is added to a's or taken from it. A subnormal is
 1461 27D4 ~            ; taken as exponent 1 without the leading one, and comes the same way; a NaN, an infinity and a
 1462 27D4 ~            ; zero b are dealt with before.
 1463 27D4 ~            ; ---------------------------------------------------------------------------
 1464 27D4 ~            __x80_fadd:
