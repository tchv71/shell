 4980 28C8                  IFUSED __x80_mulw
 4981 28C8 ~
 4982 28C8 ~            ; ---------------------------------------------------------------------------
 4983 28C8 ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 28C8 ~            ;
 4985 28C8 ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 28C8 ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 28C8 ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 28C8 ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 28C8 ~            ; product, some 300 T-states.
 4990 28C8 ~            ; ---------------------------------------------------------------------------
 4991 28C8 ~            __x80_mulw:
 4992 28C8 ~                XOR  A
 4993 28C8 ~                OR   D
 4994 28C8 ~                JP   NZ,.full
 4995 28C8 ~                LD   A,E
 4996 28C8 ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 28C8 ~                LD   E,A                ; D is zero still
 4998 28C8 ~                RET
 4999 28C8 ~            .full:
 5000 28C8 ~                LD   A,E
 5001 28C8 ~                LD   E,D                ; the high byte waits in E,
 5002 28C8 ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 28C8 ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 28C8 ~                PUSH HL                 ; the low product's low word
 5005 28C8 ~                LD   L,A
 5006 28C8 ~                LD   A,E
 5007 28C8 ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 28C8 ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 28C8 ~                LD   D,A
 5010 28C8 ~                LD   A,L
 5011 28C8 ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 28C8 ~                ADD  A,H
 5013 28C8 ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 28C8 ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 28C8 ~                LD   A,E
 5016 28C8 ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 28C8 ~                LD   E,A
 5018 28C8 ~                LD   A,D
 5019 28C8 ~                ADC  A,0                ; the fourth
 5020 28C8 ~                LD   D,A
 5021 28C8 ~                POP  HL
 5022 28C8 ~                RET
 5023 28C8                  ENDIF
