 7527 28BE
 7528 28BE              ; ---------------------------------------------------------------------------
 7529 28BE              ; HL = destination: __x80_mzero_N fills N bytes with zero, N from 1 to 32, for
 7530 28BE              ; the part of an initialiser that is not written out -- the same as
 7531 28BE              ; __x80_mcpy_N above, in a CALL of three bytes where LD BC,N and a CALL of
 7532 28BE              ; __x80_memzero were six. Writes A, C and HL; leaves B and DE alone.
 7533 28BE              ;
 7534 28BE              ; (a) The tail: `LD (HL),0 / INC HL` a step, 15 T-states a byte, 3 * M bytes
 7535 28BE              ;     for the largest size M up to 16; the sizes above that by (b).
 7536 28BE              ; (b) The loop counting in C, 27 T-states a byte against 39 in __x80_memzero's,
 7537 28BE              ;     its entries passing over each other by a byte 3AH as above -- A is made
 7538 28BE              ;     zero only after them. 7 + 3 * sizes bytes.
 7539 28BE              ; ---------------------------------------------------------------------------
 7540 28BE              __x80_mzero_d = 0                   ; the sizes used
 7541 28BE              __x80_mzero_db = 0                  ; of them above 16
 7542 28BE              __x80_mzero_m = 0                   ; the largest up to 16
 7543 28BE              __x80_mzero_lo = 0                  ; the smallest
 7544 28BE              __x80_mzero_lb = 0                  ; the smallest above 16
 7545 28BE                  IFUSED __x80_mzero_32
