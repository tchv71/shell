 1084 2AFB ~                LD   A,(HL)
 1085 2AFB ~                OR   0FH
 1086 2AFB ~                AND  C
 1087 2AFB ~                ADD  A,2                ; the carry: the exponent all ones
 1088 2AFB ~                RET  C
 1089 2AFB ~                LD   A,C
 1090 2AFB ~                LD   B,7
 1091 2AFB ~            .or:
 1092 2AFB ~                OR   (HL)
