 6228 2896 ~                OR   A
 6229 2896 ~                JP   NZ,__x80_mmoves
 6230 2896 ~                LD   A,C
 6231 2896 ~                CP   X80_SP_RESERVE + 32
 6232 2896 ~                JP   NC,__x80_mmoves
 6233 2896 ~                JP   __x80_mcpyn_pairs
 6234 2896 ~            .near:
 6235 2896 ~                ELSE
 6236 2896 ~                JP   C,__x80_mcpyn_pairs ; below: forwards; the same place, down as well as any
 6237 2896 ~                ENDIF
