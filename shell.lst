 6078 2904                  IFUSED __x80_ashr16
 6079 2904 ~
 6080 2904 ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2904 ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2904 ~            __x80_ashr16:
 6083 2904 ~                XOR  A
 6084 2904 ~                OR   E
 6085 2904 ~                RET  Z
 6086 2904 ~                LD   B,A
 6087 2904 ~                CP   8
 6088 2904 ~                JP   NC,.bytes
 6089 2904 ~                CP   4
 6090 2904 ~                JP   NC,.left
 6091 2904 ~            .loop:
 6092 2904 ~                LD   A,H
 6093 2904 ~                RLCA                    ; the sign into the carry
 6094 2904 ~                RRCA                    ; H as it was, a T-state less than LD A,H again
 6095 2904 ~                RRA                     ; and the sign back into the top bit, so it replaces itself
 6096 2904 ~                LD   H,A
 6097 2904 ~                LD   A,L
 6098 2904 ~                RRA
 6099 2904 ~                LD   L,A
 6100 2904 ~                DEC  B
 6101 2904 ~                JP   NZ,.loop
 6102 2904 ~                RET
 6103 2904 ~            .left:
 6104 2904 ~                LD   A,8
 6105 2904 ~                SUB  B
 6106 2904 ~                LD   B,A
 6107 2904 ~                LD   A,H
 6108 2904 ~                RLA
 6109 2904 ~                SBC  A,A                ; the sign's byte, 00h or FFh
 6110 2904 ~            .left_loop:
 6111 2904 ~                ADD  HL,HL
 6112 2904 ~                RLA
 6113 2904 ~                DEC  B
 6114 2904 ~                JP   NZ,.left_loop
 6115 2904 ~                LD   L,H
 6116 2904 ~                LD   H,A
 6117 2904 ~                RET
 6118 2904 ~            .bytes:
 6119 2904 ~                LD   L,H
 6120 2904 ~                LD   A,H
 6121 2904 ~                RLA
 6122 2904 ~                SBC  A,A
 6123 2904 ~                LD   H,A                ; the sign's byte above
 6124 2904 ~                LD   A,B
 6125 2904 ~                SUB  8
 6126 2904 ~                RET  Z
 6127 2904 ~                CP   8
 6128 2904 ~                JP   NC,.all
 6129 2904 ~                LD   B,A
 6130 2904 ~                LD   A,L
 6131 2904 ~            .byte:
 6132 2904 ~                RLCA                    ; the byte's sign into the carry,
 6133 2904 ~                RRCA                    ; the byte as it was,
 6134 2904 ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2904 ~                DEC  B
 6136 2904 ~                JP   NZ,.byte
 6137 2904 ~                LD   L,A
 6138 2904 ~                RET
 6139 2904 ~            .all:
 6140 2904 ~                LD   L,H
 6141 2904 ~                RET
 6142 2904                  ENDIF
