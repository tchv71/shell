 5307 285A                  IFUSED __x80_urem16
 5308 285A
 5309 285A              ; ---------------------------------------------------------------------------
 5310 285A              ; HL = HL % DE, unsigned.
 5311 285A              ; ---------------------------------------------------------------------------
 5312 285A              __x80_urem16:
 5313 285A CD 60 28         CALL __x80_udiv16
 5314 285D 62               LD   H,D
 5315 285E 6B               LD   L,E
 5316 285F C9               RET
 5317 2860                  ENDIF
 5318 2860
 5319 2860                  IFUSED __x80_udiv16
 5320 2860
 5321 2860              ; ---------------------------------------------------------------------------
 5322 2860              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2860              ;
 5324 2860              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2860              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2860              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2860              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2860              ;
 5329 2860              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2860              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2860              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2860              ; ---------------------------------------------------------------------------
 5333 2860              __x80_udiv16:
 5334 2860                  IFDEF X80_OPT_SIZE
 5335 2860                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2860                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2860                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2860 7A               LD   A,D
 5339 2861 B3               OR   E
 5340 2862 CA 8F 28         JP   Z,.s_zero
 5341 2865 42               LD   B,D
 5342 2866 4B               LD   C,E
 5343 2867 EB               EX   DE,HL
 5344 2868 21 00 00         LD   HL,0
 5345 286B 3E 10            LD   A,16
 5346 286D              .s_loop:
 5347 286D F5               PUSH AF
 5348 286E EB               EX   DE,HL
 5349 286F 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 2870 EB               EX   DE,HL
 5351 2871 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 2872 17               RLA
 5353 2873 6F               LD   L,A
 5354 2874 7C               LD   A,H
 5355 2875 17               RLA
 5356 2876 67               LD   H,A
 5357 2877 DA 81 28         JP   C,.s_take
 5358 287A 7D               LD   A,L
 5359 287B 91               SUB  C
 5360 287C 7C               LD   A,H
 5361 287D 98               SBC  A,B
 5362 287E DA 88 28         JP   C,.s_next          ; below the divisor: a 0
 5363 2881              .s_take:
 5364 2881 7D               LD   A,L
 5365 2882 91               SUB  C
 5366 2883 6F               LD   L,A
 5367 2884 7C               LD   A,H
 5368 2885 98               SBC  A,B
 5369 2886 67               LD   H,A
 5370 2887 1C               INC  E
 5371 2888              .s_next:
 5372 2888 F1               POP  AF
 5373 2889 3D               DEC  A
 5374 288A C2 6D 28         JP   NZ,.s_loop
 5375 288D EB               EX   DE,HL
 5376 288E C9               RET
 5377 288F              .s_zero:
 5378 288F 21 FF FF         LD   HL,0FFFFH
 5379 2892 11 00 00         LD   DE,0
 5380 2895 C9               RET
 5381 2896                  ELSE
 5382 2896 ~                LD   A,D
 5383 2896 ~                OR   A
 5384 2896 ~                JP   NZ,.wide
 5385 2896 ~                OR   E
 5386 2896 ~                JP   Z,.by_zero
 5387 2896 ~                LD   A,H
 5388 2896 ~                CP   E
 5389 2896 ~                JP   NC,.two
 5390 2896 ~                OR   A
 5391 2896 ~                JP   NZ,.one
 5392 2896 ~                LD   A,L            ; below the divisor: the dividend is the remainder
 5393 2896 ~                CP   E
 5394 2896 ~                JP   C,.below
 5395 2896 ~            .one:
 5396 2896 ~                CALL __x80_dsetup8  ; the high byte below the divisor: one pass
 5397 2896 ~                CALL __x80_dpass8
 5398 2896 ~                LD   E,H            ; the remainder
 5399 2896 ~                LD   D,0
 5400 2896 ~                LD   L,A
 5401 2896 ~                LD   H,D
 5402 2896 ~                RET
 5403 2896 ~            .two:
 5404 2896 ~                PUSH HL             ; the low byte, for the second pass
 5405 2896 ~                CALL __x80_dsetup8
 5406 2896 ~                LD   L,H            ; the high byte alone first
 5407 2896 ~                LD   H,0
 5408 2896 ~                CALL __x80_dpass8   ; its quotient in A, the remainder in H
 5409 2896 ~                LD   L,A
 5410 2896 ~                EX   (SP),HL        ; that kept; the dividend back
 5411 2896 ~                LD   A,L
 5412 2896 ~                POP  HL
 5413 2896 ~                PUSH HL
 5414 2896 ~                LD   L,A            ; the remainder and the low byte
 5415 2896 ~                CALL __x80_dpass8
 5416 2896 ~                LD   E,H
 5417 2896 ~                LD   D,0
 5418 2896 ~                POP  HL
 5419 2896 ~                LD   H,L            ; the high byte of the quotient
 5420 2896 ~                LD   L,A
 5421 2896 ~                RET
 5422 2896 ~            .below:
 5423 2896 ~                LD   E,L
 5424 2896 ~                LD   HL,0
 5425 2896 ~                RET
 5426 2896 ~            .wide:
 5427 2896 ~                JP   M,.big
 5428 2896 ~                LD   B,D            ; 256..32767: a quotient below 256
 5429 2896 ~                LD   C,E
 5430 2896 ~                XOR  A
 5431 2896 ~                SUB  E
 5432 2896 ~                LD   E,A
 5433 2896 ~                LD   A,0
 5434 2896 ~                SBC  A,D
 5435 2896 ~                LD   D,A
 5436 2896 ~                PUSH HL             ; the low byte, for after the pass
 5437 2896 ~                LD   L,H            ; the high byte, below the divisor
 5438 2896 ~                LD   H,0
 5439 2896 ~                ADD  HL,DE          ; as __x80_dpass16 takes a remainder
 5440 2896 ~                CALL __x80_dpass16
 5441 2896 ~                POP  DE
 5442 2896 ~                LD   D,A            ; the quotient
 5443 2896 ~                LD   A,E            ; the low byte added to the remainder
 5444 2896 ~                ADD  A,L
 5445 2896 ~                LD   L,A
 5446 2896 ~                LD   A,H
 5447 2896 ~                ADC  A,0
 5448 2896 ~                LD   H,A
 5449 2896 ~                JP   C,.up          ; it reached the divisor: one more
 5450 2896 ~                ADD  HL,BC          ; the remainder as it is
 5451 2896 ~                EX   DE,HL
 5452 2896 ~                LD   L,H
 5453 2896 ~                LD   H,0
 5454 2896 ~                RET
 5455 2896 ~            .up:
 5456 2896 ~                INC  D
 5457 2896 ~                EX   DE,HL
 5458 2896 ~                LD   L,H
 5459 2896 ~                LD   H,0
 5460 2896 ~                RET
 5461 2896 ~            .big:
 5462 2896 ~                LD   A,L            ; 32768 or more: the quotient is 1 if the dividend is not below
 5463 2896 ~                SUB  E
 5464 2896 ~                LD   C,A
 5465 2896 ~                LD   A,H
 5466 2896 ~                SBC  A,D
 5467 2896 ~                JP   C,.less
 5468 2896 ~                LD   D,A
 5469 2896 ~                LD   E,C
 5470 2896 ~                LD   HL,1
 5471 2896 ~                RET
 5472 2896 ~            .less:
 5473 2896 ~                EX   DE,HL          ; below the divisor: the dividend is the remainder
 5474 2896 ~                LD   HL,0
 5475 2896 ~                RET
 5476 2896 ~            .by_zero:
 5477 2896 ~                LD   HL,0FFFFH
 5478 2896 ~                LD   DE,0
 5479 2896 ~                RET
 5480 2896                  ENDIF
 5481 2896                  ENDIF
 5482 2896
 5483 2896                  IFUSED __x80_dpass16
 5484 2896 ~
 5485 2896 ~            ; ---------------------------------------------------------------------------
 5486 2896 ~            ; A byte of a quotient: blackmirror's division (zx-pk.ru, "Vychislenie chisla Pi na
 5487 2896 ~            ; assemblere", 2016), as ivagor made it the 8080's.
 5488 2896 ~            ;
 5489 2896 ~            ; Non-restoring, and unrolled: the remainder doubled each step and the divisor added to it or
 5490 2896 ~            ; taken from it -- added while the remainder is below zero, taken while it is not -- so that it
 5491 2896 ~            ; stays within one divisor of zero, and the step's carry is the quotient's bit. The two cases are
 5492 2896 ~            ; two chains of code, and a step goes from one to the other on its carry: no test of a sign, no
 5493 2896 ~            ; restoring of a remainder that went below zero. Each step is ADC A,A / ADD HL,HL / ADD HL,rp / JP
 5494 2896 ~            ; -- 34 T-states a bit, where a restoring step with the remainder in memory or on the stack was
 5495 2896 ~            ; three or four times that. The carry, not the sign, tells which way the remainder went, which is
 5496 2896 ~            ; what lets the divisor be anything below 32768: the doubled remainder may need seventeen bits,
 5497 2896 ~            ; but the carry is the seventeenth.
 5498 2896 ~            ;
 5499 2896 ~            ; __x80_dpass16: a divisor B of 256..32767 in BC, -B in DE, and in HL a remainder R below B as
 5500 2896 ~            ; the passes keep it, R - B. Returns the byte of R * 256 / B in A, and in HL (R * 256 % B) - B,
 5501 2896 ~            ; to which the caller adds the next byte of the dividend: when that carries, the remainder has
 5502 2896 ~            ; reached B again -- one more in the quotient, and B taken off once more.
 5503 2896 ~            ; ---------------------------------------------------------------------------
 5504 2896 ~            __x80_dpass16:
 5505 2896 ~                ADD  HL,HL          ; bit 7, the remainder below zero
 5506 2896 ~                ADD  HL,BC
 5507 2896 ~                JP   C,.s6
