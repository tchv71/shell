 2862 27D4 ~                INC  A
 2863 27D4 ~                JP   Z,.nan
 2864 27D4 ~                LD   A,E
 2865 27D4 ~                OR   80H
 2866 27D4 ~                LD   C,A                ; the significand with its leading one, C H L
 2867 27D4 ~                LD   A,B
 2868 27D4 ~                OR   A
