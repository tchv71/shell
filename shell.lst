 5286 2BEF                  IFUSED __x80_sdiv16
 5287 2BEF ~
 5288 2BEF ~            ; ---------------------------------------------------------------------------
 5289 2BEF ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 2BEF ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 2BEF ~            ; the sign put back afterwards.
 5292 2BEF ~            ; ---------------------------------------------------------------------------
 5293 2BEF ~            __x80_sdiv16:
 5294 2BEF ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 2BEF ~                XOR  D
 5296 2BEF ~                AND  80H
 5297 2BEF ~                PUSH AF
 5298 2BEF ~                CALL __x80_abs_hl
 5299 2BEF ~                CALL __x80_abs_de
 5300 2BEF ~                CALL __x80_udiv16
 5301 2BEF ~                POP  AF
 5302 2BEF ~                OR   A
 5303 2BEF ~                RET  Z
 5304 2BEF ~                JP   __x80_neg_hl
 5305 2BEF                  ENDIF
 5306 2BEF
 5307 2BEF                  IFUSED __x80_urem16
 5308 2BEF
 5309 2BEF              ; ---------------------------------------------------------------------------
 5310 2BEF              ; HL = HL % DE, unsigned.
 5311 2BEF              ; ---------------------------------------------------------------------------
 5312 2BEF              __x80_urem16:
 5313 2BEF CD F5 2B         CALL __x80_udiv16
 5314 2BF2 62               LD   H,D
 5315 2BF3 6B               LD   L,E
 5316 2BF4 C9               RET
 5317 2BF5                  ENDIF
 5318 2BF5
 5319 2BF5                  IFUSED __x80_udiv16
 5320 2BF5
 5321 2BF5              ; ---------------------------------------------------------------------------
 5322 2BF5              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2BF5              ;
 5324 2BF5              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2BF5              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2BF5              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2BF5              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2BF5              ;
 5329 2BF5              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2BF5              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2BF5              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2BF5              ; ---------------------------------------------------------------------------
 5333 2BF5              __x80_udiv16:
 5334 2BF5                  IFDEF X80_OPT_SIZE
 5335 2BF5                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2BF5                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2BF5                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2BF5 7A               LD   A,D
