  909 2AFB                  IFUSED __x80_d_toi
  910 2AFB ~            ; ---------------------------------------------------------------------------
  911 2AFB ~            ; qa = the significand in qa, its leading one at bit 63, truncated to an integer, given HL = its
  912 2AFB ~            ; exponent less the bias and A the first one too large -- 63 for long long, 64 for unsigned long
  913 2AFB ~            ; long -- and negated if dsg says so. Below 1 it is 0; too large, 8000000000000000H.
  914 2AFB ~            ; ---------------------------------------------------------------------------
  915 2AFB ~            __x80_d_toi:
  916 2AFB ~                LD   C,A
  917 2AFB ~                XOR  A
  918 2AFB ~                OR   H
  919 2AFB ~                JP   M,.zero
  920 2AFB ~                JP   NZ,.min
  921 2AFB ~                LD   A,L
  922 2AFB ~                CP   C
  923 2AFB ~                JP   NC,.min
  924 2AFB ~                CPL
  925 2AFB ~                ADD  A,64               ; 63 less the exponent: places down
  926 2AFB ~                LD   HL,__x80_qa
  927 2AFB ~                CALL __x80_d_shr
  928 2AFB ~                LD   A,(__x80_dsg)
  929 2AFB ~                OR   A
  930 2AFB ~                RET  Z
  931 2AFB ~                LD   HL,__x80_qa
  932 2AFB ~                JP   __x80_q_negate
  933 2AFB ~            .zero:
  934 2AFB ~                LD   HL,__x80_qa
  935 2AFB ~                JP   __x80_q_zero
  936 2AFB ~            .min:
  937 2AFB ~                LD   HL,__x80_qa
