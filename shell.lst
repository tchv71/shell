 8561 292C              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 292C              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 292C              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 292C              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 292C              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 292C              ;@shared
 8567 292C                  IFUSED _vc_on_frame
 8568 292C ~                IFNDEF __X80_DEF_vc_on_frame
 8569 292C ~            _vc_on_frame:
 8570 292C ~                RET
 8571 292C ~                ENDIF
 8572 292C                  ENDIF
 8573 292C              ;@end
 8574 292C
 8575 292C              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 292C              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 292C              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 292C              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 292C              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 292C              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 292C              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 292C              ; function written in assembly, which has none; every other register kept.
 8583 292C              ;@shared
 8584 292C                  IFUSED __x80_xlat
 8585 292C ~            __x80_xlat:
 8586 292C ~                PUSH AF
 8587 292C ~                PUSH BC
 8588 292C ~                PUSH DE
 8589 292C ~                EX   DE,HL              ; DE the address
 8590 292C ~                LD   HL,__x80_xlat_last
 8591 292C ~            .segment:
 8592 292C ~                LD   A,H
 8593 292C ~                OR   L
 8594 292C ~                JP   Z,.done
 8595 292C ~                LD   C,(HL)
 8596 292C ~                INC  HL
 8597 292C ~                LD   B,(HL)             ; BC the segment before
 8598 292C ~                INC  HL
 8599 292C ~            .entry:
 8600 292C ~                LD   A,(HL)
 8601 292C ~                INC  HL
 8602 292C ~                OR   (HL)
 8603 292C ~                JP   Z,.end             ; the zero word
 8604 292C ~                DEC  HL
 8605 292C ~                LD   A,(HL)
 8606 292C ~                CP   E
 8607 292C ~                INC  HL
 8608 292C ~                JP   NZ,.skip
 8609 292C ~                LD   A,(HL)
 8610 292C ~                CP   D
 8611 292C ~                JP   Z,.found
 8612 292C ~            .skip:
 8613 292C ~                INC  HL
 8614 292C ~                INC  HL
 8615 292C ~                INC  HL
 8616 292C ~                JP   .entry
 8617 292C ~            .found:
 8618 292C ~                INC  HL
 8619 292C ~                LD   E,(HL)
 8620 292C ~                INC  HL
 8621 292C ~                LD   D,(HL)             ; DE the copy
 8622 292C ~                JP   .done
 8623 292C ~            .end:
 8624 292C ~                LD   H,B
 8625 292C ~                LD   L,C
 8626 292C ~                JP   .segment
 8627 292C ~            .done:
 8628 292C ~                EX   DE,HL
 8629 292C ~                POP  DE
 8630 292C ~                POP  BC
 8631 292C ~                POP  AF
 8632 292C ~                RET
 8633 292C                  ENDIF
 8634 292C              ;@end
 8635 292C
 8636 292C              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 292C              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 292C              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 292C              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 292C              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 292C              ; the library since. Every register kept.
 8642 292C              ;@shared
 8643 292C                  IFUSED __x80_busy
 8644 292C ~            __x80_bss_off = __x80_bss_off + 1
 8645 292C ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 292C                  ENDIF
 8647 292C                  IFUSED __x80_pending
 8648 292C ~            __x80_bss_off = __x80_bss_off + 2
 8649 292C ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 292C                  ENDIF
 8651 292C                  IFUSED __x80_run_deferred
 8652 292C ~            __x80_run_deferred:
 8653 292C ~                PUSH AF
 8654 292C ~                PUSH HL
 8655 292C ~                LD   HL,(__x80_pending)
 8656 292C ~                LD   A,H
 8657 292C ~                OR   L
 8658 292C ~                JP   Z,.done
 8659 292C ~                PUSH BC
 8660 292C ~                PUSH DE
 8661 292C ~                PUSH HL
 8662 292C ~                LD   HL,0
 8663 292C ~                LD   (__x80_pending),HL
 8664 292C ~                POP  HL
 8665 292C ~                DI
 8666 292C ~                CALL .go
 8667 292C ~                EI
 8668 292C ~                POP  DE
 8669 292C ~                POP  BC
 8670 292C ~            .done:
 8671 292C ~                POP  HL
 8672 292C ~                POP  AF
 8673 292C ~                RET
 8674 292C ~            .go:
 8675 292C ~                JP   (HL)
 8676 292C                  ENDIF
 8677 292C              ;@end
 8678 292C
 8679 292C              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 292C              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 292C              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 292C              ; and the startup code clears them and puts the stack below them. Last in the
 8683 292C              ; file, and this file last on the assembler's command line.
 8684 292C              ;@shared
 8685 292C                  IFUSED __x80_xlat
 8686 292C ~            __x80_xlat_last EQU __x80_xlat_head
 8687 292C                  ENDIF
 8688 292C              __x80_bss_size EQU __x80_bss_off
 8689 292C                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 292C                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 292C                  IFDEF X80_BSS_IN_IMAGE
 8692 292C              __x80_bss_image:
 8693 292C                  IF __x80_bss_size
 8694 292C 00 00 00...      DEFS __x80_bss_size
 8695 2CF8                  ENDIF
 8696 2CF8                  ENDIF
 8697 2CF8                  IFUSED __x80_heap
 8698 2CF8 ~            __x80_heap:
 8699 2CF8                  ENDIF
 8700 2CF8              ;@end
 8701 2CF8
# file closed: runtime.asm
# file opened: runtime32.asm
    1 2CF8              ; runtime32.asm -- empty. The thirty-two-bit routines are in runtime.asm, with the sixteen-bit
    2 2CF8              ; ones they call, so that the assembler can leave out whatever a program does not use; see the
    3 2CF8              ; comment at the top of that file. Kept so that command lines naming it still work.
    4 2CF8
