  954 2AFB ~                RLA
  955 2AFB ~                LD   A,B
  956 2AFB ~                RLA
  957 2AFB ~                PUSH AF                 ; the exponent
  958 2AFB ~                PUSH DE
  959 2AFB ~                LD   HL,__x80_qa
  960 2AFB ~                CALL __x80_q_zero
  961 2AFB ~                POP  HL
  962 2AFB ~                LD   (__x80_qa+5),HL
