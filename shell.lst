 5483 2904                  IFUSED __x80_dpass16
 5484 2904 ~
 5485 2904 ~            ; ---------------------------------------------------------------------------
 5486 2904 ~            ; A byte of a quotient: blackmirror's division (zx-pk.ru, "Vychislenie chisla Pi na
 5487 2904 ~            ; assemblere", 2016), as ivagor made it the 8080's.
 5488 2904 ~            ;
 5489 2904 ~            ; Non-restoring, and unrolled: the remainder doubled each step and the divisor added to it or
 5490 2904 ~            ; taken from it -- added while the remainder is below zero, taken while it is not -- so that it
 5491 2904 ~            ; stays within one divisor of zero, and the step's carry is the quotient's bit. The two cases are
 5492 2904 ~            ; two chains of code, and a step goes from one to the other on its carry: no test of a sign, no
 5493 2904 ~            ; restoring of a remainder that went below zero. Each step is ADC A,A / ADD HL,HL / ADD HL,rp / JP
 5494 2904 ~            ; -- 34 T-states a bit, where a restoring step with the remainder in memory or on the stack was
 5495 2904 ~            ; three or four times that. The carry, not the sign, tells which way the remainder went, which is
 5496 2904 ~            ; what lets the divisor be anything below 32768: the doubled remainder may need seventeen bits,
 5497 2904 ~            ; but the carry is the seventeenth.
 5498 2904 ~            ;
 5499 2904 ~            ; __x80_dpass16: a divisor B of 256..32767 in BC, -B in DE, and in HL a remainder R below B as
 5500 2904 ~            ; the passes keep it, R - B. Returns the byte of R * 256 / B in A, and in HL (R * 256 % B) - B,
 5501 2904 ~            ; to which the caller adds the next byte of the dividend: when that carries, the remainder has
 5502 2904 ~            ; reached B again -- one more in the quotient, and B taken off once more.
 5503 2904 ~            ; ---------------------------------------------------------------------------
 5504 2904 ~            __x80_dpass16:
 5505 2904 ~                ADD  HL,HL          ; bit 7, the remainder below zero
 5506 2904 ~                ADD  HL,BC
 5507 2904 ~                JP   C,.s6
 5508 2904 ~            .a6:
 5509 2904 ~                ADC  A,A
 5510 2904 ~                ADD  HL,HL
 5511 2904 ~                ADD  HL,BC
 5512 2904 ~                JP   C,.s5
 5513 2904 ~            .a5:
 5514 2904 ~                ADC  A,A
 5515 2904 ~                ADD  HL,HL
 5516 2904 ~                ADD  HL,BC
 5517 2904 ~                JP   C,.s4
 5518 2904 ~            .a4:
 5519 2904 ~                ADC  A,A
 5520 2904 ~                ADD  HL,HL
 5521 2904 ~                ADD  HL,BC
 5522 2904 ~                JP   C,.s3
 5523 2904 ~            .a3:
 5524 2904 ~                ADC  A,A
 5525 2904 ~                ADD  HL,HL
 5526 2904 ~                ADD  HL,BC
 5527 2904 ~                JP   C,.s2
 5528 2904 ~            .a2:
 5529 2904 ~                ADC  A,A
 5530 2904 ~                ADD  HL,HL
 5531 2904 ~                ADD  HL,BC
 5532 2904 ~                JP   C,.s1
 5533 2904 ~            .a1:
 5534 2904 ~                ADC  A,A
 5535 2904 ~                ADD  HL,HL
 5536 2904 ~                ADD  HL,BC
 5537 2904 ~                JP   C,.s0
 5538 2904 ~            .a0:
 5539 2904 ~                ADC  A,A
 5540 2904 ~                ADD  HL,HL
 5541 2904 ~                ADD  HL,BC
 5542 2904 ~                JP   C,.se
 5543 2904 ~            .ae:
 5544 2904 ~                ADC  A,A            ; the last bit; the remainder already below zero
 5545 2904 ~                RET
 5546 2904 ~            .s6:
 5547 2904 ~                ADC  A,A
 5548 2904 ~                ADD  HL,HL
 5549 2904 ~                ADD  HL,DE
 5550 2904 ~                JP   NC,.a5
 5551 2904 ~            .s5:
 5552 2904 ~                ADC  A,A
 5553 2904 ~                ADD  HL,HL
 5554 2904 ~                ADD  HL,DE
 5555 2904 ~                JP   NC,.a4
 5556 2904 ~            .s4:
 5557 2904 ~                ADC  A,A
 5558 2904 ~                ADD  HL,HL
 5559 2904 ~                ADD  HL,DE
 5560 2904 ~                JP   NC,.a3
 5561 2904 ~            .s3:
 5562 2904 ~                ADC  A,A
 5563 2904 ~                ADD  HL,HL
 5564 2904 ~                ADD  HL,DE
 5565 2904 ~                JP   NC,.a2
 5566 2904 ~            .s2:
 5567 2904 ~                ADC  A,A
 5568 2904 ~                ADD  HL,HL
 5569 2904 ~                ADD  HL,DE
 5570 2904 ~                JP   NC,.a1
 5571 2904 ~            .s1:
 5572 2904 ~                ADC  A,A
 5573 2904 ~                ADD  HL,HL
 5574 2904 ~                ADD  HL,DE
 5575 2904 ~                JP   NC,.a0
 5576 2904 ~            .s0:
 5577 2904 ~                ADC  A,A
 5578 2904 ~                ADD  HL,HL
 5579 2904 ~                ADD  HL,DE
 5580 2904 ~                JP   NC,.ae
 5581 2904 ~            .se:
 5582 2904 ~                ADC  A,A            ; the last bit; the remainder made R - B, as the passes keep it
 5583 2904 ~                ADD  HL,DE
 5584 2904 ~                RET
