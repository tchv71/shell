 8528 292C              ; And the same for printf's 64-bit integers, %lld and its kind: __x80_format_ll when the program
 8529 292C              ; passes a 64-bit integer to a function with `...` (__x80_ll_varargs), zero otherwise.
 8530 292C              ;@shared
 8531 292C              __x80_ll_varargs EQU 0
 8532 292C              ;@end
 8533 292C
 8534 292C                  IFUSED __x80_printf_ll
