 2479 2AFB                  IFUSED __x80_fcmp
 2480 2AFB ~            ; ---------------------------------------------------------------------------
 2481 2AFB ~            ; A = 0 if a = b, 1 if a < b, 2 if a > b, 3 if either is a NaN. Two zeros are equal whatever
 2482 2AFB ~            ; their signs; otherwise floats of one sign are ordered as their bits are, upside down for
 2483 2AFB ~            ; negative ones.
 2484 2AFB ~            ;
 2485 2AFB ~            ; Straight from the registers and the stack while neither exponent's top seven bits are all
 2486 2AFB ~            ; ones, so neither can be a NaN; else the full path through fpa and fpb. -Os has the full path
 2487 2AFB ~            ; alone, some 70 bytes less.
 2488 2AFB ~            ; ---------------------------------------------------------------------------
 2489 2AFB ~            __x80_fcmp:
 2490 2AFB ~                IFNDEF X80_OPT_SIZE
 2491 2AFB ~                PUSH HL                 ; a's low word
 2492 2AFB ~                LD   HL,5
 2493 2AFB ~                ADD  HL,SP              ; b's top byte
 2494 2AFB ~                LD   A,(HL)
 2495 2AFB ~                ADD  A,A
 2496 2AFB ~                CP   0FEH
 2497 2AFB ~                JP   NC,.full_pop
 2498 2AFB ~                LD   A,D
 2499 2AFB ~                ADD  A,A
 2500 2AFB ~                CP   0FEH
 2501 2AFB ~                JP   NC,.full_pop
 2502 2AFB ~                LD   A,D
 2503 2AFB ~                XOR  (HL)
 2504 2AFB ~                JP   M,.fast_signs
 2505 2AFB ~                LD   A,D                ; one sign: their bits compared
 2506 2AFB ~                CP   (HL)
 2507 2AFB ~                JP   NZ,.fast_high
 2508 2AFB ~                DEC  HL
 2509 2AFB ~                LD   A,E
 2510 2AFB ~                CP   (HL)
 2511 2AFB ~                JP   NZ,.fast_high
 2512 2AFB ~                POP  HL
 2513 2AFB ~                LD   A,H
 2514 2AFB ~                CP   B
 2515 2AFB ~                JP   NZ,.fast_differ
 2516 2AFB ~                LD   A,L
 2517 2AFB ~                CP   C
 2518 2AFB ~                JP   NZ,.fast_differ
 2519 2AFB ~                XOR  A
 2520 2AFB ~                RET
 2521 2AFB ~            .fast_high:
 2522 2AFB ~                POP  HL
 2523 2AFB ~            .fast_differ:               ; the carry: a's bits below b's, so a < b if they are positive
 2524 2AFB ~                SBC  A,A
 2525 2AFB ~                XOR  D
 2526 2AFB ~                ADD  A,A
 2527 2AFB ~                LD   A,1
 2528 2AFB ~                RET  C
 2529 2AFB ~                INC  A
 2530 2AFB ~                RET
 2531 2AFB ~            .fast_signs:                ; two signs: equal if both are zeros, else the negative one less
 2532 2AFB ~                LD   A,(HL)
 2533 2AFB ~                ADD  A,A
 2534 2AFB ~                DEC  HL
 2535 2AFB ~                OR   (HL)
 2536 2AFB ~                OR   B
 2537 2AFB ~                OR   C
 2538 2AFB ~                LD   B,A
 2539 2AFB ~                LD   A,D
 2540 2AFB ~                ADD  A,A
 2541 2AFB ~                OR   B
 2542 2AFB ~                OR   E
 2543 2AFB ~                POP  HL
 2544 2AFB ~                OR   H
 2545 2AFB ~                OR   L
 2546 2AFB ~                RET  Z
 2547 2AFB ~                LD   A,D
 2548 2AFB ~                ADD  A,A
 2549 2AFB ~                LD   A,1
 2550 2AFB ~                RET  C
 2551 2AFB ~                INC  A
 2552 2AFB ~                RET
 2553 2AFB ~            .full_pop:
 2554 2AFB ~                POP  HL
 2555 2AFB ~                ENDIF
 2556 2AFB ~                CALL __x80_fp_load2
 2557 2AFB ~                LD   HL,__x80_fpa
 2558 2AFB ~                CALL __x80_fp_isnan
 2559 2AFB ~                JP   C,.unordered
 2560 2AFB ~                LD   HL,__x80_fpb
 2561 2AFB ~                CALL __x80_fp_isnan
 2562 2AFB ~                JP   C,.unordered
 2563 2AFB ~                LD   HL,__x80_fpa
 2564 2AFB ~                CALL __x80_fp_class
 2565 2AFB ~                JP   C,.bits
 2566 2AFB ~                JP   NZ,.bits
 2567 2AFB ~                LD   HL,__x80_fpb
 2568 2AFB ~                CALL __x80_fp_class
 2569 2AFB ~                JP   C,.bits
 2570 2AFB ~                RET  Z                  ; two zeros: A = 0
 2571 2AFB ~            .bits:
 2572 2AFB ~                LD   HL,__x80_fpb+3
 2573 2AFB ~                LD   DE,__x80_fpa+3
 2574 2AFB ~                LD   B,4
 2575 2AFB ~            .byte:
 2576 2AFB ~                LD   A,(DE)
 2577 2AFB ~                CP   (HL)
 2578 2AFB ~                JP   NZ,.differ
 2579 2AFB ~                DEC  HL
 2580 2AFB ~                DEC  DE
 2581 2AFB ~                DEC  B
 2582 2AFB ~                JP   NZ,.byte
 2583 2AFB ~                XOR  A
 2584 2AFB ~                RET
 2585 2AFB ~            .differ:                    ; the carry: a's bits below b's
 2586 2AFB ~                LD   A,0
 2587 2AFB ~                RLA
 2588 2AFB ~                LD   C,A
 2589 2AFB ~                LD   A,(__x80_fpa+3)
 2590 2AFB ~                LD   B,A
 2591 2AFB ~                LD   HL,__x80_fpb+3
 2592 2AFB ~                XOR  (HL)
 2593 2AFB ~                LD   A,B
 2594 2AFB ~                JP   M,.signs
 2595 2AFB ~                RLCA                    ; a's sign, and so b's, in bit 0
 2596 2AFB ~                XOR  C
 2597 2AFB ~                RRA
 2598 2AFB ~                LD   A,2
 2599 2AFB ~                RET  NC                 ; the bits ordered as the numbers: greater
 2600 2AFB ~                DEC  A
 2601 2AFB ~                RET
 2602 2AFB ~            .signs:
 2603 2AFB ~                RLCA
 2604 2AFB ~                LD   A,1
 2605 2AFB ~                RET  C                  ; a the negative one
 2606 2AFB ~                INC  A
 2607 2AFB ~                RET
 2608 2AFB ~            .unordered:
 2609 2AFB ~                LD   A,3
 2610 2AFB ~                RET
 2611 2AFB                  ENDIF
