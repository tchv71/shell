 1468 2AFB ~                CALL __x80_fp_load2
 1469 2AFB ~                ELSE
 1470 2AFB ~                ; Two normal numbers, the common case, without the general way's stores and swap: the low words
 1471 2AFB ~                ; to fpa and fpb, the high words kept in DE and HL, where the exponents and the signs are read;
 1472 2AFB ~                ; the larger's significand left in fpa -- b's put there when b is the larger -- and the
 1473 2AFB ~                ; smaller's in DEHL for the shift. Anything else goes the general way below, everything stored
 1474 2AFB ~                ; as __x80_fp_load2 would have. Some 750 T-states where that took 1290 (ivagor, zx-pk.ru).
 1475 2AFB ~                LD   (__x80_fpa),HL
 1476 2AFB ~                LD   H,B
 1477 2AFB ~                LD   L,C
 1478 2AFB ~                LD   (__x80_fpb),HL
