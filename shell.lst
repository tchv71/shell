 2692 2766 ~            ; A = the exponent of the float whose top byte is at HL; carry set if it is 0 or 255 -- a zero or a
 2693 2766 ~            ; subnormal, an infinity or a NaN -- and clear for a normal number. HL is left as it was.
 2694 2766 ~            __x80_fp_expn:
 2695 2766 ~                DEC  HL
 2696 2766 ~                LD   A,(HL)
 2697 2766 ~                RLA                     ; the exponent's last bit
 2698 2766 ~                INC  HL
