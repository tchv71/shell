 1480 2AFB ~                ADD  HL,SP
 1481 2AFB ~                LD   A,(HL)
 1482 2AFB ~                INC  HL
 1483 2AFB ~                LD   H,(HL)
 1484 2AFB ~                LD   L,A                ; b's high word
 1485 2AFB ~                LD   A,E
 1486 2AFB ~                ADD  A,A
 1487 2AFB ~                LD   A,D
 1488 2AFB ~                ADC  A,A
 1489 2AFB ~                LD   C,A                ; a's exponent field
 1490 2AFB ~                INC  A
 1491 2AFB ~                CP   2
 1492 2AFB ~                JP   C,.slow            ; 0 or 255
 1493 2AFB ~                LD   A,L
 1494 2AFB ~                ADD  A,A
