 5288 28C8 ~            ; ---------------------------------------------------------------------------
 5289 28C8 ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 28C8 ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 28C8 ~            ; the sign put back afterwards.
 5292 28C8 ~            ; ---------------------------------------------------------------------------
 5293 28C8 ~            __x80_sdiv16:
 5294 28C8 ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 28C8 ~                XOR  D
 5296 28C8 ~                AND  80H
 5297 28C8 ~                PUSH AF
 5298 28C8 ~                CALL __x80_abs_hl
 5299 28C8 ~                CALL __x80_abs_de
 5300 28C8 ~                CALL __x80_udiv16
 5301 28C8 ~                POP  AF
 5302 28C8 ~                OR   A
 5303 28C8 ~                RET  Z
 5304 28C8 ~                JP   __x80_neg_hl
 5305 28C8                  ENDIF
