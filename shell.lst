 2284 2AFB ~                EX   (SP),HL
 2285 2AFB ~                IFDEF X80_OPT_SPEED
 2286 2AFB ~                ; -O3: two steps a trip, the second written out after each outcome of the first, so that both
 2287 2AFB ~                ; bits are known where the trip ends and fpx takes them at once -- ADD A,A for each, INC A for
 2288 2AFB ~                ; an inverted 1 -- rather than a load, RLA and store for each bit. The sentinel, at an even
 2289 2AFB ~                ; place, comes out on the second ADD. About a sixth less for the loop; twice its bytes.
 2290 2AFB ~            .loop:
 2291 2AFB ~                ADD  HL,HL
 2292 2AFB ~                LD   A,E
 2293 2AFB ~                ADC  A,A
 2294 2AFB ~            .step:
 2295 2AFB ~                JP   C,.s1              ; twenty-five bits: above the divisor
 2296 2AFB ~                CP   D
 2297 2AFB ~                JP   C,.z1
 2298 2AFB ~                JP   NZ,.s1
 2299 2AFB ~                PUSH HL                 ; the top bytes alike: whether d_lo comes off the low word
 2300 2AFB ~                ADD  HL,BC
 2301 2AFB ~                POP  HL
 2302 2AFB ~                JP   NC,.z1
 2303 2AFB ~            .s1:
 2304 2AFB ~                ADD  HL,BC              ; a 1
 2305 2AFB ~                CCF
 2306 2AFB ~                SBC  A,D
 2307 2AFB ~                ADD  HL,HL              ; the second step, after a 1
 2308 2AFB ~                ADC  A,A
 2309 2AFB ~                JP   C,.s1s
 2310 2AFB ~                CP   D
 2311 2AFB ~                JP   C,.s1z
 2312 2AFB ~                JP   NZ,.s1s
 2313 2AFB ~                PUSH HL
 2314 2AFB ~                ADD  HL,BC
 2315 2AFB ~                POP  HL
 2316 2AFB ~                JP   NC,.s1z
 2317 2AFB ~            .s1s:
 2318 2AFB ~                ADD  HL,BC              ; 1 and 1: inverted, 0 and 0
 2319 2AFB ~                CCF
 2320 2AFB ~                SBC  A,D
 2321 2AFB ~                LD   E,A
 2322 2AFB ~                LD   A,(__x80_fpx)
 2323 2AFB ~                ADD  A,A
 2324 2AFB ~                ADD  A,A
 2325 2AFB ~                LD   (__x80_fpx),A
 2326 2AFB ~                JP   NC,.loop
 2327 2AFB ~                JP   .byte
 2328 2AFB ~            .s1z:
 2329 2AFB ~                LD   E,A                ; 1 and 0
 2330 2AFB ~                LD   A,(__x80_fpx)
 2331 2AFB ~                ADD  A,A
 2332 2AFB ~                ADD  A,A
 2333 2AFB ~                INC  A
 2334 2AFB ~                LD   (__x80_fpx),A
 2335 2AFB ~                JP   NC,.loop
 2336 2AFB ~                JP   .byte
 2337 2AFB ~            .z1:
 2338 2AFB ~                ADD  HL,HL              ; the second step, after a 0
 2339 2AFB ~                ADC  A,A
 2340 2AFB ~                JP   C,.z1s
 2341 2AFB ~                CP   D
 2342 2AFB ~                JP   C,.z1z
 2343 2AFB ~                JP   NZ,.z1s
 2344 2AFB ~                PUSH HL
 2345 2AFB ~                ADD  HL,BC
 2346 2AFB ~                POP  HL
 2347 2AFB ~                JP   NC,.z1z
 2348 2AFB ~            .z1s:
 2349 2AFB ~                ADD  HL,BC              ; 0 and 1
 2350 2AFB ~                CCF
 2351 2AFB ~                SBC  A,D
 2352 2AFB ~                LD   E,A
 2353 2AFB ~                LD   A,(__x80_fpx)
 2354 2AFB ~                ADD  A,A
 2355 2AFB ~                INC  A
 2356 2AFB ~                ADD  A,A
 2357 2AFB ~                LD   (__x80_fpx),A
 2358 2AFB ~                JP   NC,.loop
 2359 2AFB ~                JP   .byte
 2360 2AFB ~            .z1z:
 2361 2AFB ~                LD   E,A                ; 0 and 0
 2362 2AFB ~                LD   A,(__x80_fpx)
 2363 2AFB ~                ADD  A,A
 2364 2AFB ~                INC  A
 2365 2AFB ~                ADD  A,A
 2366 2AFB ~                INC  A
 2367 2AFB ~                LD   (__x80_fpx),A
 2368 2AFB ~                JP   NC,.loop
 2369 2AFB ~            .byte:
 2370 2AFB ~                PUSH AF                 ; a byte
 2371 2AFB ~                LD   A,1
 2372 2AFB ~                LD   (__x80_fpx),A
 2373 2AFB ~                LD   A,(__x80_fpe)
 2374 2AFB ~                DEC  A
 2375 2AFB ~                LD   (__x80_fpe),A
 2376 2AFB ~                JP   NZ,.loop
 2377 2AFB ~                ELSE
 2378 2AFB ~            .loop:
 2379 2AFB ~                ADD  HL,HL
 2380 2AFB ~                LD   A,E
 2381 2AFB ~                ADC  A,A
 2382 2AFB ~            .step:
 2383 2AFB ~                JP   C,.sub             ; twenty-five bits: above the divisor
 2384 2AFB ~                CP   D
 2385 2AFB ~                JP   C,.bit             ; below the divisor: a 0, the carry set
 2386 2AFB ~                JP   Z,.equal
 2387 2AFB ~            .sub:
 2388 2AFB ~                ADD  HL,BC              ; d_lo off, the carry no borrow
 2389 2AFB ~                CCF
 2390 2AFB ~                SBC  A,D
 2391 2AFB ~                OR   A                  ; a 1, the carry clear
 2392 2AFB ~            .bit:
 2393 2AFB ~                LD   E,A
 2394 2AFB ~                LD   A,(__x80_fpx)
 2395 2AFB ~                RLA
 2396 2AFB ~                LD   (__x80_fpx),A
 2397 2AFB ~                JP   NC,.loop
 2398 2AFB ~                PUSH AF                 ; a byte
 2399 2AFB ~                LD   A,1
 2400 2AFB ~                LD   (__x80_fpx),A
 2401 2AFB ~                LD   A,(__x80_fpe)
 2402 2AFB ~                DEC  A
 2403 2AFB ~                LD   (__x80_fpe),A
 2404 2AFB ~                JP   NZ,.loop
 2405 2AFB ~                ENDIF
 2406 2AFB ~                ADD  HL,HL              ; the round bit: the remainder doubled, against the divisor
 2407 2AFB ~                LD   A,E
 2408 2AFB ~                ADC  A,A
 2409 2AFB ~                JP   C,.half            ; twenty-five bits: above it
 2410 2AFB ~                CP   D
 2411 2AFB ~                JP   C,.halved
 2412 2AFB ~                JP   NZ,.half
 2413 2AFB ~                PUSH HL
 2414 2AFB ~                ADD  HL,BC
 2415 2AFB ~                POP  HL
 2416 2AFB ~                JP   NC,.halved
 2417 2AFB ~            .half:
 2418 2AFB ~                ADD  HL,BC
 2419 2AFB ~                CCF
 2420 2AFB ~                SBC  A,D
 2421 2AFB ~                LD   C,80H
 2422 2AFB ~                JP   .sticky
 2423 2AFB ~                IFNDEF X80_OPT_SPEED
 2424 2AFB ~            .equal:                     ; the top bytes alike: whether d_lo comes off the low word
 2425 2AFB ~                PUSH HL
 2426 2AFB ~                ADD  HL,BC
 2427 2AFB ~                POP  HL
 2428 2AFB ~                JP   C,.sub
 2429 2AFB ~                SCF
 2430 2AFB ~                JP   .bit
 2431 2AFB ~                ENDIF
 2432 2AFB ~            .halved:
 2433 2AFB ~                LD   C,0                ; below: the round bit 0
 2434 2AFB ~            .sticky:
 2435 2AFB ~                OR   H                  ; what remains: not zero, the sticky bit
 2436 2AFB ~                OR   L
 2437 2AFB ~                JP   Z,.exact
 2438 2AFB ~                INC  C
 2439 2AFB ~            .exact:
 2440 2AFB ~                LD   L,C
 2441 2AFB ~                POP  AF
 2442 2AFB ~                CPL
 2443 2AFB ~                LD   H,A
 2444 2AFB ~                POP  AF
 2445 2AFB ~                CPL
 2446 2AFB ~                LD   E,A
 2447 2AFB ~                POP  AF
 2448 2AFB ~                CPL
 2449 2AFB ~                LD   D,A
 2450 2AFB ~                POP  BC
 2451 2AFB ~                IFNDEF X80_OPT_SIZE
 2452 2AFB ~                ; an exponent field of 1 to 254, the quotient's leading one at bit 31: straight to the
 2453 2AFB ~                ; rounding, without the normalising and the range's tests
