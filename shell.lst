 2661 2AFB                  IFUSED __x80_ltof
 2662 2AFB ~            ; ---------------------------------------------------------------------------
 2663 2AFB ~            ; DE:HL = a long, or an unsigned long, converted to float: its magnitude normalised and rounded.
 2664 2AFB ~            ; ---------------------------------------------------------------------------
 2665 2AFB ~            __x80_ltof:
 2666 2AFB ~                LD   A,D
 2667 2AFB ~                AND  80H
 2668 2AFB ~                LD   (__x80_fps),A
 2669 2AFB ~                CALL NZ,__x80_fp_neg
 2670 2AFB ~                JP   __x80_fp_utof
 2671 2AFB                  ENDIF
 2672 2AFB
 2673 2AFB                  IFUSED __x80_ultof
