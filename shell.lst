 5936 2896 ~                OR   E
 5937 2896 ~                RET  Z
 5938 2896 ~                LD   A,L
 5939 2896 ~            .loop:
 5940 2896 ~                OR   A
 5941 2896 ~                RRA
 5942 2896 ~                DEC  E
 5943 2896 ~                JP   NZ,.loop
 5944 2896 ~                LD   L,A
 5945 2896 ~                RET
 5946 2896                  ENDIF
