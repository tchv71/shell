 4219 2AFB              ; ---------------------------------------------------------------------------
 4220 2AFB              ; Division and remainder, unsigned and signed.
 4221 2AFB              ;
 4222 2AFB              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 2AFB              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 2AFB              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 2AFB              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 2AFB              ; ---------------------------------------------------------------------------
 4227 2AFB              __x80_ludiv:
 4228 2AFB CD 04 2B         CALL __x80_div_args
 4229 2AFE CD 2C 2B         CALL __x80_divide
 4230 2B01 C3 1C 2B         JP   __x80_quotient
 4231 2B04                  ENDIF
