 3570 2AFB ~            __x80_qsdiv:
 3571 2AFB ~                CALL __x80_q_take2
 3572 2AFB ~                LD   A,(__x80_qa+7)     ; the quotient is negative when the signs differ
 3573 2AFB ~                LD   C,A
 3574 2AFB ~                LD   A,(__x80_qb+7)
 3575 2AFB ~                XOR  C
 3576 2AFB ~                CALL __x80_q_signed
 3577 2AFB ~                LD   HL,__x80_qa
 3578 2AFB ~                CALL Z,__x80_q_negate
 3579 2AFB ~                LD   HL,__x80_qa
 3580 2AFB ~                JP   __x80_q_give
 3581 2AFB                  ENDIF
 3582 2AFB
 3583 2AFB                  IFUSED __x80_qsrem
 3584 2AFB ~            __x80_qsrem:
 3585 2AFB ~                CALL __x80_q_take2
 3586 2AFB ~                LD   A,(__x80_qa+7)     ; the remainder takes the sign of the dividend
 3587 2AFB ~                CALL __x80_q_signed
 3588 2AFB ~                LD   HL,__x80_qr
 3589 2AFB ~                CALL Z,__x80_q_negate
 3590 2AFB ~                LD   HL,__x80_qr
 3591 2AFB ~                JP   __x80_q_give
 3592 2AFB                  ENDIF
