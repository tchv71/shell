 3619 2AFB ~            .bits:
 3620 2AFB ~                OR   A
 3621 2AFB ~                JP   Z,__x80_q_give_a
 3622 2AFB ~            .loop:
 3623 2AFB ~                PUSH AF
 3624 2AFB ~                LD   HL,__x80_qa
 3625 2AFB ~                CALL __x80_q_shl
 3626 2AFB ~                POP  AF
 3627 2AFB ~                DEC  A
 3628 2AFB ~                JP   NZ,.loop
 3629 2AFB ~                JP   __x80_q_give_a
