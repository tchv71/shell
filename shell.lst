 6775 292C              ; ---------------------------------------------------------------------------
 6776 292C              ; HL = destination, DE = source: __x80_mcpy_N copies N bytes, N from 1 to 32:
 6777 292C              ; a block whose size the compiler knows, a struct assigned, in a CALL of three
 6778 292C              ; bytes where LD BC,N and a CALL of __x80_memcpy were six (ivagor, zx-pk.ru).
 6779 292C              ; Writes A, C, DE and HL; leaves B alone.
 6780 292C              ;
 6781 292C              ; Two ways of doing it, and the shorter for the sizes the program uses is the
 6782 292C              ; one assembled -- the program's own calls are the same either way:
 6783 292C              ;
 6784 292C              ; (a) One tail of steps unrolled, entered at the step for the count: 24
 6785 292C              ;     T-states a byte, 4 * M - 1 bytes for the largest size M up to 16;
 6786 292C              ;     the sizes above that by (b).
 6787 292C              ; (b) One loop counting in C, 39 T-states a byte against 47 in __x80_memcpy's,
 6788 292C              ;     and an entry for each size: `LD C,N` and a byte 3AH -- LD A,(nn), which
 6789 292C              ;     takes the next entry's LD C,N for its address and so passes over it --
 6790 292C              ;     the smallest size's entry falling into the loop. 8 + 3 * sizes bytes.
 6791 292C              ;
 6792 292C              ; -O3 takes (a) whatever it costs. The sizes used are counted first, every
 6793 292C              ; entry under IFUSED; then the arithmetic; then the code, laid out so that
 6794 292C              ; every way through it ends in a RET: what the compiler reads of this file
 6795 292C              ; to know the registers a routine writes follows the code to its RET.
 6796 292C              ; ---------------------------------------------------------------------------
 6797 292C              __x80_mcpy_d = 0                    ; the sizes used
 6798 292C              __x80_mcpy_db = 0                   ; of them above 16
 6799 292C              __x80_mcpy_m = 0                    ; the largest up to 16
 6800 292C              __x80_mcpy_lo = 0                   ; the smallest
 6801 292C              __x80_mcpy_lb = 0                   ; the smallest above 16
