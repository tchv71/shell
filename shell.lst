 4148 2AFB ~                RLA                     ; B's bit into the carry, to come in at the top
 4149 2AFB ~                LD   A,D
 4150 2AFB ~                RRA
 4151 2AFB ~                LD   D,A
 4152 2AFB ~                CALL __x80_rr3
