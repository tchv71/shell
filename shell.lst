 2276 2AFB ~                JP   NZ,.negated
 2277 2AFB ~                DEC  D                  ; d_lo = 0: d as D - 1 and a low word of 65536
 2278 2AFB ~            .negated:
 2279 2AFB ~                POP  AF
 2280 2AFB ~                LD   A,E
 2281 2AFB ~                JP   NC,.step           ; the carry clear
 2282 2AFB ~                EX   (SP),HL
