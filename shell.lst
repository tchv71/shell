 3684 2AFB ~                CALL __x80_q_rr
 3685 2AFB ~                POP  AF
 3686 2AFB ~                DEC  A
 3687 2AFB ~                JP   NZ,.loop
 3688 2AFB ~                JP   __x80_q_give_a
