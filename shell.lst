 1532 2AFB ~                LD   (__x80_fpa+2),A
 1533 2AFB ~                LD   A,L
 1534 2AFB ~                OR   80H
 1535 2AFB ~                LD   D,A
 1536 2AFB ~                LD   HL,(__x80_fpb)
