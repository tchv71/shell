 6012 2904                  IFUSED __x80_lshr16
 6013 2904 ~
 6014 2904 ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2904 ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2904 ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2904 ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2904 ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2904 ~            ; the time goes.
 6020 2904 ~            __x80_lshr16:
 6021 2904 ~                XOR  A
 6022 2904 ~                OR   E
 6023 2904 ~                RET  Z
 6024 2904 ~                CP   8
 6025 2904 ~                JP   NC,.bytes
 6026 2904 ~                LD   B,A
 6027 2904 ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2904 ~                DEC  H
 6029 2904 ~                JP   Z,.low
 6030 2904 ~                CP   4
 6031 2904 ~                JP   NC,.left
 6032 2904 ~            .loop:
 6033 2904 ~                XOR  A
 6034 2904 ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2904 ~                RRA
 6036 2904 ~                LD   H,A
 6037 2904 ~                LD   A,L
 6038 2904 ~                RRA
 6039 2904 ~                LD   L,A
 6040 2904 ~                DEC  B
 6041 2904 ~                JP   NZ,.loop
 6042 2904 ~                RET
 6043 2904 ~            .left:
 6044 2904 ~                LD   A,8
 6045 2904 ~                SUB  B
 6046 2904 ~                LD   B,A
 6047 2904 ~                XOR  A
 6048 2904 ~            .left_loop:
 6049 2904 ~                ADD  HL,HL
 6050 2904 ~                RLA
 6051 2904 ~                DEC  B
 6052 2904 ~                JP   NZ,.left_loop
 6053 2904 ~                LD   L,H
 6054 2904 ~                LD   H,A
 6055 2904 ~                RET
 6056 2904 ~            .bytes:
 6057 2904 ~                LD   L,H
 6058 2904 ~                LD   H,0
 6059 2904 ~                SUB  8
 6060 2904 ~                RET  Z
 6061 2904 ~                CP   8
 6062 2904 ~                JP   NC,.zero
 6063 2904 ~                LD   B,A
 6064 2904 ~            .low:
 6065 2904 ~                LD   A,L
 6066 2904 ~            .byte:
 6067 2904 ~                OR   A
 6068 2904 ~                RRA
 6069 2904 ~                DEC  B
 6070 2904 ~                JP   NZ,.byte
 6071 2904 ~                LD   L,A
 6072 2904 ~                RET
 6073 2904 ~            .zero:
 6074 2904 ~                LD   L,H
 6075 2904 ~                RET
 6076 2904                  ENDIF
