 4329 2805              __x80_divide:
 4330 2805                  IFDEF X80_OPT_SIZE
 4331 2805                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2805                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2805                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2805                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2805                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2805 2A 30 29         LD   HL,(__x80_rt_b)
 4337 2808 7C               LD   A,H
 4338 2809 B5               OR   L
 4339 280A 2A 32 29         LD   HL,(__x80_rt_b+2)
 4340 280D B4               OR   H
 4341 280E B5               OR   L
 4342 280F CA B2 28         JP   Z,.s_zero
