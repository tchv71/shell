 1145 2766 ~                LD   A,C
 1146 2766 ~                AND  0FH
 1147 2766 ~                OR   10H                ; the leading one
 1148 2766 ~                JP   .top
 1149 2766 ~            .sub:
 1150 2766 ~                INC  E                  ; a subnormal: exponent 1, no leading one
 1151 2766 ~                LD   A,C
 1152 2766 ~                AND  0FH
 1153 2766 ~            .top:
 1154 2766 ~                LD   (HL),A             ; the fraction's top four bits, a byte up
 1155 2766 ~                LD   B,6
 1156 2766 ~            .up:
 1157 2766 ~                DEC  HL
 1158 2766 ~                DEC  HL
 1159 2766 ~                LD   A,(HL)
 1160 2766 ~                INC  HL
 1161 2766 ~                LD   (HL),A
 1162 2766 ~                DEC  B
 1163 2766 ~                JP   NZ,.up
 1164 2766 ~                DEC  HL
 1165 2766 ~                LD   (HL),0
 1166 2766 ~                LD   C,3                ; and three places further
 1167 2766 ~            .shl:
