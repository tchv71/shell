 4245 2B04 ~                LD   A,(__x80_rt_a+3)   ; the quotient is negative when the signs differ
 4246 2B04 ~                LD   C,A
 4247 2B04 ~                LD   A,(__x80_rt_b+3)
 4248 2B04 ~                XOR  C
 4249 2B04 ~                CALL __x80_signed_divide
 4250 2B04 ~                CALL Z,__x80_negate_a
 4251 2B04 ~                JP   __x80_quotient
