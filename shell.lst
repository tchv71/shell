 4294 2B1C ~                LD   HL,__x80_rt_b
 4295 2B1C ~                CALL __x80_abs32
 4296 2B1C ~                CALL __x80_divide
 4297 2B1C ~                LD   A,(__x80_rt_sign)
 4298 2B1C ~                CP   80H
