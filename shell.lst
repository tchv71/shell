 4122 2AFB ~            ; ---------------------------------------------------------------------------
 4123 2AFB ~            ; DE:HL shifted right by C, 1 to 31, with B -- 00h or the sign's FFh -- coming in at the top: both
 4124 2AFB ~            ; right shifts of a long. Eight places at a time by moving the bytes, B the new top one, worked out
 4125 2AFB ~            ; once rather than at each byte. What is left, 1 to 7 places: 1 to 3 a bit a step, the top bit
 4126 2AFB ~            ; from B's; 4 to 7 as 8 - n steps to the left with B as a fifth byte above D, and the bytes moved
 4127 2AFB ~            ; down by one -- 67 T-states a step against 107 to the right (ivagor's way for a word,
 4128 2AFB ~            ; zx-pk.ru #77, and his two ways in for the sign, #92: here one way in, the sign held in B).
 4129 2AFB ~            ; ---------------------------------------------------------------------------
 4130 2AFB ~            __x80_shr32:
 4131 2AFB ~            .bytes:
 4132 2AFB ~                LD   A,C
 4133 2AFB ~                SUB  8
 4134 2AFB ~                JP   C,.bits
 4135 2AFB ~                LD   C,A
 4136 2AFB ~            .move:
 4137 2AFB ~                LD   L,H
 4138 2AFB ~                LD   H,E
 4139 2AFB ~                LD   E,D
 4140 2AFB ~                LD   D,B
 4141 2AFB ~                JP   NZ,.bytes          ; the flags of the SUB, or of .left's last DEC C
 4142 2AFB ~                RET
 4143 2AFB ~            .bits:
 4144 2AFB ~                CP   0FCh               ; A is the count less 8: 4 to 7 places are FCh to FFh
 4145 2AFB ~                JP   NC,.left
 4146 2AFB ~            .right:
