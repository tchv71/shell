 6146 2C5B ~            ; ---------------------------------------------------------------------------
 6147 2C5B ~            ; HL = destination, DE = source, BC = count. The same direction and the same
 6148 2C5B ~            ; register convention as the reference generator's inline expansion, so that the
 6149 2C5B ~            ; two back ends agree about what a struct assignment does.
 6150 2C5B ~            ;
 6151 2C5B ~            ; A count of zero copies nothing: the test is at the top, unlike the inline
 6152 2C5B ~            ; version, because here the count can come from anywhere.
 6153 2C5B ~            ; ---------------------------------------------------------------------------
 6154 2C5B ~            __x80_memcpy:
 6155 2C5B ~                LD   A,B
 6156 2C5B ~                OR   C
 6157 2C5B ~                RET  Z
 6158 2C5B ~            __x80_memcpy_loop:
 6159 2C5B ~                LD   A,(DE)
 6160 2C5B ~                LD   (HL),A
 6161 2C5B ~                INC  DE
 6162 2C5B ~                INC  HL
 6163 2C5B ~                DEC  BC
 6164 2C5B ~                LD   A,B
 6165 2C5B ~                OR   C
 6166 2C5B ~                JP   NZ,__x80_memcpy_loop
 6167 2C5B ~                RET
 6168 2C5B                  ENDIF
