 8383 292C              ; Working space, for division. Like every object that starts as zeros, not in the image: an
 8384 292C              ; address below __x80_bss_top that the startup code clears.
 8385 292C              ; ---------------------------------------------------------------------------
 8386 292C              __x80_bss_off = __x80_bss_off + 4
