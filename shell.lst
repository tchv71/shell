 4267 276F              ; rt_a = DE:HL, rt_b = [SP+4]:BC -- the stack argument is two return addresses up.
 4268 276F              __x80_div_args:
 4269 276F 22 C6 28         LD   (__x80_rt_a),HL
 4270 2772 EB               EX   DE,HL
 4271 2773 22 C8 28         LD   (__x80_rt_a+2),HL
 4272 2776 60               LD   H,B
 4273 2777 69               LD   L,C
 4274 2778 22 C2 28         LD   (__x80_rt_b),HL
 4275 277B 21 04 00         LD   HL,4
 4276 277E 39               ADD  HL,SP
 4277 277F 7E               LD   A,(HL)
 4278 2780 23               INC  HL
 4279 2781 66               LD   H,(HL)
 4280 2782 6F               LD   L,A
 4281 2783 22 C4 28         LD   (__x80_rt_b+2),HL
 4282 2786 C9               RET
 4283 2787                  ENDIF
