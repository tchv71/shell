 5755 2904 ~            ; HL = HL * DE, sixteen bits, wrapping.
 5756 2904 ~            ;
 5757 2904 ~            ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2904 ~            ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2904 ~            ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2904 ~            ; and ten more for a set one.
 5761 2904 ~            ;
 5762 2904 ~            ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2904 ~            ; an index times the size of an element, a value times a small factor. When it is the
 5764 2904 ~            ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2904 ~            ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2904 ~            ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2904 ~            ;
 5768 2904 ~            ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2904 ~            ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2904 ~            ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2904 ~            ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2904 ~            ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2904 ~            ; keep the eight steps from zero.
 5774 2904 ~            ;
 5775 2904 ~            ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2904 ~            ; additions.
 5777 2904 ~            ; ---------------------------------------------------------------------------
 5778 2904 ~            __x80_mul16:
 5779 2904 ~                XOR  A
 5780 2904 ~                OR   D
 5781 2904 ~                JP   Z,.small       ; the multiplier fits in a byte
 5782 2904 ~                XOR  A
 5783 2904 ~                OR   H
 5784 2904 ~                JP   NZ,.full
 5785 2904 ~                EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2904 ~            .small:
 5787 2904 ~                LD   B,H
 5788 2904 ~                LD   C,L            ; BC = multiplicand
 5789 2904 ~                IFNDEF X80_OPT_SPEED
 5790 2904 ~                LD   HL,0
 5791 2904 ~                LD   A,E
 5792 2904 ~                JP   __x80_mul16_byte
 5793 2904 ~            .full:
 5794 2904 ~                LD   B,H
 5795 2904 ~                LD   C,L
 5796 2904 ~                LD   HL,0
 5797 2904 ~                LD   A,D
 5798 2904 ~                CALL __x80_mul16_byte
 5799 2904 ~                LD   A,E
 5800 2904 ~                ELSE
 5801 2904 ~                LD   A,E
 5802 2904 ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2904 ~            .full:
 5804 2904 ~                LD   B,H
 5805 2904 ~                LD   C,L
 5806 2904 ~                LD   A,D
 5807 2904 ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2904 ~                LD   A,E
 5809 2904 ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2904 ~                ENDIF
 5811 2904                  ENDIF
