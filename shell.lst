 3777 2AFB ~                LD   A,(HL)
 3778 2AFB ~                OR   1
 3779 2AFB ~                LD   (HL),A
 3780 2AFB ~                JP   .next
 3781 2AFB ~            .restore:
 3782 2AFB ~                LD   HL,__x80_qr
 3783 2AFB ~                LD   DE,__x80_qb
 3784 2AFB ~                CALL __x80_q_add
 3785 2AFB ~            .next:
 3786 2AFB ~                LD   A,(__x80_qn)
 3787 2AFB ~                DEC  A
 3788 2AFB ~                LD   (__x80_qn),A
 3789 2AFB ~                JP   NZ,.loop
 3790 2AFB ~                RET
 3791 2AFB                  ENDIF
