 3799 2AFB ~                CALL __x80_q_copy
 3800 2AFB ~                POP  HL
 3801 2AFB ~                LD   DE,__x80_qb
 3802 2AFB ~                JP   __x80_q_copy
 3803 2AFB                  ENDIF
 3804 2AFB
 3805 2AFB              ; The eight bytes at HL, or at qa, back to where the first operand was.
