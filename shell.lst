 1010 2AFB                  IFUSED __x80_d_nan2
 1011 2AFB ~            ; ---------------------------------------------------------------------------
 1012 2AFB ~            ; Returns if neither qa nor qb is a NaN. If either is, the operation's result is the first NaN of
 1013 2AFB ~            ; the two, quieted: this writes it and returns from the operation itself.
 1014 2AFB ~            ; ---------------------------------------------------------------------------
 1015 2AFB ~            __x80_d_nan2:
 1016 2AFB ~                LD   HL,__x80_qa
 1017 2AFB ~                CALL __x80_d_isnan
 1018 2AFB ~                LD   HL,__x80_qa
 1019 2AFB ~                JP   C,.quiet
 1020 2AFB ~                LD   HL,__x80_qb
 1021 2AFB ~                CALL __x80_d_isnan
 1022 2AFB ~                RET  NC
 1023 2AFB ~                LD   HL,__x80_qb
 1024 2AFB ~            .quiet:
 1025 2AFB ~                PUSH HL
 1026 2AFB ~                LD   DE,6
 1027 2AFB ~                ADD  HL,DE
 1028 2AFB ~                LD   A,(HL)
 1029 2AFB ~                OR   08H
 1030 2AFB ~                LD   (HL),A
 1031 2AFB ~                POP  HL
 1032 2AFB ~                POP  BC                 ; the return into the operation
 1033 2AFB ~                JP   __x80_q_give
 1034 2AFB                  ENDIF
 1035 2AFB
 1036 2AFB                  IFUSED __x80_d_isnan
 1037 2AFB ~            ; Carry set if the double at HL is a NaN: the exponent all ones and the fraction not zero.
 1038 2AFB ~            __x80_d_isnan:
 1039 2AFB ~                LD   DE,7
 1040 2AFB ~                ADD  HL,DE
 1041 2AFB ~                LD   A,(HL)
 1042 2AFB ~                ADD  A,A                ; the sign out
 1043 2AFB ~                ADD  A,2                ; the carry: the exponent's top seven bits all ones
 1044 2AFB ~                RET  NC
 1045 2AFB ~                DEC  HL
 1046 2AFB ~                LD   A,(HL)
 1047 2AFB ~                OR   0FH
 1048 2AFB ~                ADD  A,1                ; the carry: its other four as well
 1049 2AFB ~                RET  NC
 1050 2AFB ~                LD   A,(HL)
 1051 2AFB ~                AND  0FH
 1052 2AFB ~                LD   B,6
 1053 2AFB ~            .or:
 1054 2AFB ~                DEC  HL
 1055 2AFB ~                OR   (HL)
 1056 2AFB ~                DEC  B
 1057 2AFB ~                JP   NZ,.or
 1058 2AFB ~                OR   A
 1059 2AFB ~                RET  Z                  ; an infinity
 1060 2AFB ~                SCF
 1061 2AFB ~                RET
 1062 2AFB                  ENDIF
 1063 2AFB
 1064 2AFB                  IFUSED __x80_d_sign
 1065 2AFB ~            ; dsg = the sign of a product or a quotient.
 1066 2AFB ~            __x80_d_sign:
