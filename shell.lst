 6374 2896 ~                LD   (HL),E
 6375 2896 ~                INC  HL
 6376 2896 ~                LD   (HL),D
 6377 2896 ~                INC  HL
 6378 2896 ~                POP  DE
 6379 2896 ~                LD   (HL),E
 6380 2896 ~                INC  HL
