 2545 2766 ~                OR   L
 2546 2766 ~                RET  Z
 2547 2766 ~                LD   A,D
 2548 2766 ~                ADD  A,A
 2549 2766 ~                LD   A,1
 2550 2766 ~                RET  C
 2551 2766 ~                INC  A
 2552 2766 ~                RET
 2553 2766 ~            .full_pop:
 2554 2766 ~                POP  HL
 2555 2766 ~                ENDIF
