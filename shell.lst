 4164 27D4 ~                LD   E,A
 4165 27D4 ~                LD   A,D
 4166 27D4 ~                RLA
 4167 27D4 ~                LD   D,A
 4168 27D4 ~                LD   A,B
 4169 27D4 ~                RLA
 4170 27D4 ~                LD   B,A
